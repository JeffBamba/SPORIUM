/* Mission Recap Panel
 * Terminal/CRT aesthetic. Spec reference:
 *  - posizione: top 96px, left 24px
 *  - larghezza pannello ~360px (header titolo + conteggio + filtri senza overlap)
 *  - header titolo + conteggio tipografia in px (vedi .active-missions-title / .active-missions-count), verde ciano #00FFC6
 *  - card bordo 2px pixel-style, sfondo trasparente, hover glow ciano
 *  - tooltip 320px, #0B0D10 @ 95%, bordo 2px status color, scanline CRT, sezioni OBJECTIVE/TASK/REWARD/DEADLINE
 */

/* ================= ROOT ================= */
.active-missions-root {
    position: absolute;
    left: 24px;
    top: 136px;
    width: 360px;
    flex-direction: column;
    transition-property: opacity, translate;
    transition-duration: 400ms;
    transition-timing-function: ease-out;
}

.active-missions-root--enter {
    opacity: 0;
    translate: -20px 0;
}

/* ================= HEADER ================= */
.active-missions-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 40px;
    min-height: 40px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgba(4, 12, 10, 0.65);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(0, 255, 198, 0.4);
    border-right-color: rgba(0, 255, 198, 0.4);
    border-top-color: rgba(0, 255, 198, 0.4);
    border-bottom-color: rgba(0, 255, 198, 0.4);
    cursor: link;
}

.active-missions-header:hover {
    border-left-color: rgba(0, 255, 198, 0.7);
    border-right-color: rgba(0, 255, 198, 0.7);
    border-top-color: rgba(0, 255, 198, 0.7);
    border-bottom-color: rgba(0, 255, 198, 0.7);
}

.active-missions-header-left {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.active-missions-header-right {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.active-missions-filter-button {
    min-width: 40px;
    height: 20px;
    margin-right: 4px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 1px;
    padding-bottom: 1px;
    background-color: rgba(8, 14, 16, 0.65);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(0, 255, 198, 0.3);
    border-right-color: rgba(0, 255, 198, 0.3);
    border-top-color: rgba(0, 255, 198, 0.3);
    border-bottom-color: rgba(0, 255, 198, 0.3);
    color: rgba(0, 255, 198, 0.7);
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.active-missions-filter-button:hover {
    border-left-color: rgba(0, 255, 198, 0.6);
    border-right-color: rgba(0, 255, 198, 0.6);
    border-top-color: rgba(0, 255, 198, 0.6);
    border-bottom-color: rgba(0, 255, 198, 0.6);
}

.active-missions-filter-button--selected {
    background-color: rgba(0, 255, 198, 0.15);
    border-left-color: rgba(0, 255, 198, 0.85);
    border-right-color: rgba(0, 255, 198, 0.85);
    border-top-color: rgba(0, 255, 198, 0.85);
    border-bottom-color: rgba(0, 255, 198, 0.85);
    color: rgb(0, 255, 198);
}

.active-missions-filter-button--selected-done {
    background-color: rgba(127, 255, 122, 0.1);
    border-left-color: rgba(127, 255, 122, 0.68);
    border-right-color: rgba(127, 255, 122, 0.68);
    border-top-color: rgba(127, 255, 122, 0.68);
    border-bottom-color: rgba(127, 255, 122, 0.68);
    color: rgba(127, 255, 122, 0.78);
}

.active-missions-title {
    height: 20px;
    font-size: 13px;
    letter-spacing: 2.4px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(0, 255, 198);
    text-shadow: 0 0 6px rgba(0, 255, 198, 0.55);
}

.active-missions-count {
    height: 20px;
    margin-left: 8px;
    font-size: 13px;
    letter-spacing: 1.2px;
    -unity-text-align: middle-left;
    color: rgba(0, 255, 198, 0.85);
    text-shadow: 0 0 4px rgba(0, 255, 198, 0.35);
}

/* chevron down (border trick): due bordi a L ruotati 45° formano una freccia */
.active-missions-toggle-chevron {
    width: 9px;
    height: 9px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-right-color: rgba(0, 255, 198, 0.6);
    border-bottom-color: rgba(0, 255, 198, 0.6);
    rotate: 45deg;
    transition-property: rotate;
    transition-duration: 200ms;
    transition-timing-function: ease-in-out;
}

.active-missions-toggle-chevron--collapsed {
    rotate: -135deg;
}

/* ================= CONTENT (collapsible) ================= */
.active-missions-content {
    flex-direction: column;
    overflow: hidden;
    max-height: 600px;
    opacity: 1;
    padding-top: 8px;
    transition-property: max-height, opacity, padding-top;
    transition-duration: 300ms;
    transition-timing-function: ease-in-out;
}

.active-missions--collapsed .active-missions-content {
    max-height: 0;
    opacity: 0;
    padding-top: 0;
}

.active-missions-list {
    flex-direction: column;
}

.active-missions-empty {
    margin-top: 2px;
    padding-left: 10px;
    font-size: 13px;
    letter-spacing: 1.2px;
    color: rgba(93, 182, 227, 0.4);
    -unity-font-style: italic;
}

/* ================= MISSION CARD ================= */
.active-mission-card {
    width: 100%;
    flex-direction: column;
    margin-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 10px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    cursor: link;
    transition-property: background-color, border-color;
    transition-duration: 180ms;
    transition-timing-function: ease-out;
}

.active-mission-card:hover {
    background-color: rgba(0, 255, 198, 0.05);
}

.active-mission-card-top {
    flex-direction: row;
    align-items: center;
}

.active-mission-card-emoji {
    font-size: 15px;
    margin-right: 8px;
    -unity-font-style: bold;
    color: rgba(0, 255, 198, 0.95);
}

.active-mission-card--fade-out {
    opacity: 0.05;
    transition-property: opacity;
    transition-duration: 2500ms;
    transition-timing-function: ease-out;
}

.active-mission-card-title {
    flex-grow: 1;
    font-size: 13px;
    letter-spacing: 1.1px;
    -unity-font-style: bold;
}

.active-mission-card-timer-wrap {
    flex-direction: row;
    align-items: center;
}

.active-mission-card-timer-icon {
    margin-right: 3px;
    font-size: 13px;
    color: rgba(192, 200, 197, 0.7);
}

.active-mission-card-timer {
    font-size: 13px;
    color: rgba(192, 200, 197, 0.85);
}

.active-mission-card-timer--warn {
    color: rgb(230, 201, 111);
}

.active-mission-card-progress {
    position: relative;
    margin-top: 8px;
    min-height: 16px;
    height: 16px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    background-color: rgba(4, 6, 8, 0.5);
    overflow: hidden;
}

.active-mission-card-progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
}

.active-mission-card-progress-percent {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(240, 245, 243);
    -unity-text-align: middle-center;
    text-shadow: 0 0 3px rgba(0, 0, 0, 0.95);
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 0;
    margin-bottom: 0;
}

/* ================= STATUS VARIANTS ================= */
.am-status-active.active-mission-card {
    background-color: rgba(4, 22, 15, 0.82);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-left-color: rgba(0, 255, 198, 0.4);
    border-right-color: rgba(0, 255, 198, 0.4);
    border-top-color: rgba(0, 255, 198, 0.4);
    border-bottom-color: rgba(0, 255, 198, 0.4);
}

.am-status-active.active-mission-card:hover {
    background-color: rgba(6, 32, 22, 0.9);
    border-left-color: rgba(0, 255, 198, 0.85);
    border-right-color: rgba(0, 255, 198, 0.85);
    border-top-color: rgba(0, 255, 198, 0.85);
    border-bottom-color: rgba(0, 255, 198, 0.85);
}

.am-status-expiring.active-mission-card {
    border-left-color: rgba(230, 201, 111, 0.4);
    border-right-color: rgba(230, 201, 111, 0.4);
    border-top-color: rgba(230, 201, 111, 0.4);
    border-bottom-color: rgba(230, 201, 111, 0.4);
}

.am-status-expiring.active-mission-card:hover {
    border-left-color: rgba(230, 201, 111, 0.85);
    border-right-color: rgba(230, 201, 111, 0.85);
    border-top-color: rgba(230, 201, 111, 0.85);
    border-bottom-color: rgba(230, 201, 111, 0.85);
}

.am-status-failed.active-mission-card {
    border-left-color: rgba(211, 95, 95, 0.4);
    border-right-color: rgba(211, 95, 95, 0.4);
    border-top-color: rgba(211, 95, 95, 0.4);
    border-bottom-color: rgba(211, 95, 95, 0.4);
}

.am-status-failed.active-mission-card:hover {
    border-left-color: rgba(211, 95, 95, 0.85);
    border-right-color: rgba(211, 95, 95, 0.85);
    border-top-color: rgba(211, 95, 95, 0.85);
    border-bottom-color: rgba(211, 95, 95, 0.85);
}

.am-status-active .active-mission-card-title {
    color: rgb(0, 255, 198);
    text-shadow: 0 0 5px rgba(0, 255, 198, 0.5);
}

.am-status-expiring .active-mission-card-title {
    color: rgb(230, 201, 111);
    text-shadow: 0 0 5px rgba(230, 201, 111, 0.5);
}

.am-status-failed .active-mission-card-title {
    color: rgb(211, 95, 95);
    text-shadow: 0 0 5px rgba(211, 95, 95, 0.5);
}

.am-status-active .active-mission-card-progress {
    border-left-color: rgba(0, 255, 198, 0.3);
    border-right-color: rgba(0, 255, 198, 0.3);
    border-top-color: rgba(0, 255, 198, 0.3);
    border-bottom-color: rgba(0, 255, 198, 0.3);
}

.am-status-expiring .active-mission-card-progress {
    border-left-color: rgba(230, 201, 111, 0.3);
    border-right-color: rgba(230, 201, 111, 0.3);
    border-top-color: rgba(230, 201, 111, 0.3);
    border-bottom-color: rgba(230, 201, 111, 0.3);
}

.am-status-failed .active-mission-card-progress {
    border-left-color: rgba(211, 95, 95, 0.3);
    border-right-color: rgba(211, 95, 95, 0.3);
    border-top-color: rgba(211, 95, 95, 0.3);
    border-bottom-color: rgba(211, 95, 95, 0.3);
}

.am-status-active .active-mission-card-progress-fill {
    background-color: rgba(0, 255, 198, 0.8);
}

.am-status-completed.active-mission-card {
    background-color: rgba(6, 24, 12, 0.82);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-left-color: rgba(127, 255, 122, 0.33);
    border-right-color: rgba(127, 255, 122, 0.33);
    border-top-color: rgba(127, 255, 122, 0.33);
    border-bottom-color: rgba(127, 255, 122, 0.33);
}

.am-status-completed.active-mission-card:hover {
    background-color: rgba(10, 34, 17, 0.9);
    border-left-color: rgba(127, 255, 122, 0.62);
    border-right-color: rgba(127, 255, 122, 0.62);
    border-top-color: rgba(127, 255, 122, 0.62);
    border-bottom-color: rgba(127, 255, 122, 0.62);
}

.am-status-completed .active-mission-card-title {
    color: rgba(127, 255, 122, 0.78);
    text-shadow: 0 0 4px rgba(127, 255, 122, 0.3);
}

.am-status-completed .active-mission-card-progress {
    border-left-color: rgba(127, 255, 122, 0.24);
    border-right-color: rgba(127, 255, 122, 0.24);
    border-top-color: rgba(127, 255, 122, 0.24);
    border-bottom-color: rgba(127, 255, 122, 0.24);
}

.am-status-completed .active-mission-card-progress-fill {
    background-color: rgba(127, 255, 122, 0.58);
}

.am-status-expiring .active-mission-card-progress-fill {
    background-color: rgba(230, 201, 111, 0.8);
}

.am-status-failed .active-mission-card-progress-fill {
    background-color: rgba(211, 95, 95, 0.8);
}

/* ================= FACTION ACCENTS ================= */
.am-faction-custodi .active-mission-card-emoji {
    text-shadow: 0 0 6px rgba(127, 255, 122, 0.7);
}

.am-faction-routine .active-mission-card-emoji {
    text-shadow: 0 0 6px rgba(0, 255, 198, 0.7);
}

.am-faction-mercanti .active-mission-card-emoji {
    text-shadow: 0 0 6px rgba(230, 201, 111, 0.7);
}

.am-faction-cult .active-mission-card-emoji {
    text-shadow: 0 0 6px rgba(211, 95, 95, 0.7);
}

/* ================= TOOLTIP (hover card) ================= */
.active-mission-tooltip {
    position: absolute;
    width: 320px;
    flex-direction: column;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 12px;
    background-color: rgba(11, 13, 16, 0.95);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
}

.active-mission-tooltip.am-status-active {
    border-left-color: rgb(0, 255, 198);
    border-right-color: rgb(0, 255, 198);
    border-top-color: rgb(0, 255, 198);
    border-bottom-color: rgb(0, 255, 198);
}

.active-mission-tooltip.am-status-completed {
    border-left-color: rgba(127, 255, 122, 0.72);
    border-right-color: rgba(127, 255, 122, 0.72);
    border-top-color: rgba(127, 255, 122, 0.72);
    border-bottom-color: rgba(127, 255, 122, 0.72);
}

.active-mission-tooltip.am-status-expiring {
    border-left-color: rgb(230, 201, 111);
    border-right-color: rgb(230, 201, 111);
    border-top-color: rgb(230, 201, 111);
    border-bottom-color: rgb(230, 201, 111);
}

.active-mission-tooltip.am-status-failed {
    border-left-color: rgb(211, 95, 95);
    border-right-color: rgb(211, 95, 95);
    border-top-color: rgb(211, 95, 95);
    border-bottom-color: rgb(211, 95, 95);
}

.am-tooltip-scanline {
    height: 2px;
    width: 100%;
    margin-bottom: 4px;
    background-color: rgba(0, 255, 198, 0.05);
}

.am-tooltip-header {
    flex-direction: row;
    align-items: flex-start;
    padding-bottom: 8px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 255, 198, 0.3);
}

.am-tooltip-emoji {
    font-size: 18px;
    margin-right: 10px;
    text-shadow: 0 0 6px rgba(0, 255, 198, 0.5);
}

.am-tooltip-header-texts {
    flex-direction: column;
    flex-grow: 1;
}

.am-tooltip-title {
    font-size: 13px;
    letter-spacing: 0.8px;
    -unity-font-style: bold;
}

.active-mission-tooltip.am-status-active .am-tooltip-title {
    color: rgb(0, 255, 198);
    text-shadow: 0 0 8px rgba(0, 255, 198, 0.55);
}

.active-mission-tooltip.am-status-completed .am-tooltip-title {
    color: rgba(127, 255, 122, 0.82);
    text-shadow: 0 0 6px rgba(127, 255, 122, 0.35);
}

.active-mission-tooltip.am-status-expiring .am-tooltip-title {
    color: rgb(230, 201, 111);
    text-shadow: 0 0 8px rgba(230, 201, 111, 0.55);
}

.active-mission-tooltip.am-status-failed .am-tooltip-title {
    color: rgb(211, 95, 95);
    text-shadow: 0 0 8px rgba(211, 95, 95, 0.55);
}

.am-tooltip-faction {
    margin-top: 2px;
    font-size: 13px;
    letter-spacing: 0.6px;
    color: rgba(192, 200, 197, 0.8);
}

.am-tooltip-section {
    flex-direction: column;
    margin-top: 8px;
}

.am-tooltip-section-label {
    font-size: 13px;
    letter-spacing: 1.6px;
    -unity-font-style: bold;
    color: rgb(0, 255, 198);
}

.am-tooltip-objective {
    margin-top: 4px;
    margin-left: 16px;
    font-size: 13px;
    color: rgb(192, 200, 197);
    white-space: normal;
}

.am-tooltip-task-section {
    margin-top: 8px;
}

.am-tooltip-task-summary {
    margin-left: 16px;
    font-size: 13px;
    color: rgb(230, 201, 111);
}

.am-tooltip-reward-section {
    margin-top: 8px;
    padding-top: 8px;
    border-top-width: 2px;
    border-top-color: rgba(0, 255, 198, 0.3);
}

.am-tooltip-reward-label {
    color: rgb(127, 255, 122);
}

.am-tooltip-reward {
    margin-top: 4px;
    margin-left: 16px;
    font-size: 13px;
    white-space: normal;
}

.active-mission-tooltip.am-status-active .am-tooltip-reward {
    color: rgb(0, 255, 198);
}

.active-mission-tooltip.am-status-completed .am-tooltip-reward {
    color: rgba(127, 255, 122, 0.8);
}

.active-mission-tooltip.am-status-expiring .am-tooltip-reward {
    color: rgb(230, 201, 111);
}

.active-mission-tooltip.am-status-failed .am-tooltip-reward {
    color: rgb(211, 95, 95);
}

.am-tooltip-rep-row {
    margin-top: 4px;
    margin-left: 16px;
}

.am-tooltip-rep {
    font-size: 13px;
    color: rgb(127, 255, 122);
}

.am-tooltip-deadline {
    margin-top: 8px;
    padding-top: 8px;
    border-top-width: 2px;
    border-top-color: rgba(230, 201, 111, 0.3);
}

.am-tooltip-deadline-text {
    font-size: 13px;
    letter-spacing: 1.2px;
    -unity-font-style: bold;
    color: rgb(230, 201, 111);
}
