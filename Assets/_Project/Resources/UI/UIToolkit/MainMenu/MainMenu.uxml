<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/UIToolkit/Foundation/SP-Foundation.uss?fileID=7433441132597879392&amp;guid=41a5d4aa05ca1f9409da757ce7607bf4&amp;type=3#SP-Foundation" />
    <Style src="project://database/Assets/_Project/Resources/UI/UIToolkit/MainMenu/MainMenu.uss?fileID=7433441132597879392&amp;guid=791f1b16d4e143f7a1ee0e4efe87b12f&amp;type=3#MainMenu" />
    <ui:VisualElement name="main-menu-root" style="background-color: rgba(40, 40, 40, 0); background-image: none;">
        <ui:VisualElement name="main-menu-background" />
        <ui:VisualElement name="main-menu-content">
            <ui:VisualElement name="brand-header">
                <ui:VisualElement name="logo-placeholder-box" style="background-image: url(&quot;project://database/Assets/_Project/Art/logo_game_ufficiale.png?fileID=2800000&amp;guid=aa8ee0fcda11e4b48bf09e9d2a874e6f&amp;type=3#logo_game_ufficiale&quot;); background-color: rgba(0, 0, 0, 0);" />
                <ui:Label text="SPORIUM" name="brand-title" />
                <ui:Label text="BOTANICAL VAULT SIMULATION" name="brand-subtitle" />
                <ui:Label text="v0.8.2-ALPHA • BUILD 2026.04.01" name="brand-build-line" />
            </ui:VisualElement>
            <ui:VisualElement name="action-list">
                <ui:Button name="btn-new-game" class="menu-action menu-action--green">
                    <ui:VisualElement class="menu-action-icon-placeholder">
                        <ui:Label text="I" class="menu-action-icon-placeholder-text" />
                    </ui:VisualElement>
                    <ui:Label text="Nuova partita" class="menu-action-label" />
                    <ui:VisualElement class="menu-action-index-box">
                        <ui:Label text="1" class="menu-action-index-label" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="btn-save-main" class="menu-action menu-action--cyan">
                    <ui:VisualElement class="menu-action-icon-placeholder">
                        <ui:Label text="I" class="menu-action-icon-placeholder-text" />
                    </ui:VisualElement>
                    <ui:Label text="Salva" class="menu-action-label" />
                    <ui:VisualElement class="menu-action-index-box">
                        <ui:Label text="2" class="menu-action-index-label" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="btn-load-game" class="menu-action menu-action--blue">
                    <ui:VisualElement class="menu-action-icon-placeholder">
                        <ui:Label text="I" class="menu-action-icon-placeholder-text" />
                    </ui:VisualElement>
                    <ui:Label text="Carica partita" class="menu-action-label" />
                    <ui:VisualElement class="menu-action-index-box">
                        <ui:Label text="3" class="menu-action-index-label" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="btn-demo" class="menu-action menu-action--yellow">
                    <ui:VisualElement class="menu-action-icon-placeholder">
                        <ui:Label text="I" class="menu-action-icon-placeholder-text" />
                    </ui:VisualElement>
                    <ui:Label text="Gioca demo" class="menu-action-label" />
                    <ui:VisualElement class="menu-action-index-box">
                        <ui:Label text="4" class="menu-action-index-label" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="btn-settings-main" class="menu-action menu-action--violet">
                    <ui:VisualElement class="menu-action-icon-placeholder">
                        <ui:Label text="I" class="menu-action-icon-placeholder-text" />
                    </ui:VisualElement>
                    <ui:Label text="Impostazioni" class="menu-action-label" />
                    <ui:VisualElement class="menu-action-index-box">
                        <ui:Label text="5" class="menu-action-index-label" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="btn-exit" class="menu-action menu-action--red">
                    <ui:VisualElement class="menu-action-icon-placeholder">
                        <ui:Label text="I" class="menu-action-icon-placeholder-text" />
                    </ui:VisualElement>
                    <ui:Label text="Esci da Sporium" class="menu-action-label" />
                    <ui:VisualElement class="menu-action-index-box">
                        <ui:Label text="6" class="menu-action-index-label" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="loading-overlay">
                <ui:VisualElement name="loading-panel">
                    <ui:Label text="Caricamento 0%" name="loading-text" />
                    <ui:VisualElement name="loading-progress-track">
                        <ui:VisualElement name="loading-progress-fill" />
                    </ui:VisualElement>
                    <ui:Label text="" name="loading-continue-hint" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="btn-settings" style="border-left-color: rgb(88, 172, 212); border-right-color: rgb(88, 172, 212); border-top-color: rgb(88, 172, 212); border-bottom-color: rgb(88, 172, 212); right: 83px; bottom: 61px;">
                <ui:VisualElement name="settings-icon-placeholder-box" style="background-image: url(&quot;project://database/Assets/_Project/Art/UI/Icone%20ITEMS%20&amp;%20Actions/Icon_settings.png?fileID=2800000&amp;guid=b4571e5175138734c8b9e901a1dee9de&amp;type=3#Icon_settings&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
            </ui:Button>
            <ui:VisualElement name="footer-left">
                <ui:Label text="TERMINAL ID: VLT-01-ALPHA" name="footer-terminal-id" style="color: rgba(55, 107, 134, 0.88);" />
                <ui:Label text="BIOLOGIST STATION" name="footer-station" style="color: rgba(55, 108, 134, 0.78);" />
            </ui:VisualElement>
            <ui:VisualElement name="footer-center-status">
                <ui:VisualElement name="footer-live-dot" />
                <ui:Label text="VAULT SYSTEMS ONLINE • ALL PROTOCOLS NOMINAL" name="footer-live-text" style="color: rgba(70, 141, 67, 0.9);" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="options-overlay" class="options-overlay">
            <ui:VisualElement name="options-panel" class="options-panel">
                <ui:VisualElement name="options-header" class="options-header">
                    <ui:VisualElement name="options-header-titles" class="options-header-titles">
                        <ui:Label text="OPZIONI" name="options-title" class="options-title" />
                        <ui:Label text="Configura lingua e preferenze di sessione" name="options-subtitle" class="options-subtitle" />
                    </ui:VisualElement>
                    <ui:Button name="btn-options-close" class="options-close" text="CHIUDI" />
                </ui:VisualElement>
                <ui:VisualElement name="options-content" class="options-content">
                    <ui:VisualElement name="options-row-language" class="options-row">
                        <ui:VisualElement class="options-row-copy">
                            <ui:Label text="Lingua" name="options-language-title" class="options-row-title" />
                            <ui:Label text="Scegli la lingua dei testi di gioco." name="options-language-desc" class="options-row-desc" />
                        </ui:VisualElement>
                        <ui:VisualElement name="options-language-buttons" class="options-language-buttons">
                            <ui:Button name="btn-language-auto" class="options-language-button" text="AUTO" />
                            <ui:Button name="btn-language-it" class="options-language-button" text="IT" />
                            <ui:Button name="btn-language-en" class="options-language-button" text="EN" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="options-row-audio" class="options-row">
                        <ui:VisualElement class="options-row-copy">
                            <ui:Label text="Audio" name="options-audio-title" class="options-row-title" />
                            <ui:Label text="Apri il pannello volume audio esistente." name="options-audio-desc" class="options-row-desc" />
                        </ui:VisualElement>
                        <ui:VisualElement class="options-language-buttons">
                            <ui:Button name="btn-open-legacy-audio" class="options-language-button" text="AUDIO" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="save-slots-overlay" class="save-slots-overlay">
            <ui:VisualElement name="save-slots-panel" class="save-slots-panel">
                <ui:VisualElement name="save-slots-header" class="save-slots-header">
                    <ui:VisualElement name="save-slots-header-titles" class="save-slots-header-titles">
                        <ui:Label text="SALVATAGGI VAULT" name="save-slots-title" class="save-slots-title" />
                        <ui:Label text="Seleziona uno slot — stile terminale VLT-01" name="save-slots-subtitle" class="save-slots-subtitle" />
                    </ui:VisualElement>
                    <ui:Button name="btn-save-slots-close" class="save-slots-close" text="CHIUDI" />
                </ui:VisualElement>
                <ui:ScrollView name="save-slots-scroll" class="save-slots-scroll" mode="Vertical">
                    <ui:VisualElement name="save-slots-rows" class="save-slots-rows">
                        <ui:VisualElement name="save-slot-row-0" class="save-slot-row">
                            <ui:Label text="Slot 1 — …" name="save-slot-summary-0" class="save-slot-summary" />
                            <ui:VisualElement name="save-slot-actions-0" class="save-slot-actions">
                                <ui:Button name="save-slot-primary-0" class="menu-action menu-action--blue save-slot-primary">
                                    <ui:Label text="Carica" name="save-slot-primary-label-0" class="menu-action-label save-slot-primary-label" />
                                </ui:Button>
                                <ui:Button name="save-slot-delete-0" class="menu-action menu-action--red save-slot-delete" text="Elimina" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="save-slot-row-1" class="save-slot-row">
                            <ui:Label text="Slot 2 — …" name="save-slot-summary-1" class="save-slot-summary" />
                            <ui:VisualElement name="save-slot-actions-1" class="save-slot-actions">
                                <ui:Button name="save-slot-primary-1" class="menu-action menu-action--blue save-slot-primary">
                                    <ui:Label text="Carica" name="save-slot-primary-label-1" class="menu-action-label save-slot-primary-label" />
                                </ui:Button>
                                <ui:Button name="save-slot-delete-1" class="menu-action menu-action--red save-slot-delete" text="Elimina" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="save-slot-row-2" class="save-slot-row">
                            <ui:Label text="Slot 3 — …" name="save-slot-summary-2" class="save-slot-summary" />
                            <ui:VisualElement name="save-slot-actions-2" class="save-slot-actions">
                                <ui:Button name="save-slot-primary-2" class="menu-action menu-action--blue save-slot-primary">
                                    <ui:Label text="Carica" name="save-slot-primary-label-2" class="menu-action-label save-slot-primary-label" />
                                </ui:Button>
                                <ui:Button name="save-slot-delete-2" class="menu-action menu-action--red save-slot-delete" text="Elimina" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
