#main-menu-root {
    flex-grow: 1;
    position: relative;
    width: 100%;
    height: 100%;
}

#main-menu-background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(8, 16, 20);
    background-image: url("project://database/Assets/_Project/Art/Enviroments/Png/sporium-background-1920x1080.png?fileID=2800000&guid=00579057ad47f054a8ec7a3525fe815b&type=3#sporium-background-1920x1080");
    -unity-background-scale-mode: scale-and-crop;
}

#main-menu-content {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

#brand-header {
    align-items: center;
    margin-bottom: 28px;
}

#logo-placeholder-box {
    width: 96px;
    height: 129px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    justify-content: center;
    align-items: center;
    margin-bottom: 10px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    background-position-x: center;
    background-position-y: center;
}

#logo-placeholder-text {
    color: rgba(127, 255, 122, 0.85);
    font-size: 14px;
    letter-spacing: 1.2px;
    -unity-font-style: bold;
}

#brand-title {
    color: rgb(127, 255, 122);
    font-size: 48px;
    letter-spacing: 10px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

#brand-subtitle {
    color: rgba(93, 182, 227, 0.9);
    font-size: 15px;
    letter-spacing: 2px;
}

#brand-build-line {
    color: rgba(127, 255, 122, 0.75);
    font-size: 10px;
    letter-spacing: 1.3px;
    margin-top: 2px;
}

#action-list {
    width: 500px;
}

.menu-action {
    height: 62px;
    margin-bottom: 12px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 14px;
    padding-right: 14px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    background-color: rgba(12, 22, 28, 0.68);
    transition-duration: 0.09s;
}

.menu-action-icon-placeholder {
    width: 26px;
    height: 26px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    justify-content: center;
    align-items: center;
    margin-right: 12px;
    background-color: rgba(255, 255, 255, 0.03);
}

.menu-action-icon-placeholder-text {
    color: rgba(231, 244, 255, 0.75);
    font-size: 10px;
}

.menu-action-label {
    flex-grow: 1;
    color: rgb(231, 244, 255);
    font-size: 18px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.menu-action-index-box {
    width: 24px;
    height: 24px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.18);
}

.menu-action-index-label {
    color: rgba(231, 244, 255, 0.8);
    font-size: 11px;
}

.menu-action--green {
    border-top-color: rgba(127, 255, 122, 0.8);
    border-right-color: rgba(127, 255, 122, 0.8);
    border-bottom-color: rgba(127, 255, 122, 0.8);
    border-left-color: rgba(127, 255, 122, 0.8);
}

.menu-action--green:hover {
    background-color: rgba(127, 255, 122, 0.14);
    box-shadow: 0 0 26px rgba(127, 255, 122, 0.38);
}

.menu-action--blue {
    border-top-color: rgba(93, 182, 227, 0.85);
    border-right-color: rgba(93, 182, 227, 0.85);
    border-bottom-color: rgba(93, 182, 227, 0.85);
    border-left-color: rgba(93, 182, 227, 0.85);
}

.menu-action--blue:hover {
    background-color: rgba(93, 182, 227, 0.14);
    box-shadow: 0 0 26px rgba(93, 182, 227, 0.38);
}

.menu-action--yellow {
    border-top-color: rgba(230, 201, 111, 0.85);
    border-right-color: rgba(230, 201, 111, 0.85);
    border-bottom-color: rgba(230, 201, 111, 0.85);
    border-left-color: rgba(230, 201, 111, 0.85);
}

.menu-action--yellow:hover {
    background-color: rgba(230, 201, 111, 0.14);
    box-shadow: 0 0 26px rgba(230, 201, 111, 0.38);
}

.menu-action--violet {
    border-top-color: rgba(181, 128, 209, 0.9);
    border-right-color: rgba(181, 128, 209, 0.9);
    border-bottom-color: rgba(181, 128, 209, 0.9);
    border-left-color: rgba(181, 128, 209, 0.9);
}

.menu-action--violet:hover {
    background-color: rgba(181, 128, 209, 0.14);
    box-shadow: 0 0 26px rgba(181, 128, 209, 0.38);
}

.menu-action--red {
    border-top-color: rgba(211, 95, 95, 0.9);
    border-right-color: rgba(211, 95, 95, 0.9);
    border-bottom-color: rgba(211, 95, 95, 0.9);
    border-left-color: rgba(211, 95, 95, 0.9);
}

.menu-action--red:hover {
    background-color: rgba(211, 95, 95, 0.14);
    box-shadow: 0 0 26px rgba(211, 95, 95, 0.38);
}

.menu-action:disabled {
    opacity: 0.45;
}

#btn-settings {
    position: absolute;
    right: 28px;
    bottom: 24px;
    width: 42px;
    height: 42px;
    background-color: rgba(10, 16, 20, 0.75);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(230, 201, 111, 0.9);
    border-right-color: rgba(230, 201, 111, 0.9);
    border-bottom-color: rgba(230, 201, 111, 0.9);
    border-left-color: rgba(230, 201, 111, 0.9);
    justify-content: center;
    align-items: center;
}

#settings-icon-placeholder-box {
    width: 20px;
    height: 20px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(230, 201, 111, 0.9);
    border-right-color: rgba(230, 201, 111, 0.9);
    border-bottom-color: rgba(230, 201, 111, 0.9);
    border-left-color: rgba(230, 201, 111, 0.9);
    justify-content: center;
    align-items: center;
}

#settings-icon-placeholder-text {
    color: rgba(230, 201, 111, 0.95);
    font-size: 10px;
}

#footer-left {
    position: absolute;
    left: 12px;
    bottom: 10px;
}

#footer-terminal-id {
    color: rgba(93, 182, 227, 0.88);
    font-size: 11px;
    letter-spacing: 1px;
}

#footer-station {
    color: rgba(93, 182, 227, 0.78);
    font-size: 11px;
    letter-spacing: 1px;
    margin-top: 2px;
}

#footer-center-status {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

#footer-live-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(127, 255, 122);
    margin-right: 8px;
}

#footer-live-text {
    color: rgba(127, 255, 122, 0.9);
    font-size: 12px;
    letter-spacing: 1.1px;
}

/* Sotto l’action-list (stessa larghezza); niente overlay fullscreen sui bottoni */
#loading-overlay {
    width: 500px;
    margin-top: 16px;
    flex-shrink: 0;
    display: none;
    flex-direction: column;
    align-items: stretch;
}

#loading-panel {
    width: 100%;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 14px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(127, 255, 122, 0.85);
    border-right-color: rgba(127, 255, 122, 0.85);
    border-bottom-color: rgba(127, 255, 122, 0.85);
    border-left-color: rgba(127, 255, 122, 0.85);
    background-color: rgba(8, 16, 20, 0.92);
}

#loading-text {
    color: rgb(127, 255, 122);
    -unity-font-style: bold;
    font-size: 16px;
    margin-bottom: 10px;
}

#loading-progress-track {
    height: 12px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(127, 255, 122, 0.8);
    border-right-color: rgba(127, 255, 122, 0.8);
    border-bottom-color: rgba(127, 255, 122, 0.8);
    border-left-color: rgba(127, 255, 122, 0.8);
}

#loading-progress-fill {
    width: 0%;
    height: 100%;
    background-color: rgba(127, 255, 122, 0.92);
}

/* --- Save / Load slots (stesso look terminale del main menu) --- */
.save-slots-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 8, 10, 0.88);
    justify-content: center;
    align-items: center;
    display: none;
    flex-direction: column;
}

.save-slots-panel {
    width: 92%;
    max-width: 720px;
    max-height: 88%;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 18px;
    padding-bottom: 18px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(93, 182, 227, 0.85);
    border-right-color: rgba(93, 182, 227, 0.85);
    border-bottom-color: rgba(93, 182, 227, 0.85);
    border-left-color: rgba(93, 182, 227, 0.85);
    background-color: rgba(8, 16, 20, 0.96);
}

.save-slots-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
}

.save-slots-header-titles {
    flex-grow: 1;
    flex-direction: column;
}

.save-slots-title {
    color: rgb(127, 255, 122);
    font-size: 22px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.save-slots-subtitle {
    color: rgba(93, 182, 227, 0.88);
    font-size: 12px;
    letter-spacing: 1px;
}

.save-slots-close {
    min-width: 100px;
    height: 40px;
    background-color: rgba(12, 22, 28, 0.85);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(211, 95, 95, 0.75);
    border-right-color: rgba(211, 95, 95, 0.75);
    border-bottom-color: rgba(211, 95, 95, 0.75);
    border-left-color: rgba(211, 95, 95, 0.75);
    color: rgba(231, 244, 255, 0.95);
    font-size: 13px;
    -unity-font-style: bold;
}

.save-slots-scroll {
    max-height: 420px;
}

.save-slots-rows {
    flex-direction: column;
}

.save-slot-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(127, 255, 122, 0.35);
    border-right-color: rgba(127, 255, 122, 0.35);
    border-bottom-color: rgba(127, 255, 122, 0.35);
    border-left-color: rgba(127, 255, 122, 0.35);
    background-color: rgba(12, 22, 28, 0.55);
}

.save-slot-summary {
    flex-grow: 1;
    flex-shrink: 1;
    color: rgba(231, 244, 255, 0.92);
    font-size: 13px;
    letter-spacing: 0.5px;
    white-space: normal;
    margin-right: 12px;
}

.save-slot-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.save-slot-primary {
    height: 48px;
    min-width: 120px;
    margin-right: 8px;
    padding-left: 10px;
    padding-right: 10px;
}

.save-slot-primary .menu-action-label {
    -unity-text-align: middle-center;
}

.save-slot-delete {
    height: 48px;
    min-width: 96px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 13px;
    -unity-font-style: bold;
}

/* --- Options overlay (stesso linguaggio visuale del Main Menu) --- */
.options-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 8, 10, 0.88);
    justify-content: center;
    align-items: center;
    display: none;
    flex-direction: column;
}

.options-panel {
    width: 92%;
    max-width: 680px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 18px;
    padding-bottom: 18px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(230, 201, 111, 0.88);
    border-right-color: rgba(230, 201, 111, 0.88);
    border-bottom-color: rgba(230, 201, 111, 0.88);
    border-left-color: rgba(230, 201, 111, 0.88);
    background-color: rgba(8, 16, 20, 0.96);
}

.options-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 18px;
}

.options-header-titles {
    flex-grow: 1;
    flex-direction: column;
}

.options-title {
    color: rgb(230, 201, 111);
    font-size: 22px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.options-subtitle {
    color: rgba(93, 182, 227, 0.88);
    font-size: 12px;
    letter-spacing: 1px;
}

.options-close {
    min-width: 100px;
    height: 40px;
    background-color: rgba(12, 22, 28, 0.85);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(211, 95, 95, 0.75);
    border-right-color: rgba(211, 95, 95, 0.75);
    border-bottom-color: rgba(211, 95, 95, 0.75);
    border-left-color: rgba(211, 95, 95, 0.75);
    color: rgba(231, 244, 255, 0.95);
    font-size: 13px;
    -unity-font-style: bold;
}

.options-content {
    flex-direction: column;
}

.options-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(230, 201, 111, 0.35);
    border-right-color: rgba(230, 201, 111, 0.35);
    border-bottom-color: rgba(230, 201, 111, 0.35);
    border-left-color: rgba(230, 201, 111, 0.35);
    background-color: rgba(12, 22, 28, 0.55);
}

.options-row-copy {
    flex-grow: 1;
    flex-direction: column;
    margin-right: 16px;
}

.options-row-title {
    color: rgb(231, 244, 255);
    font-size: 16px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.options-row-desc {
    color: rgba(166, 199, 217, 0.86);
    font-size: 12px;
    margin-top: 4px;
}

.options-language-buttons {
    flex-direction: row;
    flex-shrink: 0;
}

.options-language-button {
    min-width: 76px;
    height: 42px;
    margin-left: 8px;
    background-color: rgba(12, 22, 28, 0.85);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(93, 182, 227, 0.65);
    border-right-color: rgba(93, 182, 227, 0.65);
    border-bottom-color: rgba(93, 182, 227, 0.65);
    border-left-color: rgba(93, 182, 227, 0.65);
    color: rgba(231, 244, 255, 0.95);
    font-size: 13px;
    -unity-font-style: bold;
}

.options-language-button--selected {
    background-color: rgba(127, 255, 122, 0.16);
    border-top-color: rgba(127, 255, 122, 0.9);
    border-right-color: rgba(127, 255, 122, 0.9);
    border-bottom-color: rgba(127, 255, 122, 0.9);
    border-left-color: rgba(127, 255, 122, 0.9);
    color: rgb(127, 255, 122);
}
