.elevd-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.elevd-frame {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    background-color: rgba(4, 8, 10, 0.94);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(127, 255, 122, 0.35);
    border-right-color: rgba(127, 255, 122, 0.35);
    border-bottom-color: rgba(127, 255, 122, 0.35);
    border-left-color: rgba(127, 255, 122, 0.35);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding: 10px 12px;
}

.elevd-stack {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
}

.elevd-direction-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    margin-bottom: 6px;
}

.elevd-direction-arrow {
    margin-right: 8px;
    color: rgb(255, 214, 74);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.elevd-direction-label {
    color: rgb(255, 214, 74);
    font-size: 24px;
    letter-spacing: 1.2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-transform: uppercase;
}

/* Opacità lampeggiante applicata a runtime (UiToolkitOpacityBlinker). */
.elevd-direction-label--blink {
    opacity: 1;
}

.elevd-divider {
    height: 2px;
    margin-top: 2px;
    margin-bottom: 8px;
    background-color: rgba(127, 255, 122, 0.72);
}

.elevd-floor-display {
    color: rgb(127, 255, 122);
    font-size: 42px;
    letter-spacing: 1.6px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-transform: uppercase;
    min-height: 48px;
    flex-shrink: 0;
}

.elevd-floor-marquee-clip {
    width: 100%;
    overflow: hidden;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    min-height: 48px;
}

.elevd-floor-marquee-clip .elevd-floor-display {
    -unity-text-align: middle-left;
}

.elevd-state-idle .elevd-direction-arrow {
    display: none;
}

.elevd-state-moving .elevd-floor-display {
    color: rgb(127, 255, 122);
}

.elevd-state-call .elevd-direction-label {
    color: rgb(255, 120, 120);
}

.elevd-state-call .elevd-divider {
    background-color: rgba(255, 120, 120, 0.72);
}

.elevd-state-call .elevd-floor-display {
    color: rgb(127, 255, 122);
}

.elevd-state-arriving .elevd-direction-label {
    color: rgb(255, 214, 74);
}

.elevd-state-arriving .elevd-floor-display {
    color: rgb(127, 255, 122);
}

.elevd-state-enter .elevd-floor-display {
    color: rgb(127, 255, 122);
}

.elevd-state-cabin .elevd-floor-display {
    color: rgb(127, 255, 122);
}

.elevd-state-select .elevd-floor-display {
    color: rgb(127, 255, 122);
}

.elevd-state-denied .elevd-floor-display {
    color: rgb(255, 120, 120);
    font-size: 28px;
}

.elevd-state-denied .elevd-divider {
    background-color: rgba(255, 120, 120, 0.72);
}
