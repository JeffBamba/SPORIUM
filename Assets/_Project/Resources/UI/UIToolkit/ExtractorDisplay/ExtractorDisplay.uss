.extd-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.extd-frame {
    width: 100%;
    height: 100%;
    flex-direction: row;
    background-color: rgba(16, 22, 30, 0.92);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(76, 118, 144, 0.62);
    border-right-color: rgba(76, 118, 144, 0.62);
    border-bottom-color: rgba(76, 118, 144, 0.62);
    border-left-color: rgba(76, 118, 144, 0.62);
}

.extd-art {
    width: 28%;
    height: 100%;
    background-color: rgba(62, 88, 110, 0.5);
    border-right-width: 1px;
    border-right-color: rgba(94, 132, 162, 0.24);
}

.extd-content {
    flex-grow: 1;
    padding: 10px 12px;
    flex-direction: column;
    justify-content: center;
}

.extd-machine-label {
    color: rgba(176, 205, 224, 0.88);
    font-size: 16px;
    letter-spacing: 0.8px;
}

.extd-state-label {
    margin-top: 2px;
    color: rgba(120, 176, 214, 0.84);
    font-size: 20px;
    -unity-font-style: bold;
}

.extd-detail-label {
    margin-top: 8px;
    color: rgba(160, 188, 204, 0.76);
    font-size: 13px;
    white-space: normal;
}

.extd-progress-wrap {
    margin-top: 10px;
    flex-direction: row;
    align-items: center;
}

.extd-progress-track {
    flex-grow: 1;
    height: 14px;
    background-color: rgba(8, 12, 16, 0.88);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(76, 118, 144, 0.58);
    border-right-color: rgba(76, 118, 144, 0.58);
    border-bottom-color: rgba(76, 118, 144, 0.58);
    border-left-color: rgba(76, 118, 144, 0.58);
}

.extd-progress-fill {
    width: 40%;
    height: 100%;
    background-color: rgba(96, 176, 208, 0.78);
}

.extd-progress-label {
    margin-left: 8px;
    min-width: 38px;
    color: rgba(110, 184, 212, 0.8);
    font-size: 12px;
    -unity-text-align: middle-right;
}

.extd-output-label {
    margin-top: 10px;
    color: rgba(136, 224, 186, 0.82);
    font-size: 13px;
    white-space: nowrap;
}

.extd-idle .extd-art {
    background-color: rgba(74, 102, 126, 0.58);
}

.extd-idle .extd-progress-fill {
    background-color: rgba(110, 178, 204, 0.16);
}

.extd-progress .extd-art {
    background-color: rgba(54, 120, 148, 0.66);
}

.extd-progress .extd-frame {
    border-top-color: rgba(100, 220, 248, 0.82);
    border-right-color: rgba(100, 220, 248, 0.82);
    border-bottom-color: rgba(100, 220, 248, 0.82);
    border-left-color: rgba(100, 220, 248, 0.82);
}

.extd-progress .extd-progress-track {
    border-top-color: rgba(100, 220, 248, 0.72);
    border-right-color: rgba(100, 220, 248, 0.72);
    border-bottom-color: rgba(100, 220, 248, 0.72);
    border-left-color: rgba(100, 220, 248, 0.72);
}

.extd-progress .extd-progress-fill {
    background-color: rgba(112, 230, 255, 0.94);
}

.extd-progress .extd-progress-label {
    color: rgba(122, 232, 255, 0.9);
}

.extd-progress .extd-state-label,
.extd-progress .extd-output-label {
    color: rgba(132, 224, 246, 0.88);
}

.extd-ready .extd-art {
    background-color: rgba(70, 112, 92, 0.64);
}

.extd-ready .extd-progress-track {
    border-top-color: rgba(90, 170, 132, 0.72);
    border-right-color: rgba(90, 170, 132, 0.72);
    border-bottom-color: rgba(90, 170, 132, 0.72);
    border-left-color: rgba(90, 170, 132, 0.72);
}

.extd-ready .extd-progress-fill {
    background-color: rgba(122, 210, 170, 0.82);
}

.extd-ready .extd-progress-label {
    color: rgba(122, 210, 170, 0.84);
}

.extd-ready .extd-output-label {
    color: rgba(132, 216, 178, 0.84);
}
