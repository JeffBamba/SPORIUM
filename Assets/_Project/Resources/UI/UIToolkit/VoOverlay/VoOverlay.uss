/* VO overlay — solo testo (nessun box/bordo); leggibilità via glow leggero. */

/* Fascia centrale tra PlayerStatus/Biologo (~28+242) e DomeStatusHUD (~380 da destra). */
.vo-overlay-root {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    top: 0;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 80px;
    padding-left: 276px;
    padding-right: 392px;
}

.vo-text-wrap {
    width: 100%;
    max-width: 680px;
    align-self: center;
    flex-direction: column;
    align-items: stretch;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.vo-sentences-host {
    flex-direction: column;
    align-items: center;
    width: 100%;
}

.vo-sentence-line {
    margin-bottom: 10px;
    -unity-text-align: middle-center;
    width: 100%;
}

/* Hint posizionato nel root (fuori da text-wrap) — non perturba il layout del blocco testo. */
.vo-continue-hint {
    position: absolute;
    left: 276px;
    right: 392px;
    bottom: 138px;
    font-size: 11px;
    letter-spacing: 0.35px;
    color: rgba(200, 200, 200, 0.72);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    display: flex;
    opacity: 0;
    pointer-events: none;
}

.vo-organic-host {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    width: 100%;
}

.vo-fragment {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
    white-space: nowrap;
    flex-shrink: 0;
}

.vo-body {
    font-size: 18px;
    letter-spacing: 0.6px;
    white-space: normal;
    -unity-text-align: middle-left;
}

/* Registro A — cyan + glow a strati (vicino / medio / alone) */
.vo-body--register-a {
    color: rgba(140, 235, 255, 1);
    text-shadow:
        0 0 6px rgba(100, 220, 255, 0.95),
        0 0 16px rgba(60, 180, 230, 0.75),
        0 0 32px rgba(40, 140, 200, 0.5),
        0 0 48px rgba(30, 100, 160, 0.35),
        0 0 3px rgba(0, 0, 0, 0.92),
        0 1px 8px rgba(0, 0, 0, 0.55);
}

/* Registro B — verde + glow a strati */
.vo-body--register-b {
    color: rgba(140, 255, 135, 1);
    text-shadow:
        0 0 6px rgba(150, 255, 150, 0.95),
        0 0 16px rgba(100, 230, 120, 0.7),
        0 0 32px rgba(70, 200, 90, 0.45),
        0 0 48px rgba(50, 160, 70, 0.3),
        0 0 3px rgba(0, 0, 0, 0.92),
        0 1px 8px rgba(0, 0, 0, 0.55);
}
