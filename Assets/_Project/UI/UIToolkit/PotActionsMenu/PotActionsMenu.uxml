<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="PotActionsMenu.uss" />

    <ui:VisualElement name="pot-ops-overlay" class="potops-overlay">
        <ui:VisualElement name="pot-ops-panel" class="potops-panel">
            <ui:VisualElement name="pot-ops-grid" class="potops-grid" />

            <ui:VisualElement name="pot-ops-header" class="potops-header">
                <ui:Label name="pot-ops-title" text="POT OPS" class="potops-title" />
                <ui:VisualElement name="pot-ops-status" class="potops-status">
                    <ui:Label name="pot-ops-status-label" text="○ VUOTO" class="potops-status-label" />
                    <ui:Button name="btn-close" class="potops-status-close">
                        <ui:Label text="×" class="potops-status-close-x" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="pot-ops-list" class="potops-list">
                <ui:Button name="btn-plant" class="potops-row potops-row-plant">
                    <ui:VisualElement name="row-iconbox" class="potops-iconbox" />
                    <ui:VisualElement name="row-text" class="potops-text">
                        <ui:Label name="row-title" text="PIANTA" class="potops-row-title" />
                        <ui:Label name="row-subtitle" text="Inserisci seme" class="potops-row-subtitle" />
                    </ui:VisualElement>
                    <ui:VisualElement name="row-dot" class="potops-dot" />
                </ui:Button>

                <ui:Button name="btn-remove" class="potops-row potops-row-remove">
                    <ui:VisualElement name="row-iconbox" class="potops-iconbox" />
                    <ui:VisualElement name="row-text" class="potops-text">
                        <ui:Label name="row-title" text="RIMUOVI" class="potops-row-title" />
                        <ui:Label name="row-subtitle" text="Estirpa" class="potops-row-subtitle" />
                    </ui:VisualElement>
                    <ui:Label name="row-right" text="×" class="potops-right-x" />
                </ui:Button>

                <ui:Button name="btn-harvest" class="potops-row potops-row-harvest">
                    <ui:VisualElement name="row-iconbox" class="potops-iconbox" />
                    <ui:VisualElement name="row-text" class="potops-text">
                        <ui:Label name="row-title" text="RACCOLTA" class="potops-row-title" />
                        <ui:Label name="row-subtitle" text="Raccogli" class="potops-row-subtitle" />
                    </ui:VisualElement>
                    <ui:Label name="row-right" text="×" class="potops-right-x" />
                </ui:Button>

                <ui:Button name="btn-inspect" class="potops-row potops-row-inspect">
                    <ui:VisualElement name="row-iconbox" class="potops-iconbox" />
                    <ui:VisualElement name="row-text" class="potops-text">
                        <ui:Label name="row-title" text="ISPEZIONA" class="potops-row-title" />
                        <ui:Label name="row-subtitle" text="Controlla pianta" class="potops-row-subtitle" />
                    </ui:VisualElement>
                    <ui:VisualElement name="row-dot" class="potops-dot" />
                </ui:Button>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

