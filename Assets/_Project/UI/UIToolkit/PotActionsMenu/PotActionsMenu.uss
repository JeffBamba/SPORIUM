.potops-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.0);
}

.potops-panel {
    --potops-green: rgb(127, 255, 122);
    --potops-blue: rgb(93, 182, 227);
    --potops-yellow: rgb(230, 201, 111);
    --potops-red: rgb(211, 95, 95);
    --potops-bg: rgb(10, 18, 22);
    --potops-metal: rgb(42, 58, 63);
    --potops-muted: rgba(192, 200, 197, 0.65);

    width: 520px;
    min-height: 520px;
    background-color: rgba(10, 18, 22, 0.96);
    border-width: 2px;
    border-color: var(--potops-green);
    padding: 18px;
    flex-direction: column;
    position: relative;
}

.potops-grid {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.12;
    background-color: rgba(255, 255, 255, 0.0);
    pointer-events: none;
}

.potops-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.potops-title {
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--potops-green);
    text-shadow: 0 0 8px var(--potops-green);
    -unity-font-style: bold;
}

.potops-status {
    border-width: 1px;
    border-color: rgba(93, 182, 227, 0.7);
    background-color: rgba(93, 182, 227, 0.10);
    padding: 6px 10px;
}

.potops-status-label {
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--potops-blue);
    text-shadow: 0 0 6px var(--potops-blue);
}

.potops-list {
    flex-direction: column;
    gap: 10px;
}

.potops-row {
    height: 76px;
    padding: 12px 12px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: rgba(255, 255, 255, 0.03);
}

.potops-row:hover:enabled {
    background-color: rgba(255, 255, 255, 0.06);
}

.potops-row:active:enabled {
    background-color: rgba(255, 255, 255, 0.08);
}

.potops-icon {
    font-size: 18px;
    width: 28px;
    -unity-text-align: middle-center;
    color: rgba(192, 200, 197, 0.9);
}

.potops-text {
    flex-direction: column;
    flex-grow: 1;
    margin-left: 10px;
}

.potops-row-title {
    font-size: 14px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.92);
}

.potops-row-subtitle {
    font-size: 11px;
    color: var(--potops-muted);
    margin-top: 4px;
}

.potops-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.25);
}

.potops-right-x {
    width: 28px;
    height: 28px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: rgba(255, 255, 255, 0.02);
    -unity-text-align: middle-center;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.35);
}

.potops-row-plant {
    border-color: rgba(127, 255, 122, 0.35);
    background-color: rgba(127, 255, 122, 0.05);
}

.potops-row-plant .potops-row-title {
    color: var(--potops-green);
    text-shadow: 0 0 6px rgba(127, 255, 122, 0.55);
}

.potops-row-plant .potops-dot {
    background-color: rgba(127, 255, 122, 0.55);
}

.potops-row-inspect {
    border-color: rgba(93, 182, 227, 0.35);
    background-color: rgba(93, 182, 227, 0.05);
}

.potops-row-inspect .potops-row-title {
    color: var(--potops-blue);
    text-shadow: 0 0 6px rgba(93, 182, 227, 0.55);
}

.potops-row-inspect .potops-dot {
    background-color: rgba(93, 182, 227, 0.55);
}

.potops-row-harvest {
    border-color: rgba(230, 201, 111, 0.35);
    background-color: rgba(230, 201, 111, 0.04);
}

.potops-row-harvest .potops-row-title {
    color: var(--potops-yellow);
    text-shadow: 0 0 6px rgba(230, 201, 111, 0.55);
}

.potops-row-remove {
    border-color: rgba(211, 95, 95, 0.35);
    background-color: rgba(211, 95, 95, 0.04);
}

.potops-row-remove .potops-row-title {
    color: var(--potops-red);
    text-shadow: 0 0 6px rgba(211, 95, 95, 0.55);
}

.potops-row:disabled {
    opacity: 0.35;
}

.potops-close-button {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 28px;
    height: 28px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: rgba(255, 255, 255, 0.02);
}

.potops-close-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.potops-close-x {
    -unity-text-align: middle-center;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.6);
}


