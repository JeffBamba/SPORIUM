.potops-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.potops-panel {
    --potops-green: rgb(127, 255, 122);
    --potops-blue: rgb(93, 182, 227);
    --potops-yellow: rgb(230, 201, 111);
    --potops-red: rgb(211, 95, 95);
    --potops-bg: rgb(10, 18, 22);
    --potops-metal: rgb(42, 58, 63);
    --potops-muted: rgba(192, 200, 197, 0.65);

    width: 440px;
    background-color: rgba(10, 18, 22, 0.96);
    border-width: 2px;
    border-color: var(--potops-green);
    padding: 18px;
    flex-direction: column;
    position: relative;
}

.potops-grid {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.18;
    background-color: rgba(255, 255, 255, 0.0);
    pointer-events: none;
}

.potops-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.potops-title {
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--potops-green);
    text-shadow: 0 0 8px var(--potops-green);
    -unity-font-style: bold;
}

.potops-status {
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: rgba(93, 182, 227, 0.7);
    background-color: rgba(93, 182, 227, 0.10);
    padding: 4px 6px 4px 10px;
}

.potops-status-label {
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--potops-blue);
    text-shadow: 0 0 6px var(--potops-blue);
}

.potops-status-close {
    width: 22px;
    height: 18px;
    margin-left: 10px;
    border-width: 0px;
    background-color: rgba(0, 0, 0, 0.0);
    border-left-width: 1px;
    border-left-color: rgba(93, 182, 227, 0.35);
}

.potops-status-close:hover {
    background-color: rgba(93, 182, 227, 0.08);
}

.potops-status-close-x {
    -unity-text-align: middle-center;
    font-size: 14px;
    color: rgba(93, 182, 227, 0.9);
}

.potops-list {
    flex-direction: column;
}

.potops-list > * {
    margin-bottom: 5px;
}

.potops-list > *:last-child {
    margin-bottom: 0;
}

.potops-row {
    height: 76px;
    padding: 12px 12px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: rgb(18, 28, 33);
}

.potops-row:hover:enabled { background-color: rgb(22, 34, 40); }
.potops-row:active:enabled { background-color: rgb(24, 38, 44); }

.potops-iconbox {
    width: 18px;
    height: 18px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.22);
    background-color: rgb(12, 18, 22);
}

.potops-text {
    flex-direction: column;
    flex-grow: 1;
    margin-left: 10px;
}

.potops-row-title {
    font-size: 14px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.92);
}

.potops-row-subtitle {
    font-size: 11px;
    color: var(--potops-muted);
    margin-top: 4px;
}

.potops-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.25);
}

.potops-right-x {
    width: 28px;
    height: 28px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: rgba(255, 255, 255, 0.02);
    -unity-text-align: middle-center;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.35);
}

.potops-row-plant {
    border-color: rgba(127, 255, 122, 0.35);
    background-color: rgb(22, 54, 34);
}
.potops-row-plant:hover:enabled { background-color: rgb(26, 64, 40); }
.potops-row-plant:active:enabled { background-color: rgb(28, 70, 44); }

.potops-row-plant .potops-row-title {
    color: var(--potops-green);
    text-shadow: 0 0 6px rgba(127, 255, 122, 0.55);
}

.potops-row-plant .potops-dot {
    background-color: rgba(127, 255, 122, 0.55);
}

.potops-row-inspect {
    border-color: rgba(93, 182, 227, 0.35);
    background-color: rgb(18, 42, 54);
}
.potops-row-inspect:hover:enabled { background-color: rgb(20, 50, 64); }
.potops-row-inspect:active:enabled { background-color: rgb(22, 56, 70); }

.potops-row-inspect .potops-row-title {
    color: var(--potops-blue);
    text-shadow: 0 0 6px rgba(93, 182, 227, 0.55);
}

.potops-row-inspect .potops-dot {
    background-color: rgba(93, 182, 227, 0.55);
}

.potops-row-harvest {
    border-color: rgba(230, 201, 111, 0.35);
    background-color: rgb(52, 46, 28);
}
.potops-row-harvest:hover:enabled { background-color: rgb(60, 54, 32); }
.potops-row-harvest:active:enabled { background-color: rgb(66, 58, 34); }

.potops-row-harvest .potops-row-title {
    color: var(--potops-yellow);
    text-shadow: 0 0 6px rgba(230, 201, 111, 0.55);
}

.potops-row-remove {
    border-color: rgba(211, 95, 95, 0.35);
    background-color: rgb(50, 26, 26);
}
.potops-row-remove:hover:enabled { background-color: rgb(60, 30, 30); }
.potops-row-remove:active:enabled { background-color: rgb(66, 34, 34); }

.potops-row-remove .potops-row-title {
    color: var(--potops-red);
    text-shadow: 0 0 6px rgba(211, 95, 95, 0.55);
}

.potops-row:disabled {
    opacity: 0.35;
}

/* EMPTY: solo PLANT, centrato come reference */
.potops-empty .potops-row-plant {
    justify-content: center;
}

.potops-empty .potops-row-plant .potops-iconbox {
    display: none;
}

.potops-empty .potops-row-plant .potops-dot {
    display: none;
}

.potops-empty .potops-row-plant .potops-text {
    margin-left: 0;
    align-items: center;
}

.potops-empty .potops-row-plant .potops-row-title,
.potops-empty .potops-row-plant .potops-row-subtitle {
    -unity-text-align: upper-center;
}


