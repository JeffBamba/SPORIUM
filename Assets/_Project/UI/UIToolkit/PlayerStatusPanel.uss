.player-status-panel {
    width: 220px;
    height: 250px;
    min-height: 250px;
    max-height: 250px;
    background-color: rgba(30, 40, 42, 0.9);
    border-width: 2px;
    border-top-color: rgb(93, 182, 227);
    border-right-color: rgb(93, 182, 227);
    border-bottom-color: rgb(93, 182, 227);
    border-left-color: rgb(93, 182, 227);
    padding: 12px;
    position: absolute;
    left: 0;
    top: 50%;
    margin-top: -100px;
    flex-direction: column;
    align-items: stretch;
    overflow: hidden;
}

.header-label {
    font-size: 11px;
    color: rgb(127, 255, 122);
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    letter-spacing: 2px;
    margin-bottom: 12px;
    text-shadow: 0 0 4px rgb(127, 255, 122);
}

.stats-container {
    flex-direction: column;
}

.stat-bar-container {
    flex-direction: column;
    margin-bottom: 4px;
    position: relative;
}

.stat-bar-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.stat-header-left {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
}

.hydration-box-icon {
    width: 14px;
    height: 14px;
    min-width: 14px;
    min-height: 14px;
    margin-right: 6px;
    border-width: 1px;
    border-color: rgba(149, 184, 226, 0.85);
    background-color: rgba(149, 184, 226, 0.12);
    -unity-background-scale-mode: scale-to-fit;
}

.stat-label {
    font-size: 10px;
    color: rgb(192, 200, 197);
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.stat-value {
    font-size: 9px;
    color: rgb(192, 200, 197);
    -unity-font-style: normal;
    -unity-text-align: middle-right;
}

.stat-bar {
    width: 100%;
    height: 16px;
    background-color: rgb(10, 18, 22);
    border-width: 1px;
    flex-direction: row;
    align-items: stretch;
}

.segmented-bar {
    padding: 0;
    background-color: rgb(10, 18, 22);
}

.bar-segment {
    flex-grow: 1;
    height: 100%;
    min-width: 0;
    max-width: 100%;
    background-color: rgb(30, 40, 42);
    border-width: 1px;
    border-top-color: rgba(30, 40, 42, 0.8);
    border-right-color: rgba(30, 40, 42, 0.8);
    border-bottom-color: rgba(30, 40, 42, 0.8);
    border-left-color: rgba(30, 40, 42, 0.8);
    margin-right: 1px;
}

.last-segment {
    margin-right: 0;
}

.bar-segment.filled {
}

.stat-bar-fill {
    height: 100%;
    background-color: rgb(127, 255, 122);
    border-width: 1px;
    border-color: rgb(127, 255, 122);
    min-width: 0;
}

.health-fill {
    background-color: rgb(127, 255, 122);
    border-color: rgb(127, 255, 122);
}

.energy-fill {
    background-color: rgb(93, 182, 227);
    border-color: rgb(93, 182, 227);
}

.hydration-fill {
    background-color: rgb(127, 255, 122);
    border-color: rgb(127, 255, 122);
}

.top-section {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.portrait-image {
    width: 64px;
    height: 64px;
    min-width: 64px;
    min-height: 64px;
    background-color: rgb(10, 18, 22);
    border-width: 2px;
    border-top-color: rgb(93, 182, 227);
    border-right-color: rgb(93, 182, 227);
    border-bottom-color: rgb(93, 182, 227);
    border-left-color: rgb(93, 182, 227);
}

.header-label {
    flex-grow: 1;
    margin-left: 8px;
    margin-right: 8px;
}

.header-button {
    min-width: 40px;
    height: 24px;
    font-size: 9px;
    color: rgb(192, 200, 197);
    background-color: rgba(10, 18, 22, 0.8);
    border-width: 1px;
    border-color: rgb(93, 182, 227);
    margin-left: 4px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.pixel-corner {
    width: 6px;
    height: 6px;
    position: absolute;
    background-color: rgb(93, 182, 227);
}

.corner-top-left {
    top: 0;
    left: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 2px;
    border-top-width: 2px;
    border-top-color: rgb(93, 182, 227);
    border-left-color: rgb(93, 182, 227);
}

.corner-top-right {
    top: 0;
    right: 0;
    border-left-width: 0;
    border-bottom-width: 0;
    border-right-width: 2px;
    border-top-width: 2px;
    border-top-color: rgb(93, 182, 227);
    border-right-color: rgb(93, 182, 227);
}

.corner-bottom-left {
    bottom: 0;
    left: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-left-width: 2px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(93, 182, 227);
    border-left-color: rgb(93, 182, 227);
}

.corner-bottom-right {
    bottom: 0;
    right: 0;
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(93, 182, 227);
    border-right-color: rgb(93, 182, 227);
}

.scanlines-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background-color: rgba(0, 255, 0, 0.02);
    opacity: 0.3;
}

.low-text {
    font-size: 9px;
    color: rgb(230, 201, 111);
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    margin-top: 4px;
    display: none;
    height: 0;
    overflow: hidden;
    margin-bottom: 0;
}

.warning-text {
    font-size: 8px;
    color: rgb(211, 95, 95);
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    margin-top: 2px;
    display: none;
    height: 0;
    overflow: hidden;
    margin-bottom: 0;
}

.diary-button {
    width: 100%;
    height: 32px;
    margin-top: 12px;
    background-color: rgba(10, 18, 22, 0.8);
    border-width: 1px;
    border-color: rgb(93, 182, 227);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 4px;
}

.diary-icon {
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    background-color: rgb(93, 182, 227);
    margin-right: 6px;
}

.diary-label {
    font-size: 9px;
    color: rgb(192, 200, 197);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.bar-segment.segment-blink {
}
