.inv-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 12px;
}

.inv-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.62);
}

.inv-terminal {
    position: relative;
    z-index: 1;
    align-self: center;
    margin-top: 0;
    margin-bottom: 0;
    padding: 24px;
    flex-direction: column;
    flex-shrink: 0;
    background-color: rgb(10, 15, 17);
    border-width: 12px;
    border-color: rgb(60, 84, 78);
    border-radius: 2px;
    overflow: visible;
    justify-content: flex-start;
}

.inv-terminal-size-default {
    width: 550px;
    min-width: 550px;
    max-width: 550px;
    height: 800px;
    min-height: 800px;
    max-height: 800px;
}

.inv-r1 {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(127, 255, 122, 0.12);
    height: 40px;
    min-height: 40px;
    max-height: 40px;
    flex-shrink: 0;
}

.inv-vault-label {
    font-size: 11px;
    letter-spacing: 2px;
    color: rgb(127, 255, 122);
    -unity-font-style: bold;
    margin-left: 12px;
}

.inv-close-txt {
    background-color: transparent;
    border-width: 0;
    padding: 0 4px;
    color: rgb(211, 95, 95);
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    flex-shrink: 0;
    min-width: 84px;
    -unity-text-align: middle-right;
    overflow: visible;
}

.inv-top-chrome {
    flex-direction: column;
    flex-shrink: 0;
    position: relative;
    z-index: 2;
    height: 170px;
    min-height: 170px;
    max-height: 170px;
    overflow: hidden;
}

.inv-browse-titles {
    flex-direction: column;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.inv-sub-pick {
    display: none;
    font-size: 11px;
    color: rgba(200, 210, 205, 0.75);
    white-space: normal;
}

.inv-db-title {
    font-size: 30px;
    letter-spacing: 3px;
    color: rgb(127, 255, 122);
    text-shadow: 0 0 12px rgba(127, 255, 122, 0.45);
    -unity-font-style: bold;
}

.inv-stats {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 16px;
    flex-shrink: 0;
}

.inv-stat {
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(127, 255, 122);
    margin-right: 24px;
    margin-bottom: 4px;
}

.inv-filters {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 16px;
    flex-shrink: 0;
}

.inv-filter-chip {
    margin-right: 8px;
    margin-bottom: 8px;
    padding: 6px 12px;
    background-color: rgba(26, 35, 37, 0.85);
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.22);
    border-radius: 2px;
    color: rgba(200, 210, 205, 0.55);
    font-size: 12px;
    letter-spacing: 0.5px;
}

.inv-filter-chip:hover {
    color: rgba(200, 210, 205, 0.85);
    border-color: rgba(127, 255, 122, 0.45);
}

.inv-filter-chip--active {
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.65);
    color: rgba(255, 255, 255, 0.92);
    background-color: rgba(127, 255, 122, 0.08);
}

.inv-list {
    flex-grow: 0;
    flex-shrink: 0;
    height: 388px;
    min-height: 388px;
    max-height: 388px;
    flex-direction: column;
    margin-bottom: 6px;
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.15);
    padding: 4px;
    padding-right: 8px;
    background-color: rgba(5, 9, 11, 0.45);
    position: relative;
    z-index: 1;
    overflow: visible;
}

.inv-terminal--detail-open .inv-list {
    height: 268px;
    min-height: 268px;
    max-height: 268px;
}

.inv-list .unity-scroller--vertical {
    width: 8px;
    margin-right: 1px;
    margin-left: 1px;
}

.inv-list .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(127, 255, 122, 0.08);
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.18);
    border-radius: 3px;
}

.inv-list .unity-scroller--vertical .unity-base-slider__dragger {
    border-radius: 3px;
    background-color: rgba(127, 255, 122, 0.22);
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.35);
}

.inv-list > * {
    margin-bottom: 4px;
}

.inv-expand {
    display: none;
    align-self: center;
    margin-top: 16px;
    margin-bottom: 0;
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(127, 255, 122, 0.2);
    padding-top: 8px;
    padding-bottom: 8px;
    color: rgb(127, 255, 122);
    font-size: 10px;
    letter-spacing: 1px;
    height: 26px;
    min-height: 26px;
    max-height: 26px;
    flex-shrink: 0;
}

.inv-expand:hover {
    color: rgb(160, 255, 150);
    border-bottom-color: rgba(127, 255, 122, 0.45);
}

.inv-row {
    min-height: 48px;
    padding: 10px 12px;
    border-width: 1px;
    border-radius: 2px;
    background-color: rgba(18, 28, 30, 0.95);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    transition-property: background-color, border-color, border-width;
    transition-duration: 0.12s;
}

.inv-row:hover {
    background-color: rgba(22, 34, 38, 0.98);
}

.inv-row--selected {
    border-width: 2px;
    background-color: rgba(28, 40, 44, 0.98);
}

.inv-row--cat-spores {
    border-color: rgba(200, 200, 120, 0.55);
}

.inv-row--cat-seeds {
    border-color: rgba(120, 200, 140, 0.55);
}

.inv-row--cat-organic {
    border-color: rgba(93, 182, 227, 0.55);
}

.inv-row--cat-reagents {
    border-color: rgba(211, 95, 95, 0.55);
}

.inv-row--cat-plants {
    border-color: rgba(100, 200, 130, 0.55);
}

.inv-row--cat-tools {
    border-color: rgba(230, 201, 111, 0.5);
}

.inv-row--cat-food {
    border-color: rgba(240, 180, 100, 0.5);
}

.inv-row--cat-bio {
    border-color: rgba(192, 128, 255, 0.45);
}

.inv-row-iconbox {
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    flex-shrink: 0;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.inv-row-mid {
    flex-grow: 1;
    flex-direction: column;
    align-items: flex-start;
    min-width: 80px;
}

.inv-row-topline {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.inv-row-name {
    font-size: 12px;
    letter-spacing: 0.5px;
    color: rgba(255, 255, 255, 0.92);
    -unity-font-style: bold;
}

.inv-row-qty-badge {
    font-size: 10px;
    color: rgba(200, 210, 205, 0.75);
    margin-left: 6px;
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.3);
    padding: 4px 10px;
}

.inv-row-sub {
    font-size: 10px;
    color: rgba(180, 190, 188, 0.65);
    margin-top: 2px;
}

.inv-row-btns {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 12px;
}

.inv-chip-btn {
    padding: 4px 12px;
    margin-left: 8px;
    font-size: 10px;
    letter-spacing: 0.5px;
    border-width: 1px;
    border-color: rgba(93, 182, 227, 0.45);
    background-color: rgba(93, 182, 227, 0.08);
    color: rgb(93, 182, 227);
}

.inv-chip-btn:disabled {
    opacity: 0.38;
    border-color: rgba(120, 130, 128, 0.25);
    color: rgba(160, 170, 168, 0.45);
    background-color: rgba(20, 26, 28, 0.5);
}

.inv-row.inv-row-disabled {
    opacity: 0.45;
}

.inv-row-right {
    flex-direction: row;
    align-items: center;
}

.inv-select {
    padding: 6px 10px;
    font-size: 10px;
    border-width: 1px;
    border-color: rgba(93, 182, 227, 0.6);
    color: rgb(93, 182, 227);
}

.inv-detail {
    display: flex;
    position: relative;
    flex-direction: column;
    margin-top: 16px;
    margin-bottom: 0;
    padding: 16px 0 14px 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(10, 17, 20, 0.97);
    /* Altezza sufficiente per riga + meta + pulsanti senza taglio (icon 64 + testi + CTA) */
    height: 158px;
    min-height: 158px;
    max-height: 158px;
    flex-shrink: 0;
    overflow: hidden;
}

/* Con item selezionato: niente linea sopra il box, più spazio lista, dettaglio ancorato in basso sullo spazio libero */
.inv-terminal--detail-open .inv-detail {
    margin-top: auto;
    padding-top: 8px;
    border-width: 0;
}

/* Linea verde tra lista / MOSTRA TUTTO e box dettaglio: viene dall’underline del pulsante expand */
.inv-terminal--detail-open .inv-expand {
    border-bottom-width: 0;
}

.inv-detail--cat-spores {
    border-color: rgba(200, 200, 120, 0.5);
}

.inv-detail--cat-seeds {
    border-color: rgba(120, 200, 140, 0.5);
}

.inv-detail--cat-organic {
    border-color: rgba(93, 182, 227, 0.5);
}

.inv-detail--cat-reagents {
    border-color: rgba(211, 95, 95, 0.5);
}

.inv-detail--cat-plants {
    border-color: rgba(100, 200, 130, 0.5);
}

.inv-detail--cat-tools {
    border-color: rgba(230, 201, 111, 0.45);
}

.inv-detail--cat-food {
    border-color: rgba(240, 180, 100, 0.45);
}

.inv-detail--cat-bio {
    border-color: rgba(192, 128, 255, 0.4);
}

.inv-detail-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.inv-detail-icon {
    width: 64px;
    height: 64px;
    min-width: 64px;
    min-height: 64px;
    margin-right: 16px;
    border-width: 2px;
    border-color: rgba(93, 182, 227, 0.55);
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.inv-detail-mid {
    flex-grow: 1;
    flex-direction: column;
}

.inv-detail-id-line {
    font-size: 14px;
    letter-spacing: 0.5px;
    color: rgba(200, 220, 215, 0.95);
    white-space: normal;
    -unity-font-style: bold;
}

.inv-detail-summary {
    font-size: 12px;
    color: rgba(104, 224, 133, 0.95);
    margin-top: 12px;
    margin-bottom: 12px;
    white-space: normal;
}

.inv-detail-qty {
    font-size: 10px;
    color: rgba(170, 230, 255, 0.95);
    border-width: 1px;
    border-color: rgba(93, 182, 227, 0.7);
    background-color: rgba(23, 61, 83, 0.45);
    padding: 2px 8px;
    margin-left: 8px;
    align-self: flex-start;
}

.inv-detail-meta {
    font-size: 11px;
    color: rgba(190, 200, 198, 0.85);
    white-space: nowrap;
    margin-bottom: 8px;
    display: flex;
    /* Allinea con il testo del one-liner (stessa colonna di inv-detail-mid: icona 64 + gap 16) */
    margin-left: 80px;
    margin-right: 0;
}

.inv-detail-actions {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    padding-top: 0;
    border-top-width: 0;
    margin-left: 80px;
    flex-shrink: 0;
}

.inv-detail-decay-wrap {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 72px;
    max-width: 220px;
    margin-right: 10px;
}

.inv-detail-decay-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.inv-detail-decay-condition-lbl {
    font-size: 10px;
    letter-spacing: 0.5px;
    color: rgba(127, 175, 151, 0.95);
    -unity-font-style: bold;
}

.inv-detail-decay-wrap .inv-detail-decay-row {
    flex-direction: row;
    align-items: center;
}

.inv-detail-decay-track {
    flex-grow: 1;
    height: 8px;
    min-height: 8px;
    max-height: 8px;
    background-color: rgba(20, 32, 36, 0.95);
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.22);
    border-radius: 2px;
    overflow: hidden;
}

/* Colore fill impostato a runtime in base alla % condizione */
.inv-detail-decay-fill {
    height: 100%;
    width: 100%;
    min-width: 0;
    background-color: rgba(90, 220, 120, 0.95);
    border-top-left-radius: 1px;
    border-bottom-left-radius: 1px;
}

.inv-detail-decay-pct {
    font-size: 10px;
    min-width: 38px;
    color: rgba(200, 220, 210, 0.9);
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

.inv-detail-btn {
    margin-right: 8px;
    margin-bottom: 2px;
    padding: 6px 16px;
    min-width: 118px;
    font-size: 10px;
    letter-spacing: 0.5px;
    -unity-font-style: bold;
    background-color: rgba(12, 20, 22, 0.85);
    border-width: 1px;
    border-radius: 2px;
}

.inv-detail-btn--use {
    border-color: rgba(93, 182, 227, 0.9);
    color: rgba(130, 220, 255, 0.95);
}

.inv-detail-btn--inspect {
    border-color: rgba(96, 192, 96, 0.75);
    color: rgba(127, 255, 122, 0.95);
}

.inv-footer {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 16px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgba(127, 255, 122, 0.12);
    min-height: 28px;
    flex-shrink: 0;
}

.inv-footer-txt {
    font-size: 10px;
    color: rgba(150, 165, 160, 0.65);
    max-width: 48%;
    white-space: normal;
}

.inv-cancel {
    display: none;
    margin-top: 6px;
    height: 40px;
    border-width: 1px;
    border-color: rgba(180, 100, 100, 0.5);
    background-color: rgb(28, 16, 16);
    justify-content: center;
    align-items: center;
}

.inv-cancel-text {
    font-size: 11px;
    letter-spacing: 1px;
    color: rgba(220, 120, 120, 0.9);
}

.inv-empty {
    padding: 20px;
    -unity-text-align: middle-center;
    font-size: 11px;
    color: rgba(180, 190, 188, 0.65);
}

.inv-confirm {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.inv-confirm--hidden {
    display: none;
}

.inv-confirm-panel {
    width: 500px;
    max-width: 90%;
    padding: 32px;
    background-color: rgb(20, 24, 26);
    border-width: 4px;
    border-color: rgba(230, 201, 111, 0.65);
    flex-direction: column;
}

.inv-confirm-title {
    font-size: 24px;
    color: rgba(230, 201, 111, 0.95);
    -unity-font-style: bold;
    margin-bottom: 24px;
}

.inv-confirm-body {
    font-size: 14px;
    color: rgba(220, 225, 222, 0.9);
    white-space: normal;
    margin-bottom: 24px;
}

.inv-confirm-btns {
    flex-direction: row;
    justify-content: flex-end;
}

.inv-confirm-yes {
    margin-right: 12px;
    min-width: 80px;
    padding: 12px;
    background-color: rgba(30, 80, 50, 0.9);
    color: rgb(127, 255, 122);
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.5);
}

.inv-confirm-no {
    min-width: 80px;
    padding: 12px;
    background-color: rgba(60, 30, 30, 0.9);
    color: rgba(255, 160, 150, 0.95);
    border-width: 1px;
    border-color: rgba(211, 95, 95, 0.45);
}

.inv-inspect {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 25;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.62);
}

.inv-inspect--hidden {
    display: none;
}

.inv-inspect-panel {
    width: 430px;
    max-width: 92%;
    max-height: 70%;
    padding: 14px;
    background-color: rgb(14, 20, 22);
    border-width: 2px;
    border-color: rgba(127, 255, 122, 0.55);
    flex-direction: column;
}

.inv-inspect-title {
    font-size: 13px;
    color: rgba(127, 255, 122, 0.95);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.inv-inspect-scroll {
    min-height: 120px;
    max-height: 380px;
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.2);
    padding: 8px;
    margin-bottom: 8px;
}

.inv-inspect-body {
    font-size: 12px;
    color: rgba(220, 230, 227, 0.9);
    white-space: normal;
}

.inv-inspect-close {
    align-self: flex-end;
    min-width: 86px;
    border-width: 1px;
    border-color: rgba(211, 95, 95, 0.55);
    color: rgba(255, 160, 150, 0.95);
    background-color: rgba(60, 30, 30, 0.82);
}

.inv-tooltip-floating {
    position: absolute;
    display: none;
    min-width: 200px;
    max-width: 320px;
    padding: 8px 10px;
    background-color: rgba(13, 18, 23, 0.96);
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.45);
    flex-direction: column;
}

.inv-tooltip-txt {
    font-size: 10px;
    color: rgba(240, 245, 250, 0.95);
    white-space: normal;
}

.inv-builder-reference {
    display: flex;
    flex-direction: column;
    margin-top: 8px;
    padding: 6px;
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.2);
    border-radius: 2px;
    flex-shrink: 0;
}

.inv-br-label {
    font-size: 10px;
    color: rgba(150, 160, 155, 0.6);
    margin-bottom: 4px;
}

.inv-builder-sample-row {
    margin-bottom: 0;
}

.inv-monitor-leds {
    position: absolute;
    right: 16px;
    bottom: 8px;
    flex-direction: row;
    align-items: center;
}

.inv-monitor-led {
    width: 8px;
    height: 8px;
    margin-left: 8px;
    border-radius: 4px;
    background-color: rgba(110, 140, 110, 0.65);
}

.inv-monitor-led--on {
    background-color: rgba(127, 255, 122, 0.95);
}
