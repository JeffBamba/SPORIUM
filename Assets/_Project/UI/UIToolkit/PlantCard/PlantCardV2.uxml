                        <ui:VisualElement name="header-right" class="header-right">
                            <ui:VisualElement name="led-on" class="led-indicator led-on" />
                            <ui:VisualElement name="led-off" class="led-indicator led-off" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="actions-grid" class="actions-grid">
                        <ui:Button name="spray-button" class="quick-action-button spray-button">
                            <ui:Label text="💨" class="action-icon" />
                            <ui:VisualElement name="action-divider" class="action-divider" />
                            <ui:Label text="SPRAY" class="action-label" />
                            <ui:Label text="Antifungal" class="action-sublabel" />
                        </ui:Button>
                        <ui:Button name="prune-button" class="quick-action-button prune-button">
                            <ui:Label text="✂️" class="action-icon" />
                            <ui:VisualElement name="action-divider" class="action-divider" />
                            <ui:Label text="PRUNE" class="action-label" />
                            <ui:Label text="Trim leaves" class="action-sublabel" />
                        </ui:Button>
                        <ui:Button name="fertilize-button" class="quick-action-button fertilize-button">
                            <ui:Label text="🧪" class="action-icon" />
                            <ui:VisualElement name="action-divider" class="action-divider" />
                            <ui:Label text="FERTILIZE" class="action-label" />
                            <ui:Label text="Boost growth" class="action-sublabel" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="manual-systems-panel" class="control-panel-solid manual-systems-panel">
                    <ui:VisualElement name="panel-header" class="panel-header">
                        <ui:VisualElement name="header-left" class="header-left">
                            <ui:VisualElement name="led-bar" class="led-bar led-bar-blue" />
                            <ui:Label text="MANUAL SYSTEMS" class="panel-header-text" />
                        </ui:VisualElement>
                        <ui:VisualElement name="header-right" class="header-right">
                            <ui:VisualElement name="sys-ok-badge" class="sys-ok-badge">
                                <ui:Label text="SYS OK" class="sys-ok-text" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="systems-grid" class="systems-grid">
                        <ui:VisualElement name="irrigation-container" class="rotary-container">
                            <ui:VisualElement name="rotary-header" class="rotary-header">
                                <ui:Label text="IRRIGATION" class="rotary-label" />
                                <ui:Label text="💧" class="rotary-icon" />
                            </ui:VisualElement>
                            <ui:VisualElement name="rotary-housing" class="rotary-housing">
                                <ui:Label name="position-off" text="OFF" class="position-marker position-left" />
                                <ui:Label name="position-on" text="ON" class="position-marker position-right" />
                                <ui:VisualElement name="rotary-knob" class="rotary-knob irrigation-knob">
                                    <ui:VisualElement name="indicator-line" class="indicator-line" />
                                    <ui:VisualElement name="center-led" class="center-led">
                                        <ui:VisualElement name="inner-led" class="inner-led" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="click-area-off" class="click-area click-area-left" />
                                    <ui:VisualElement name="click-area-on" class="click-area click-area-right" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Label name="irrigation-status" text="○ STANDBY" class="rotary-status-label" />
                        </ui:VisualElement>
                        <ui:VisualElement name="illuminazione-container" class="rotary-container">
                            <ui:VisualElement name="rotary-header" class="rotary-header">
                                <ui:Label text="ILLUMINAZIONE" class="rotary-label" />
                                <ui:Label text="⚡" class="rotary-icon" />
                            </ui:VisualElement>
                            <ui:VisualElement name="rotary-housing" class="rotary-housing">
                                <ui:Label name="position-blue" text="B" class="position-marker position-left" />
                                <ui:Label name="position-off" text="OFF" class="position-marker position-center" />
                                <ui:Label name="position-red" text="R" class="position-marker position-right" />
                                <ui:VisualElement name="rotary-knob" class="rotary-knob illuminazione-knob">
                                    <ui:VisualElement name="indicator-line" class="indicator-line" />
                                    <ui:VisualElement name="center-led" class="center-led">
                                        <ui:VisualElement name="inner-led" class="inner-led" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="click-area-blue" class="click-area click-area-left" />
                                    <ui:VisualElement name="click-area-off" class="click-area click-area-top" />
                                    <ui:VisualElement name="click-area-red" class="click-area click-area-right" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Label name="illuminazione-status" text="○ OFFLINE" class="rotary-status-label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
