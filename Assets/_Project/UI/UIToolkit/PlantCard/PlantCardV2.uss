.plant-card-v2 {
    --green-led: rgb(127, 255, 122);
    --blue-info: rgb(93, 182, 227);
    --red-warning: rgb(211, 95, 95);
    --yellow-standard: rgb(230, 201, 111);
    --violet-growth: rgb(181, 128, 209);
    --gray-text: rgb(192, 200, 197);
    --bg-dark: rgb(10, 18, 22);
    --bg-darker: rgb(15, 20, 22);
    --metal-light: rgb(58, 74, 79);
    --metal-dark: rgb(26, 35, 37);
}

.plant-card-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0.9);
    align-items: center;
    justify-content: center;
}

.folder-edge-top {
    position: absolute;
    width: 100%;
    height: 1.5px;
    top: 0;
    left: 0;
    background-color: var(--green-led);
    opacity: 0.3;
}

.plant-card-v2 {
    width: 1400px;
    min-height: 800px;
    background-color: rgb(27, 27, 27);
    border-width: 2px;
    border-color: var(--green-led);
    padding: 24px;
    position: relative;
    flex-direction: column;
    overflow: visible;
}

.crt-effect {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background-color: transparent;
    opacity: 0.5;
    pointer-events: none;
}

.grid-pattern {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background-color: transparent;
    opacity: 0.05;
    pointer-events: none;
}

.pixel-corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border-width: 2px;
    border-color: var(--green-led);
    opacity: 0.6;
    pointer-events: none;
}

.corner-top-left {
    top: 0;
    left: 0;
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 0;
    border-bottom-width: 0;
}

.corner-top-right {
    top: 0;
    right: 0;
    border-top-width: 2px;
    border-right-width: 2px;
    border-left-width: 0;
    border-bottom-width: 0;
}

.corner-bottom-left {
    bottom: 0;
    left: 0;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 0;
    border-top-width: 0;
}

.corner-bottom-right {
    bottom: 0;
    right: 0;
    border-bottom-width: 2px;
    border-right-width: 2px;
    border-left-width: 0;
    border-top-width: 0;
}

.header-section {
    flex-direction: column;
    padding-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(127, 255, 122, 0.2);
    margin-bottom: 20px;
    height: 114px;
    position: relative;
}

.header-top-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
}

.specimen-badge {
    background-color: rgba(127, 255, 122, 0.1);
    border-width: 1px;
    border-color: var(--green-led);
    padding: 12px;
    flex-direction: column;
}

.specimen-label {
    font-size: 10px;
    color: rgba(127, 255, 122, 0.7);
    letter-spacing: 2px;
    margin-bottom: 4px;
}

.specimen-id-text {
    font-size: 16px;
    color: var(--green-led);
    -unity-font-style: bold;
    letter-spacing: 2px;
    text-shadow: 0 0 8px var(--green-led);
}

.close-button {
    width: 32px;
    height: 32px;
    border-width: 2px;
    border-color: var(--red-warning);
    background-color: rgba(211, 95, 95, 0.1);
    -unity-text-align: middle-center;
}

.close-button:hover {
    background-color: rgba(211, 95, 95, 0.2);
}

.plant-name-info {
    flex-direction: column;
    margin-bottom: 16px;
    position: absolute;
    left: 119px;
}

.plant-name {
    font-size: 24px;
    color: var(--green-led);
    text-shadow: 0 0 8px var(--green-led);
    margin-bottom: 4px;
}

.plant-subtitle {
    font-size: 14px;
    color: rgba(192, 200, 197, 0.8);
    margin-bottom: 4px;
}

.plant-description {
    font-size: 14px;
    color: rgba(192, 200, 197, 0.7);
    -unity-font-style: italic;
}

.condition-growth-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    position: absolute;
    right: 57px;
}

.condition-container {
    flex-direction: row;
    align-items: center;
    flex: 1;
    justify-content: center;
    align-self: center;
}

.condition-label-text {
    font-size: 11px;
    color: rgba(192, 200, 197, 0.7);
    margin-right: 8px;
    -unity-text-align: middle-left;
}

.condition-badge {
    border-width: 2px;
    background-color: rgba(127, 255, 122, 0.2);
    padding: 8px 16px;
}

.condition-value-text {
    font-size: 11px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.growth-stage-container {
    flex-direction: row;
    align-items: center;
}

.growth-stage-label-text {
    font-size: 11px;
    color: rgba(192, 200, 197, 0.7);
    margin-right: 12px;
}

.growth-stage-badge {
    border-width: 2px;
    border-color: var(--violet-growth);
    background-color: rgba(181, 128, 209, 0.1);
    padding: 8px 12px;
    flex-direction: row;
    align-items: center;
}

.growth-stage-text {
    font-size: 11px;
    color: var(--violet-growth);
    text-shadow: 0 0 8px var(--violet-growth);
    margin-right: 8px;
}

.growth-progress-bar {
    flex-direction: row;
    margin-right: 8px;
}

.growth-segment {
    width: 1px;
    height: 12px;
    margin-right: 2px;
    background-color: rgba(181, 128, 209, 0.3);
}

.growth-counter {
    font-size: 11px;
    color: rgba(181, 128, 209, 0.7);
}

.main-layout-row {
    flex-direction: row;
    flex: 1;
    margin-bottom: 20px;
    min-height: 0;
    overflow: hidden;
}

.left-column {
    width: 480px;
    flex-direction: column;
    margin-right: 24px;
}

.plant-preview-box {
    border-width: 2px;
    border-color: rgba(127, 255, 122, 0.6);
    background-color: rgba(10, 18, 22, 0.5);
    padding: 16px;
    position: relative;
    min-height: 300px;
    margin-bottom: 16px;
    height: 516px;
}

.live-indicator {
    position: absolute;
    top: 8px;
    right: 8px;
    flex-direction: row;
    align-items: center;
}

.live-led {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--green-led);
    margin-right: 6px;
    animation: led-pulse 2s ease-in-out infinite;
}

.live-label {
    font-size: 10px;
    color: rgba(127, 255, 122, 0.8);
    letter-spacing: 2px;
}

.ph-drift-overlay {
    position: absolute;
    top: 8px;
    left: 8px;
    border-width: 1px;
    border-color: rgba(230, 201, 111, 0.5);
    background-color: rgba(230, 201, 111, 0.1);
    padding: 6px 10px;
    flex-direction: column;
}

.ph-drift-label {
    font-size: 9px;
    color: rgba(192, 200, 197, 0.7);
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.ph-drift-value {
    font-size: 12px;
    color: var(--yellow-standard);
    text-shadow: 0 0 6px var(--yellow-standard);
}

.plant-image-container {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    margin-top: 40px;
}

.plant-image {
    width: 100%;
    height: 100%;
    min-height: 200px;
    background-color: rgba(127, 255, 122, 0.1);
}

.action-buttons-row {
    flex-direction: row;
    gap: 12px;
}

.plant-button {
    flex: 1;
    padding: 16px;
    flex-direction: column;
    align-items: center;
    gap: 8px;
}

.remove-button {
    flex: 1;
    padding: 16px;
    flex-direction: column;
    align-items: center;
    gap: 8px;
}

.plant-button {
    border-width: 2px;
    border-color: rgba(127, 255, 122, 0.3);
    background-color: rgba(127, 255, 122, 0.05);
    opacity: 0.5;
}

.remove-button {
    border-width: 2px;
    border-color: var(--red-warning);
    background-color: rgba(211, 95, 95, 0.1);
}

.remove-button:hover {
    background-color: rgba(211, 95, 95, 0.2);
}

.button-icon {
    font-size: 24px;
}

.button-label {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.button-sublabel {
    font-size: 10px;
    color: rgba(192, 200, 197, 0.4);
}

.remove-button .button-label {
    color: var(--red-warning);
}

.remove-button .button-sublabel {
    color: rgba(211, 95, 95, 0.7);
}

.right-column {
    flex: 1;
    flex-direction: column;
}

.tab-switcher {
    flex-direction: row;
    gap: 8px;
    margin-bottom: 16px;
}

.tab-button {
    flex: 1;
    border-width: 1px;
    padding: 12px 16px;
    background-color: rgba(93, 182, 227, 0.05);
    border-color: rgba(93, 182, 227, 0.3);
    transition-duration: 0.15s;
}

.tab-button-active {
    background-color: rgba(93, 182, 227, 0.2);
    border-color: var(--blue-info);
}

.tab-label {
    font-size: 11px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.tab-button .tab-label {
    color: rgba(93, 182, 227, 0.6);
}

.tab-button-active .tab-label {
    color: var(--blue-info);
}

.tab-button:hover {
    scale: 1.02;
}

.tab-button:active {
    scale: 0.98;
}

.tab-content-container {
    flex: 1;
    position: relative;
    z-index: 1;
    height: 813px;
}

.tab-content {
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: column;
    display: none;
}

.tab-content.tab-active {
    height: 803px;
}

.tab-active {
    display: flex;
}

.parameters-grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 12px;
    position: relative;
}

.vital-parameter-box {
    min-width: 200px;
    border-width: 1px;
    padding: 12px;
    flex-direction: column;
    gap: 8px;
    /* IMPORTANTE: background-color e border-color NON sono definiti qui */
    /* Devono essere impostati SOLO come stili inline nel UXML o in UI Builder */
    /* Questo garantisce che gli stili modificati in UI Builder abbiano priorità assoluta */
}

/* RIMOSSE tutte le classi .parameter-hydration, .parameter-fertilizer, ecc. */
/* Queste classi causavano conflitti con gli stili inline modificati in UI Builder */
/* Ora gli stili devono essere impostati SOLO come inline nel UXML o in UI Builder */
/* Le proprietà di layout (position, top, left, width, height) sono già definite come inline nel UXML */

.parameter-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

.parameter-icon-placeholder {
    width: 24px;
    height: 24px;
    border-width: 1px;
    border-color: rgba(93, 182, 227, 0.4);
    background-color: rgba(93, 182, 227, 0.1);
}

.parameter-icon {
    font-size: 16px;
}

.parameter-label {
    font-size: 11px;
    color: rgba(192, 200, 197, 0.8);
    letter-spacing: 1px;
}

.vital-value-large {
    font-size: 36px;
    -unity-font-style: bold;
    text-shadow: 0 0 8px;
}

.vital-value-medium {
    font-size: 24px;
    -unity-font-style: bold;
    text-shadow: 0 0 8px;
}

/* Selettori basati sul name invece della classe per evitare conflitti */
#parameter-hydration .vital-value-large {
    color: var(--blue-info);
    text-shadow: 0 0 8px var(--blue-info);
}

#parameter-fertilizer .vital-value-large {
    /* Colore dinamico gestito da C# */
}

#parameter-light-stress .vital-value-large {
    color: var(--yellow-standard);
    text-shadow: 0 0 8px var(--yellow-standard);
}

#parameter-mold-risk .vital-value-large {
    color: var(--yellow-standard);
    text-shadow: 0 0 8px var(--yellow-standard);
}

#parameter-ph-affinity .vital-value-large {
    color: var(--yellow-standard);
    text-shadow: 0 0 8px var(--yellow-standard);
}

#parameter-condizione .vital-value-large {
    /* Colore dinamico gestito da C# */
}

.stat-bar.segmented-bar {
    width: 100%;
    height: 16px;
    background-color: rgb(10, 18, 22);
    border-width: 1px;
    flex-direction: row;
    align-items: center;
    padding: 0;
}

.stat-bar.segmented-bar .bar-segment {
    width: 16px;
    height: 16px;
    min-width: 16px;
    max-width: 16px;
    min-height: 16px;
    max-height: 16px;
    background-color: rgb(30, 40, 42);
    border-width: 1px;
    border-top-color: rgba(30, 40, 42, 0.8);
    border-right-color: rgba(30, 40, 42, 0.8);
    border-bottom-color: rgba(30, 40, 42, 0.8);
    border-left-color: rgba(30, 40, 42, 0.8);
    margin-right: 1px;
    flex-shrink: 0;
    flex-grow: 0;
}

.stat-bar.segmented-bar .bar-segment.last-segment {
    margin-right: 0;
}

.stat-bar.segmented-bar .bar-segment.filled {
    background-color: var(--blue-info);
    border-color: var(--blue-info);
}

.range-info {
    font-size: 10px;
    color: rgba(192, 200, 197, 0.6);
    margin-top: 4px;
}

.mold-risk-badge {
    background-color: rgba(230, 201, 111, 0.2);
    border-width: 1px;
    border-color: var(--yellow-standard);
    padding: 4px 8px;
    font-size: 9px;
    color: var(--yellow-standard);
}

.active-power-section {
    margin-top: 12px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgba(127, 255, 122, 0.3);
    flex-direction: column;
    gap: 8px;
    position: absolute;
    top: 421px;
    width: 843px;
}

.section-header {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.section-icon {
    font-size: 12px;
}

.section-label {
    font-size: 11px;
    color: rgba(192, 200, 197, 0.7);
}

.active-power-box {
    border-left-width: 2px;
    border-left-color: var(--green-led);
    background-color: rgba(127, 255, 122, 0.05);
    padding: 12px;
    flex-direction: column;
    gap: 6px;
}

.active-power-name {
    font-size: 14px;
    color: var(--green-led);
    text-shadow: 0 0 6px var(--green-led);
}

.active-power-list {
    flex-direction: column;
    gap: 4px;
}

.active-power-item {
    font-size: 11px;
    color: rgba(192, 200, 197, 0.7);
    margin-left: 8px;
}

.fruit-cycles-info {
    margin-top: 12px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgba(93, 182, 227, 0.3);
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    position: relative;
    top: 576px;
}

.fruit-cycles-value {
    font-size: 18px;
    color: var(--blue-info);
    text-shadow: 0 0 8px var(--blue-info);
}

.diary-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(230, 201, 111, 0.2);
    margin-bottom: 16px;
}

.diary-header-label {
    font-size: 11px;
    color: var(--yellow-standard);
    letter-spacing: 2px;
}

.add-note-button {
    width: 24px;
    height: 24px;
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.5);
    background-color: rgba(127, 255, 122, 0.1);
    -unity-text-align: middle-center;
}

.add-note-button:hover {
    background-color: rgba(127, 255, 122, 0.2);
}

.add-note-icon {
    font-size: 14px;
    color: var(--green-led);
}

.prodotti-section {
    margin-bottom: 16px;
    flex-direction: column;
    gap: 12px;
}

.prodotti-header {
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(127, 255, 122, 0.2);
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.prodotti-icon {
    font-size: 14px;
}

.prodotti-title {
    font-size: 11px;
    color: var(--green-led);
    letter-spacing: 2px;
}

.prodotti-content {
    border-width: 2px;
    border-color: rgba(127, 255, 122, 0.4);
    background-color: rgba(127, 255, 122, 0.05);
    padding: 12px;
    flex-direction: column;
    gap: 10px;
}

.prodotti-item {
    flex-direction: column;
    gap: 4px;
}

.prodotti-fruit-title {
    color: var(--green-led);
    text-shadow: 0 0 6px var(--green-led);
}

.prodotti-leaves-title {
    color: var(--blue-info);
}

.prodotti-seeds-title {
    color: var(--yellow-standard);
}

.prodotti-subtitle {
    color: rgba(192, 200, 197, 0.7);
}

.prodotti-details {
    padding-left: 16px;
    flex-direction: column;
    gap: 2px;
}

.prodotti-detail-text {
    color: rgba(192, 200, 197, 0.6);
    line-height: 1.6;
}

.notes-list {
    flex: 1;
    flex-direction: column;
    gap: 8px;
    overflow-y: auto;
}

.add-note-panel {
    margin-top: 12px;
    flex-direction: column;
    gap: 8px;
}

.note-textarea {
    width: 100%;
    min-height: 60px;
    background-color: rgba(10, 18, 22, 0.5);
    border-width: 1px;
    border-color: rgba(230, 201, 111, 0.4);
    padding: 8px;
    color: var(--gray-text);
}

.note-textarea:focus {
    border-color: var(--yellow-standard);
}

.note-buttons-row {
    flex-direction: row;
    gap: 8px;
}

.save-note-button {
    flex: 1;
    padding: 10px 16px;
    background-color: var(--bg-dark);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.cancel-note-button {
    flex: 1;
    padding: 10px 16px;
    background-color: var(--bg-dark);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.save-note-button {
    border-width: 2px;
    border-color: var(--green-led);
}

.save-note-text {
    font-size: 11px;
    color: var(--green-led);
    letter-spacing: 1px;
}

.led-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background-color: var(--green-led);
}

.cancel-note-button {
    border-width: 2px;
    border-color: var(--red-warning);
    gap: 6px;
}

.cancel-icon {
    font-size: 12px;
    color: var(--red-warning);
}

.cancel-text {
    font-size: 11px;
    color: var(--red-warning);
    letter-spacing: 1px;
}

.metal-separator {
    height: 12px;
    margin: 20px 0;
    position: relative;
    flex-shrink: 0;
    z-index: 0;
}

.metal-ridge {
    width: 100%;
    height: 12px;
    background-color: rgb(42, 58, 63);
}

.rivets-container {
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
}

.rivet {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: rgb(74, 90, 95);
}

.control-panel-row {
    flex-direction: row;
    gap: 20px;
    position: relative;
    z-index: 0;
    flex-shrink: 0;
    margin-top: 20px;
}

.control-panel-solid {
    flex: 1;
    border-width: 4px;
    border-color: var(--metal-light);
    background-color: rgb(26, 35, 37);
    padding: 20px;
}

.panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
    margin-bottom: 16px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(42, 58, 63);
}

.header-left {
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.led-bar {
    width: 4px;
    height: 32px;
    background-color: var(--yellow-standard);
}

.led-bar-blue {
    background-color: var(--blue-info);
}

.panel-header-text {
    font-size: 14px;
    color: var(--yellow-standard);
    letter-spacing: 2px;
    text-shadow: 0 0 8px var(--yellow-standard);
}

.header-right {
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.led-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
}

.led-on {
    background-color: var(--yellow-standard);
    animation: led-pulse 1.5s ease-in-out infinite;
}

.led-off {
    background-color: rgba(230, 201, 111, 0.3);
    opacity: 0.3;
}

.sys-ok-badge {
    background-color: rgb(10, 15, 16);
    border-width: 1px;
    border-color: rgb(42, 58, 63);
    padding: 4px 8px;
}

.sys-ok-text {
    font-size: 8px;
    color: var(--green-led);
    letter-spacing: 2px;
}

.actions-grid {
    flex-direction: row;
    gap: 16px;
}

.quick-action-button {
    flex: 1;
    border-width: 3px;
    background-color: rgb(42, 58, 63);
    padding: 20px 16px;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    transition-duration: 0.2s;
}

.spray-button {
    border-color: rgba(93, 182, 227, 0.6);
}

.prune-button {
    border-color: rgba(127, 255, 122, 0.6);
}

.fertilize-button {
    border-color: rgba(230, 201, 111, 0.6);
}

.quick-action-button:hover {
    translate: 0 -2px;
    scale: 1.02;
}

.quick-action-button:active {
    translate: 0 1px;
    scale: 0.98;
}

.action-icon {
    font-size: 36px;
}

.action-divider {
    width: 40px;
    height: 1px;
    background-color: rgba(93, 182, 227, 0.4);
}

.action-label {
    font-size: 12px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    text-shadow: 0 0 6px;
}

.spray-button .action-label {
    color: var(--blue-info);
    text-shadow: 0 0 6px var(--blue-info);
}

.prune-button .action-label {
    color: var(--green-led);
    text-shadow: 0 0 6px var(--green-led);
}

.fertilize-button .action-label {
    color: var(--yellow-standard);
    text-shadow: 0 0 6px var(--yellow-standard);
}

.action-sublabel {
    font-size: 10px;
    color: rgba(192, 200, 197, 0.7);
}

.systems-grid {
    flex-direction: row;
    gap: 20px;
}

.rotary-container {
    flex: 1;
    border-width: 2px;
    border-color: rgb(42, 58, 63);
    background-color: var(--bg-darker);
    padding: 16px;
    flex-direction: column;
    gap: 12px;
}

.rotary-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.rotary-label {
    font-size: 10px;
    color: rgba(192, 200, 197, 0.8);
    letter-spacing: 1px;
}

.rotary-icon {
    font-size: 16px;
    color: rgba(93, 182, 227, 0.6);
}

.rotary-housing {
    width: 100%;
    height: 80px;
    border-width: 3px;
    border-color: rgb(42, 58, 63);
    background-color: rgb(10, 15, 16);
    position: relative;
    align-items: center;
    justify-content: center;
}

.position-marker {
    position: absolute;
    top: 4px;
    font-size: 8px;
}

.position-left {
    left: 25%;
    color: rgba(211, 95, 95, 0.5);
}

.position-center {
    left: 50%;
    color: rgba(192, 200, 197, 0.3);
}

.position-right {
    right: 25%;
    color: rgba(127, 255, 122, 0.5);
}

.rotary-knob {
    width: 64px;
    height: 64px;
    border-width: 4px;
    border-color: var(--metal-light);
    border-radius: 50%;
    background-color: rgb(42, 58, 63);
    position: relative;
    align-items: center;
    justify-content: center;
    transition-duration: 0.3s;
    transition-property: rotate;
}

.rotary-knob:hover {
    cursor: pointer;
}

.indicator-line {
    position: absolute;
    width: 2px;
    height: 16px;
    top: 4px;
    background-color: var(--blue-info);
}

.center-led {
    width: 16px;
    height: 16px;
    border-width: 2px;
    border-color: rgb(26, 35, 37);
    border-radius: 50%;
    background-color: rgb(10, 15, 16);
    align-items: center;
    justify-content: center;
}

.inner-led {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--blue-info);
}

.click-area {
    position: absolute;
    width: 24px;
    height: 24px;
}

.click-area-left {
    left: 0;
}

.click-area-top {
    top: 0;
    left: 50%;
}

.click-area-right {
    right: 0;
}

.rotary-status-label {
    text-align: center;
    font-size: 9px;
    color: var(--blue-info);
}
