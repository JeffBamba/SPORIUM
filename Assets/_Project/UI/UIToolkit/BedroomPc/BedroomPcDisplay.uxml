                                <ui:VisualElement class="bedroom-pc-signal-bars">
                                    <ui:VisualElement class="bedroom-pc-signal-bar bedroom-pc-signal-bar-1" />
                                    <ui:VisualElement class="bedroom-pc-signal-bar bedroom-pc-signal-bar-2" />
                                    <ui:VisualElement class="bedroom-pc-signal-bar bedroom-pc-signal-bar-3" />
                                    <ui:VisualElement class="bedroom-pc-signal-bar bedroom-pc-signal-bar-4" />
