                                <ui:Label name="bedroom-pc-detail-status" text="READY" class="bedroom-pc-detail-status" />
                            </ui:VisualElement>
                            <ui:VisualElement name="bedroom-pc-detail-content" class="bedroom-pc-detail-content">
                                <ui:Label name="bedroom-pc-detail-primary" text="-" class="bedroom-pc-detail-primary" />
                                <ui:VisualElement name="bedroom-pc-control-list" class="bedroom-pc-control-list bedroom-pc-hidden">
                                    <ui:VisualElement class="bedroom-pc-control-grid-row">
                                        <ui:VisualElement class="bedroom-pc-control-row">
                                            <ui:VisualElement name="bedroom-pc-control-seed-icon" class="bedroom-pc-control-icon bedroom-pc-icon-placeholder">
                                                <ui:Label text="PNG" class="bedroom-pc-control-icon-label" />
                                            </ui:VisualElement>
                                            <ui:VisualElement class="bedroom-pc-control-info">
                                                <ui:Label name="bedroom-pc-control-seed-title" text="SEED STORAGE" class="bedroom-pc-control-title" />
                                                <ui:VisualElement class="bedroom-pc-control-line">
                                                    <ui:Label text="STATO" class="bedroom-pc-control-label" />
                                                    <ui:Label name="bedroom-pc-control-seed-state" text="-" class="bedroom-pc-control-value" />
                                                </ui:VisualElement>
                                                <ui:VisualElement class="bedroom-pc-control-line">
                                                    <ui:Label text="COSTO" class="bedroom-pc-control-label" />
                                                    <ui:Label name="bedroom-pc-control-seed-cost" text="-" class="bedroom-pc-control-value" />
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                            <ui:Button name="bedroom-pc-control-seed-toggle" text="-" class="bedroom-pc-control-toggle" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="bedroom-pc-control-row">
                                            <ui:VisualElement name="bedroom-pc-control-food-icon" class="bedroom-pc-control-icon bedroom-pc-icon-placeholder">
                                                <ui:Label text="PNG" class="bedroom-pc-control-icon-label" />
                                            </ui:VisualElement>
                                            <ui:VisualElement class="bedroom-pc-control-info">
                                                <ui:Label name="bedroom-pc-control-food-title" text="SINTETIZZATORE ALIMENTARE" class="bedroom-pc-control-title" />
                                                <ui:VisualElement class="bedroom-pc-control-line">
                                                    <ui:Label text="STATO" class="bedroom-pc-control-label" />
                                                    <ui:Label name="bedroom-pc-control-food-state" text="-" class="bedroom-pc-control-value" />
                                                </ui:VisualElement>
                                                <ui:VisualElement class="bedroom-pc-control-line">
                                                    <ui:Label text="COSTO" class="bedroom-pc-control-label" />
                                                    <ui:Label name="bedroom-pc-control-food-cost" text="-" class="bedroom-pc-control-value" />
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                            <ui:Button name="bedroom-pc-control-food-toggle" text="-" class="bedroom-pc-control-toggle" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="bedroom-pc-control-grid-row">
                                        <ui:VisualElement class="bedroom-pc-control-row">
                                            <ui:VisualElement name="bedroom-pc-control-pantry-icon" class="bedroom-pc-control-icon bedroom-pc-icon-placeholder">
                                                <ui:Label text="PNG" class="bedroom-pc-control-icon-label" />
                                            </ui:VisualElement>
                                            <ui:VisualElement class="bedroom-pc-control-info">
                                                <ui:Label name="bedroom-pc-control-pantry-title" text="DISPENSA REFRIGERATA" class="bedroom-pc-control-title" />
                                                <ui:VisualElement class="bedroom-pc-control-line">
                                                    <ui:Label text="STATO" class="bedroom-pc-control-label" />
                                                    <ui:Label name="bedroom-pc-control-pantry-state" text="-" class="bedroom-pc-control-value" />
                                                </ui:VisualElement>
                                                <ui:VisualElement class="bedroom-pc-control-line">
                                                    <ui:Label text="COSTO" class="bedroom-pc-control-label" />
                                                    <ui:Label name="bedroom-pc-control-pantry-cost" text="-" class="bedroom-pc-control-value" />
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                            <ui:Button name="bedroom-pc-control-pantry-toggle" text="-" class="bedroom-pc-control-toggle" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="bedroom-pc-control-row">
                                            <ui:VisualElement name="bedroom-pc-control-cryo-icon" class="bedroom-pc-control-icon bedroom-pc-icon-placeholder">
                                                <ui:Label text="PNG" class="bedroom-pc-control-icon-label" />
                                            </ui:VisualElement>
                                            <ui:VisualElement class="bedroom-pc-control-info">
                                                <ui:Label name="bedroom-pc-control-cryo-title" text="CRYO MACHINE" class="bedroom-pc-control-title" />
                                                <ui:VisualElement class="bedroom-pc-control-line">
                                                    <ui:Label text="STATO" class="bedroom-pc-control-label" />
                                                    <ui:Label name="bedroom-pc-control-cryo-state" text="-" class="bedroom-pc-control-value" />
                                                </ui:VisualElement>
                                                <ui:VisualElement class="bedroom-pc-control-line">
                                                    <ui:Label text="COSTO" class="bedroom-pc-control-label" />
                                                    <ui:Label name="bedroom-pc-control-cryo-cost" text="-" class="bedroom-pc-control-value" />
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                            <ui:Button name="bedroom-pc-control-cryo-toggle" text="-" class="bedroom-pc-control-toggle" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="bedroom-pc-control-grid-row">
                                        <ui:VisualElement class="bedroom-pc-control-row">
                                            <ui:VisualElement name="bedroom-pc-control-compost-icon" class="bedroom-pc-control-icon bedroom-pc-icon-placeholder">
                                                <ui:Label text="PNG" class="bedroom-pc-control-icon-label" />
                                            </ui:VisualElement>
                                            <ui:VisualElement class="bedroom-pc-control-info">
                                                <ui:Label name="bedroom-pc-control-compost-title" text="COMPOST PROCESSOR" class="bedroom-pc-control-title" />
                                                <ui:VisualElement class="bedroom-pc-control-line">
                                                    <ui:Label text="STATO" class="bedroom-pc-control-label" />
                                                    <ui:Label name="bedroom-pc-control-compost-state" text="-" class="bedroom-pc-control-value" />
                                                </ui:VisualElement>
                                                <ui:VisualElement class="bedroom-pc-control-line">
                                                    <ui:Label text="COSTO" class="bedroom-pc-control-label" />
                                                    <ui:Label name="bedroom-pc-control-compost-cost" text="-" class="bedroom-pc-control-value" />
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                            <ui:Button name="bedroom-pc-control-compost-toggle" text="-" class="bedroom-pc-control-toggle" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="bedroom-pc-control-recap">
                                            <ui:Label text="TOTALE COSTI MACCHINARI" class="bedroom-pc-control-recap-label" />
                                            <ui:Label name="bedroom-pc-control-total-cost" text="0 CRY/GIORNO" class="bedroom-pc-control-recap-value" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
