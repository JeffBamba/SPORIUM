<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/UIToolkit/BedroomPc/BedroomPcDisplay.uss?fileID=7433441132597879392&amp;guid=cc370e8ff33d57a469154d9230d84e15&amp;type=3#BedroomPcDisplay" />
    <ui:VisualElement name="bedroom-pc-display-root" class="bedroom-pc-display-root">
        <ui:VisualElement name="bedroom-pc-window" class="bedroom-pc-window">
            <ui:VisualElement name="bedroom-pc-frame-stack" class="bedroom-pc-frame-stack">
                <ui:VisualElement name="bedroom-pc-frame" picking-mode="Ignore" class="bedroom-pc-frame" style="background-image: url(&quot;project://database/Assets/_Project/Art/UI/PC-bedroom.png?fileID=2800000&amp;guid=8d521efefc29b3a4e92a2a06d1259cd5&amp;type=3#PC-bedroom&quot;); -unity-background-scale-mode: scale-to-fit;" />
                <ui:VisualElement name="bedroom-pc-inner" class="bedroom-pc-inner" style="left: 324px; right: 328px; top: 98px; bottom: 133px;">
                    <ui:VisualElement name="bedroom-pc-screen" class="bedroom-pc-screen" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;">
                        <ui:VisualElement picking-mode="Ignore" class="bedroom-pc-scanlines" />
                        <ui:VisualElement picking-mode="Ignore" class="bedroom-pc-glow-vignette" style="background-image: url(&quot;project://database/Assets/_Project/Art/crt-overlay-medium-1920x1080.png?fileID=2800000&amp;guid=a35e315d8bb3324478a8ff5fe5d20e41&amp;type=3#crt-overlay-medium-1920x1080&quot;);" />
                        <ui:VisualElement class="bedroom-pc-header">
                            <ui:Label name="bedroom-pc-terminal-label" text="TERMINALE 01" class="bedroom-pc-header-label bedroom-pc-header-label-left" />
                            <ui:Label name="bedroom-pc-os-label" text="OS v2.7.4" class="bedroom-pc-header-label bedroom-pc-header-label-center" />
                            <ui:Label name="bedroom-pc-time-label" text="GIORNO 01   14:32" class="bedroom-pc-header-label bedroom-pc-header-label-right" />
                        </ui:VisualElement>
                        <ui:VisualElement class="bedroom-pc-divider bedroom-pc-divider-top" />
                        <ui:VisualElement name="bedroom-pc-home" class="bedroom-pc-home" style="background-image: none;">
                            <ui:VisualElement class="bedroom-pc-app-grid">
                                <ui:Button name="bedroom-pc-app-control" class="bedroom-pc-app-tile">
                                    <ui:VisualElement name="bedroom-pc-icon-control" class="bedroom-pc-icon-box bedroom-pc-icon-placeholder" style="background-image: resource(&apos;UI/Icone_panels/Pannello di Controllo&apos;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-background-scale-mode: scale-to-fit; background-color: rgba(4, 34, 12, 0.74);" />
                                    <ui:Label text="PANNELLO DI" class="bedroom-pc-app-label" />
                                    <ui:Label text="CONTROLLO" class="bedroom-pc-app-label" />
                                </ui:Button>
                                <ui:Button name="bedroom-pc-app-research" class="bedroom-pc-app-tile">
                                    <ui:VisualElement name="bedroom-pc-icon-research" class="bedroom-pc-icon-box bedroom-pc-icon-placeholder" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: resource(&apos;UI/Icone_panels/Centro di Ricerca&apos;);" />
                                    <ui:Label text="CENTRO DI" class="bedroom-pc-app-label" />
                                    <ui:Label text="RICERCA" class="bedroom-pc-app-label" />
                                </ui:Button>
                                <ui:Button name="bedroom-pc-app-blackmarket" class="bedroom-pc-app-tile">
                                    <ui:VisualElement name="bedroom-pc-icon-blackmarket" class="bedroom-pc-icon-box bedroom-pc-icon-placeholder" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: resource(&apos;UI/Icone_panels/BlackMarket&apos;);" />
                                    <ui:Label text="BLACK MARKET" class="bedroom-pc-app-label bedroom-pc-app-label-single" />
                                </ui:Button>
                                <ui:Button name="bedroom-pc-app-faq" class="bedroom-pc-app-tile">
                                    <ui:VisualElement name="bedroom-pc-icon-faq" class="bedroom-pc-icon-box bedroom-pc-icon-placeholder">
                                        <ui:Label text="PNG" class="bedroom-pc-icon-placeholder-label" />
                                    </ui:VisualElement>
                                    <ui:Label text="FAQ - BOT" class="bedroom-pc-app-label bedroom-pc-app-label-single" />
                                </ui:Button>
                            </ui:VisualElement>
                            <ui:Label name="bedroom-pc-home-exit-hint" text="PREMI [ESC] PER CHIUDERE IL TERMINALE" class="bedroom-pc-home-exit-hint" />
                        </ui:VisualElement>
                        <ui:VisualElement name="bedroom-pc-detail" class="bedroom-pc-detail bedroom-pc-hidden">
