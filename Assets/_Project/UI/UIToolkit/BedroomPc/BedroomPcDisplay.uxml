                                <ui:Label name="bedroom-pc-detail-secondary" text="-" class="bedroom-pc-detail-secondary" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="bedroom-pc-divider bedroom-pc-divider-bottom" />
                        <ui:VisualElement class="bedroom-pc-footer">
                            <ui:Label name="bedroom-pc-user-label" text="UTENTE: OPERATORE" class="bedroom-pc-footer-label bedroom-pc-footer-left" />
                            <ui:Label name="bedroom-pc-session-label" text="SESSIONE ATTIVA" class="bedroom-pc-footer-label bedroom-pc-footer-center" />
                            <ui:VisualElement class="bedroom-pc-footer-right">
