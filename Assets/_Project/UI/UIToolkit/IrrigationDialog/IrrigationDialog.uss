.irrig-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.0);
}

.irrig-panel {
    --irrig-blue: rgb(93, 182, 227);
    --irrig-yellow: rgb(230, 201, 111);
    --irrig-muted: rgba(192, 200, 197, 0.65);

    width: 760px;
    min-height: 360px;
    background-color: rgba(10, 18, 22, 0.96);
    border-width: 2px;
    border-color: var(--irrig-blue);
    padding: 18px;
    flex-direction: column;
    position: relative;
}

.irrig-grid {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.12;
    background-color: rgba(255, 255, 255, 0.0);
    pointer-events: none;
}

.irrig-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}

.irrig-header-left {
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

.irrig-header-icon {
    font-size: 18px;
    color: var(--irrig-blue);
}

.irrig-title {
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--irrig-blue);
    text-shadow: 0 0 8px rgba(93, 182, 227, 0.6);
    -unity-font-style: bold;
}

.irrig-subtitle {
    font-size: 10px;
    color: var(--irrig-muted);
    margin-top: 4px;
}

.irrig-question {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 4px;
}

.irrig-seedname {
    font-size: 14px;
    letter-spacing: 1px;
    color: var(--irrig-blue);
    text-shadow: 0 0 8px rgba(93, 182, 227, 0.6);
    margin-top: 10px;
    -unity-font-style: bold;
}

.irrig-hint {
    font-size: 11px;
    color: var(--irrig-muted);
    margin-top: 10px;
}

.irrig-buttons {
    flex-direction: row;
    gap: 14px;
    margin-top: 22px;
}

.irrig-btn {
    flex: 1;
    height: 92px;
    border-width: 2px;
    background-color: rgba(255, 255, 255, 0.02);
    padding: 12px;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
}

.irrig-btn:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.irrig-btn-title {
    font-size: 12px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.irrig-btn-sub {
    font-size: 10px;
    margin-top: 6px;
    color: var(--irrig-muted);
}

.irrig-btn-yes {
    border-color: rgba(93, 182, 227, 0.65);
}

.irrig-btn-yes .irrig-btn-title {
    color: rgba(93, 182, 227, 0.95);
    text-shadow: 0 0 6px rgba(93, 182, 227, 0.6);
}

.irrig-btn-no {
    border-color: rgba(230, 201, 111, 0.65);
}

.irrig-btn-no .irrig-btn-title {
    color: rgba(230, 201, 111, 0.95);
    text-shadow: 0 0 6px rgba(230, 201, 111, 0.6);
}


