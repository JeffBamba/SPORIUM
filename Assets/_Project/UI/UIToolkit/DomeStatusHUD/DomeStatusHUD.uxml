<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="DomeStatusHUD.uss" />
    <ui:VisualElement name="dome-hud-root" class="dome-hud-root dome-hud-collapsed">

        <!-- Body: expands to the left of the toggle button -->
        <ui:VisualElement name="dome-hud-body" class="dome-hud-body">

            <!-- Tab bar -->
            <ui:VisualElement name="dome-hud-tabs" class="dome-hud-tabs">
                <ui:Button name="btn-tab-pots" class="dome-tab-btn dome-tab-active" text="POTS [0/4]" />
                <ui:Button name="btn-tab-cryo" class="dome-tab-btn" text="CRYO [0/3]" />
            </ui:VisualElement>

            <!-- Active Pots Section -->
            <ui:VisualElement name="dome-hud-section-pots" class="dome-hud-section">

                <ui:VisualElement name="dome-pot-row-0" class="dome-pot-row">
                    <ui:VisualElement name="dome-pot-preview-0" class="dome-pot-preview" />
                    <ui:VisualElement class="dome-pot-info">
                        <ui:Label name="dome-pot-name-0" class="dome-pot-name" text="—" />
                        <ui:Label name="dome-pot-sub-0" class="dome-pot-sub" text="" />
                        <ui:Label name="dome-pot-cond-0" class="dome-pot-cond" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement name="dome-pot-indicators-0" class="dome-pot-indicators">
                        <ui:Label name="dome-pot-water-0" class="dome-pot-indicator" text="○" />
                        <ui:Label name="dome-pot-led-0" class="dome-pot-indicator" text="○" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="dome-pot-row-1" class="dome-pot-row">
                    <ui:VisualElement name="dome-pot-preview-1" class="dome-pot-preview" />
                    <ui:VisualElement class="dome-pot-info">
                        <ui:Label name="dome-pot-name-1" class="dome-pot-name" text="—" />
                        <ui:Label name="dome-pot-sub-1" class="dome-pot-sub" text="" />
                        <ui:Label name="dome-pot-cond-1" class="dome-pot-cond" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement name="dome-pot-indicators-1" class="dome-pot-indicators">
                        <ui:Label name="dome-pot-water-1" class="dome-pot-indicator" text="○" />
                        <ui:Label name="dome-pot-led-1" class="dome-pot-indicator" text="○" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="dome-pot-row-2" class="dome-pot-row">
                    <ui:VisualElement name="dome-pot-preview-2" class="dome-pot-preview" />
                    <ui:VisualElement class="dome-pot-info">
                        <ui:Label name="dome-pot-name-2" class="dome-pot-name" text="—" />
                        <ui:Label name="dome-pot-sub-2" class="dome-pot-sub" text="" />
                        <ui:Label name="dome-pot-cond-2" class="dome-pot-cond" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement name="dome-pot-indicators-2" class="dome-pot-indicators">
                        <ui:Label name="dome-pot-water-2" class="dome-pot-indicator" text="○" />
                        <ui:Label name="dome-pot-led-2" class="dome-pot-indicator" text="○" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="dome-pot-row-3" class="dome-pot-row">
                    <ui:VisualElement name="dome-pot-preview-3" class="dome-pot-preview" />
                    <ui:VisualElement class="dome-pot-info">
                        <ui:Label name="dome-pot-name-3" class="dome-pot-name" text="—" />
                        <ui:Label name="dome-pot-sub-3" class="dome-pot-sub" text="" />
                        <ui:Label name="dome-pot-cond-3" class="dome-pot-cond" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement name="dome-pot-indicators-3" class="dome-pot-indicators">
                        <ui:Label name="dome-pot-water-3" class="dome-pot-indicator" text="○" />
                        <ui:Label name="dome-pot-led-3" class="dome-pot-indicator" text="○" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- Cryo Section (hidden until tab switched) -->
            <ui:VisualElement name="dome-hud-section-cryo" class="dome-hud-section" style="display: none;">

                <ui:VisualElement name="dome-cryo-row-0" class="dome-cryo-row">
                    <ui:Label name="dome-cryo-id-0" class="dome-cryo-id" text="CRYO-01" />
                    <ui:VisualElement class="dome-cryo-info">
                        <ui:Label name="dome-cryo-plant-0" class="dome-cryo-plant" text="—" />
                        <ui:Label name="dome-cryo-detail-0" class="dome-cryo-detail" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="dome-cryo-row-1" class="dome-cryo-row">
                    <ui:Label name="dome-cryo-id-1" class="dome-cryo-id" text="CRYO-02" />
                    <ui:VisualElement class="dome-cryo-info">
                        <ui:Label name="dome-cryo-plant-1" class="dome-cryo-plant" text="—" />
                        <ui:Label name="dome-cryo-detail-1" class="dome-cryo-detail" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="dome-cryo-row-2" class="dome-cryo-row">
                    <ui:Label name="dome-cryo-id-2" class="dome-cryo-id" text="CRYO-03" />
                    <ui:VisualElement class="dome-cryo-info">
                        <ui:Label name="dome-cryo-plant-2" class="dome-cryo-plant" text="—" />
                        <ui:Label name="dome-cryo-detail-2" class="dome-cryo-detail" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Toggle button: always visible, anchored to right edge -->
        <ui:Button name="dome-hud-toggle-btn" class="dome-hud-toggle-btn" text="«" />

        <!-- Shared floating tooltip (absolute, shown on row hover) -->
        <!-- Lines are created dynamically by DomeStatusHUDController with per-line colors -->
        <ui:VisualElement name="dome-hud-tooltip" class="dome-hud-tooltip" style="display: none;">
            <ui:VisualElement name="dome-hud-tooltip-lines" class="dome-hud-tooltip-lines" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
