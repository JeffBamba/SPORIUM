        <ui:VisualElement name="dome-hud-tooltip" class="dome-hud-tooltip" style="display: none;">
            <ui:VisualElement name="dome-hud-tooltip-scanlines" picking-mode="Ignore" class="dome-hud-tooltip-scanlines" />
            <ui:VisualElement name="dome-hud-tooltip-lines" class="dome-hud-tooltip-lines">
                <ui:Label name="dome-hud-tooltip-ph-title" text="■ Pianta esempio  Lvl 1" class="dome-hud-tooltip-line dome-hud-tooltip-line--title" style="color: rgb(80, 200, 220);" />
                <ui:Label name="dome-hud-tooltip-ph-sub" text="  POT-001 · Seme · Giorno 0" class="dome-hud-tooltip-line dome-hud-tooltip-line--subtitle" style="color: rgb(192, 200, 197);" />
                <ui:VisualElement class="dome-hud-tooltip-sep" />
                <ui:Label name="dome-hud-tooltip-ph-sec1" text="REQUISITI E AVANZAMENTO" class="dome-hud-tooltip-line dome-hud-tooltip-line--bold dome-hud-tooltip-line--section" style="color: rgb(200, 203, 200);" />
                <ui:Label text="  Idratazione   : 30–70%" class="dome-hud-tooltip-line dome-hud-tooltip-line--kv" style="color: rgb(192, 200, 197);" />
                <ui:Label text="  LED           : nessuno" class="dome-hud-tooltip-line dome-hud-tooltip-line--kv" style="color: rgb(192, 200, 197);" />
                <ui:Label text="  Fertilizzante : 0–60% (opzionale Seme/Germoglio)" class="dome-hud-tooltip-line dome-hud-tooltip-line--kv" style="color: rgb(192, 200, 197);" />
                <ui:Label text="  Durata        : 2 giorni" class="dome-hud-tooltip-line dome-hud-tooltip-line--kv" style="color: rgb(192, 200, 197);" />
                <ui:VisualElement class="dome-hud-tooltip-sep" />
                <ui:Label name="dome-hud-tooltip-ph-sec2" text="STATO ATTUALE" class="dome-hud-tooltip-line dome-hud-tooltip-line--bold dome-hud-tooltip-line--section" style="color: rgb(200, 203, 200);" />
                <ui:Label text="  Idratazione   : 0%" class="dome-hud-tooltip-line dome-hud-tooltip-line--kv" style="color: rgb(211, 95, 95);" />
                <ui:Label text="  Fertilizzante : non necessario in questo stadio" class="dome-hud-tooltip-line dome-hud-tooltip-line--kv" style="color: rgb(192, 200, 197);" />
                <ui:Label text="  LED           : OFF" class="dome-hud-tooltip-line dome-hud-tooltip-line--kv" style="color: rgb(211, 95, 95);" />
                <ui:Label text="  Light stress  : 40% (20–80% ideale)" class="dome-hud-tooltip-line dome-hud-tooltip-line--kv" style="color: rgb(230, 201, 111);" />
                <ui:Label text="  Condizione    : Appassita (50%)" class="dome-hud-tooltip-line dome-hud-tooltip-line--kv" style="color: rgb(230, 201, 111);" />
                <ui:VisualElement class="dome-hud-tooltip-sep" />
                <ui:Label text="── Poteri (vaso attivo) ──" class="dome-hud-tooltip-line dome-hud-tooltip-line--bold dome-hud-tooltip-line--poteri-h" style="color: rgb(80, 200, 220);" />
                <ui:Label text="  Attivo: (esempio potere)" class="dome-hud-tooltip-line dome-hud-tooltip-line--in-poteri" style="color: rgb(192, 200, 197);" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="dome-hud-builder-reference" class="dome-hud-builder-reference" style="display: flex;">
            <ui:Label name="dome-hud-builder-hint" text="UI Builder — stesso stile runtime: anche dome-hud-tooltip (sopra) ha placeholder; questo blocco = card espansa + CRYO + campione ph aggiuntivo. Regola: .cursor/rules/ui-hud-foundation-ui-builder-parity.mdc" class="dome-hud-builder-hint" />
            <ui:VisualElement name="dome-hud-builder-row" class="dome-hud-builder-row">
                <ui:VisualElement name="dome-hud-builder-tooltip-sample" class="dome-hud-builder-ph-tooltip dome-hud-builder-sample-wrap" style="position: relative; margin-right: 8px; margin-bottom: 8px;">
                    <ui:VisualElement class="dome-hud-builder-ph-title-row">
                        <ui:VisualElement picking-mode="Ignore" class="dome-hud-builder-ph-title-icon" />
                        <ui:Label text="STATO DRIFT pH — POT-001" class="dome-hud-builder-ph-title" />
                    </ui:VisualElement>
                    <ui:VisualElement class="dome-hud-builder-ph-section">
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="VALORE / CONDIZIONE" class="dome-hud-builder-ph-label" />
                            <ui:Label text="Appassita (50%) — Seme" class="dome-hud-builder-ph-value" />
                        </ui:VisualElement>
                        <ui:Label text="Il valore segue i requisiti dello stadio corrente." class="dome-hud-builder-ph-caption" />
                    </ui:VisualElement>
                    <ui:VisualElement class="dome-hud-builder-ph-box-grey">
                        <ui:Label text="PARAMETRI VASO (come TopBar · modificatori)" class="dome-hud-builder-ph-box-title" />
                        <ui:Label text="  Idratazione   : 0%" class="dome-hud-builder-ph-line" />
                        <ui:Label text="  Fertilizzante : 0%" class="dome-hud-builder-ph-line" />
                        <ui:Label text="  LED           : Blue" class="dome-hud-builder-ph-line" />
                        <ui:VisualElement style="flex-direction: row; align-items: center; margin-top: 4px;">
                            <ui:Label text="→ Drift pH stimato (vaso):" class="dome-hud-builder-ph-line-bold" />
                            <ui:Label text="-1.2" class="dome-hud-builder-ph-drift-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="dome-hud-builder-ph-box-cyan">
                        <ui:Label text="SLOT PASSIVI / EFFETTI CRYO" class="dome-hud-builder-ph-cyan-title" />
                        <ui:Label text="  Esempio riga passiva (stile ph-tooltip sezione CRYO)" class="dome-hud-builder-ph-line-cyan" />
                    </ui:VisualElement>
                    <ui:VisualElement class="dome-hud-builder-ph-box-tip">
                        <ui:Label text="SUGGERIMENTO" class="dome-hud-builder-ph-tip-title" />
                        <ui:Label text="Usa il terminale POT per annaffiare e regolare LED; il drift indicato si applica al cambio giornata." class="dome-hud-builder-ph-tip-body" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="dome-hud-builder-ph-crt-bar" />
                </ui:VisualElement>
                <ui:VisualElement name="dome-hud-builder-cryo-sample" class="dome-hud-builder-cryo-sample" style="width: 380px;">
                    <ui:VisualElement name="dome-cryo-row-sample" class="dome-cryo-row">
                        <ui:Label name="dome-cryo-id-sample" text="CRYO-01" class="dome-cryo-id" />
                        <ui:VisualElement name="dome-cryo-info-sample" class="dome-cryo-info">
                            <ui:Label name="dome-cryo-plant-sample" text="Glasscap Fungus" class="dome-cryo-plant" />
                            <ui:Label name="dome-cryo-detail-sample" text="pH 0/g  ·  Passive" class="dome-cryo-detail" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
