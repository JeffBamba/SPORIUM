                        <ui:Label name="dome-pot-sub-1" class="dome-pot-sub" />
                        <ui:Label name="dome-pot-cond-1" class="dome-pot-cond" />
                    </ui:VisualElement>
                    <ui:VisualElement name="dome-pot-indicators-1" class="dome-pot-indicators">
                        <ui:Label name="dome-pot-water-1" text="○" class="dome-pot-indicator" />
                        <ui:Label name="dome-pot-led-1" text="○" class="dome-pot-indicator" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="dome-pot-row-2" class="dome-pot-row">
