<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/UIToolkit/DomeStatusHUD/DomeStatusHUD.uss?fileID=7433441132597879392&amp;guid=0138b40a681e8a648b916d977f160dc9&amp;type=3#DomeStatusHUD" />
    <ui:VisualElement name="dome-hud-root" class="dome-hud-root dome-hud-collapsed" style="bottom: 53px; right: 4px; display: none;">
        <ui:VisualElement name="dome-hud-body" class="dome-hud-body" style="display: flex;">
            <ui:VisualElement name="dome-hud-tabs" class="dome-hud-tabs">
