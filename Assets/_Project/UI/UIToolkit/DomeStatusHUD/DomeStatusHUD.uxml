                    <ui:VisualElement name="dome-pot-indicators-2" class="dome-pot-indicators">
                        <ui:Label name="dome-pot-water-2" text="○" class="dome-pot-indicator" />
                        <ui:Label name="dome-pot-led-2" text="○" class="dome-pot-indicator" />
                    </ui:VisualElement>
