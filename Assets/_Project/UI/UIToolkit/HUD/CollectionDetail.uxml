<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/UIToolkit/HUD/CollectionDetail.uss?fileID=7433441132597879392&amp;guid=42f2232286960774098076a7e12bdbc0&amp;type=3#CollectionDetail" />
    <ui:VisualElement name="collection-detail" class="cdetail-root" style="display: flex;">
        <ui:VisualElement name="corner-top-left" picking-mode="Ignore" class="pixel-corner cdetail-corner corner-top-left" />
        <ui:VisualElement name="corner-top-right" picking-mode="Ignore" class="pixel-corner cdetail-corner corner-top-right" />
        <ui:VisualElement name="corner-bottom-left" picking-mode="Ignore" class="pixel-corner cdetail-corner corner-bottom-left" />
        <ui:VisualElement name="corner-bottom-right" picking-mode="Ignore" class="pixel-corner cdetail-corner corner-bottom-right" />
        <ui:VisualElement name="cdetail-header" class="cdetail-header">
            <ui:VisualElement name="cdetail-icon" class="cdetail-icon cdetail-icon-box" />
            <ui:VisualElement name="cdetail-title-col" class="cdetail-title-col">
                <ui:Label name="cdetail-name" text="ITEM NAME" class="cdetail-name" style="font-size: 13px;" />
                <ui:Label name="cdetail-typeid" text="ITEM_TYPE_ID" class="cdetail-typeid" style="font-size: 13px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="cdetail-sep" class="cdetail-sep" />
        <ui:VisualElement name="cdetail-row-qty" class="cdetail-row">
            <ui:Label text="Quantità" class="cdetail-key" style="font-size: 13px;" />
            <ui:Label name="cdetail-qty" text="1" class="cdetail-value" style="font-size: 13px;" />
        </ui:VisualElement>
        <ui:VisualElement name="cdetail-row-room" class="cdetail-row">
            <ui:Label text="Raccolta in" class="cdetail-key" style="font-size: 13px;" />
            <ui:Label name="cdetail-room" text="—" class="cdetail-value" style="font-size: 13px;" />
        </ui:VisualElement>
        <ui:VisualElement name="cdetail-row-genetic" class="cdetail-row">
            <ui:Label text="Tratti" class="cdetail-key" style="font-size: 13px;" />
            <ui:Label name="cdetail-val-genetic" text="—" class="cdetail-value" style="font-size: 13px;" />
        </ui:VisualElement>
        <ui:VisualElement name="cdetail-row-mutate" class="cdetail-row">
            <ui:Label text="% mutare" class="cdetail-key" style="font-size: 13px;" />
            <ui:Label name="cdetail-val-mutate" text="—" class="cdetail-value" style="font-size: 13px;" />
        </ui:VisualElement>
        <ui:VisualElement name="cdetail-row-stage" class="cdetail-row">
            <ui:Label text="Stadio" class="cdetail-key" style="font-size: 13px;" />
            <ui:Label name="cdetail-val-stage" text="—" class="cdetail-value" style="font-size: 13px;" />
        </ui:VisualElement>
        <ui:VisualElement name="cdetail-row-family" class="cdetail-row">
            <ui:Label text="Famiglia" class="cdetail-key" style="font-size: 13px;" />
            <ui:Label name="cdetail-val-family" text="—" class="cdetail-value" style="font-size: 13px;" />
        </ui:VisualElement>
        <ui:VisualElement name="cdetail-row-source" class="cdetail-row">
            <ui:Label text="Origine" class="cdetail-key" style="font-size: 13px;" />
            <ui:Label name="cdetail-val-source" text="—" class="cdetail-value" style="font-size: 13px;" />
        </ui:VisualElement>
        <ui:VisualElement name="cdetail-row-quality" class="cdetail-row">
            <ui:Label text="Qualità" class="cdetail-key" style="font-size: 13px;" />
            <ui:Label name="cdetail-val-quality" text="—" class="cdetail-value" style="font-size: 13px;" />
        </ui:VisualElement>
        <ui:VisualElement name="cdetail-row-active" class="cdetail-row">
            <ui:Label text="Potere attivo" class="cdetail-key" style="font-size: 13px;" />
            <ui:Label name="cdetail-val-active" text="—" class="cdetail-value cdetail-value-wrap" style="font-size: 13px;" />
        </ui:VisualElement>
        <ui:VisualElement name="cdetail-row-passive" class="cdetail-row">
            <ui:Label text="Potere passivo" class="cdetail-key" style="font-size: 13px;" />
            <ui:Label name="cdetail-val-passive" text="—" class="cdetail-value cdetail-value-wrap" style="font-size: 13px;" />
        </ui:VisualElement>
        <ui:VisualElement name="cdetail-sep2" class="cdetail-sep" />
        <ui:Label text="Tasto destro per chiudere" class="cdetail-hint" style="font-size: 13px;" />
    </ui:VisualElement>
</ui:UXML>
