/* CollectionBox — singolo box nell'area collection stack */

.cbox-root {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    flex-shrink: 0;
    position: relative;
    border-width: 2px;
    border-color: rgba(181, 128, 209, 0.7);
    background-color: rgba(12, 8, 18, 0.9);
    margin-left: 4px;
    cursor: link;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.cbox-root:hover {
    border-color: rgb(181, 128, 209);
    background-color: rgba(181, 128, 209, 0.12);
}

.cbox-corner {
    width: 3px;
    height: 3px;
    background-color: rgb(181, 128, 209);
}

.cbox-icon {
    width: 28px;
    height: 28px;
    min-width: 28px;
    min-height: 28px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(181, 128, 209, 0.15);
}

.cbox-qty-badge {
    position: absolute;
    bottom: 2px;
    right: 3px;
    font-size: 8px;
    color: rgb(181, 128, 209);
    -unity-font-style: bold;
    -unity-text-align: lower-right;
}
