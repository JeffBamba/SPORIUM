/* CollectionDetail — scheda dettaglio item */

.cdetail-root {
    position: relative;
    width: 280px;
    max-width: 92%;
    flex-shrink: 0;
    background-color: rgba(8, 12, 14, 0.97);
    border-width: 2px;
    border-color: rgba(181, 128, 209, 0.7);
    padding: 10px;
    flex-direction: column;
    overflow: visible;
}

.cdetail-corner {
    width: 3px;
    height: 3px;
    background-color: rgb(181, 128, 209);
}

/* Header */
.cdetail-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.cdetail-icon {
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 8px;
}

/* Stesso linguaggio del Collection box: cornice / outliner viola */
.cdetail-icon-box {
    border-width: 2px;
    border-color: rgba(181, 128, 209, 0.7);
    background-color: rgba(12, 8, 18, 0.9);
    align-items: center;
    justify-content: center;
}

.cdetail-title-col {
    flex-direction: column;
    flex-grow: 1;
}

.cdetail-name {
    font-size: 11px;
    color: rgb(200, 203, 200);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.cdetail-typeid {
    font-size: 8px;
    color: rgba(181, 128, 209, 0.6);
    letter-spacing: 1px;
    margin-top: 2px;
}

/* Separator */
.cdetail-sep {
    height: 1px;
    background-color: rgba(181, 128, 209, 0.25);
    margin-top: 4px;
    margin-bottom: 6px;
}

/* Rows */
.cdetail-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3px;
}

.cdetail-key {
    font-size: 9px;
    color: rgba(192, 200, 197, 0.6);
}

.cdetail-value {
    font-size: 9px;
    color: rgb(192, 200, 197);
    -unity-text-align: middle-right;
}

.cdetail-value-wrap {
    white-space: normal;
    max-width: 180px;
    -unity-text-align: upper-right;
}

.cdetail-plh {
    color: rgba(192, 200, 197, 0.3);
}

.cdetail-hint {
    font-size: 8px;
    color: rgba(192, 200, 197, 0.35);
    -unity-text-align: middle-center;
    margin-top: 4px;
    letter-spacing: 1px;
}
