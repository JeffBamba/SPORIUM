.top-bar {
    width: 100%;
    height: 80px;
    min-height: 80px;
    max-height: 80px;
    background-color: rgba(30, 40, 42, 0.9);
    border-bottom-width: 4px;
    border-bottom-color: rgba(127, 255, 122, 0.6);
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 18px;
    padding-bottom: 18px;
    position: absolute;
    top: 0;
    left: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: visible;
    box-shadow: 0 0 24px rgba(127, 255, 122, 0.84);
}

.glow-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    picking-mode: ignore;
}

.glow-frame-bottom {
    top: auto;
    height: 24px;
    bottom: -12px;
}

.scan-line-bottom {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background-color: rgba(127, 255, 122, 0.1);
    opacity: 0.1;
}

.top-bar-content {
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 64px;
    padding-right: 64px;
}

.metric-module {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-right: 48px;
}

.metric-module-ph {
    min-width: 220px;
}

.metric-stack {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    margin-left: 12px;
}

.metric-icon {
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    border-width: 2px;
    border-color: rgb(127, 255, 122);
    background-color: rgba(127, 255, 122, 0.1);
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 20px rgba(127, 255, 122, 0.9);
}

.metric-box {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 80px;
    margin-right: 24px;
}

.metric-box-ph {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 220px;
    margin-right: 24px;
}

.metric-label {
    font-size: 10px;
    color: rgb(192, 200, 197);
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    letter-spacing: 1px;
    margin-top: 0;
    margin-bottom: 4px;
    white-space: nowrap;
    height: auto;
}

.metric-label-ph {
    font-size: 18px;
    color: rgba(83, 144, 255, 0.85);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    margin-bottom: 0;
}

.metric-value {
    font-size: 13px;
    color: rgb(192, 200, 197);
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.metric-value-large {
    font-size: 16px;
    color: rgb(93, 182, 227);
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    text-shadow: 0 0 4px rgba(93, 182, 227, 0.8);
    white-space: nowrap;
}

.metric-value-ph {
    font-size: 12px;
    color: rgb(93, 182, 227);
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    text-shadow: 0 0 4px rgba(93, 182, 227, 0.8);
    white-space: nowrap;
}

.icon-placeholder {
    width: 28px;
    height: 28px;
    min-width: 28px;
    min-height: 28px;
    border-width: 2px;
    border-color: rgb(127, 255, 122);
    background-color: rgba(127, 255, 122, 0.1);
    align-items: center;
    justify-content: center;
    font-size: 14px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    box-shadow: 0 0 20px rgba(127, 255, 122, 0.9);
}

.icon-placeholder-center {
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    border-width: 2px;
    border-color: rgb(127, 255, 122);
    background-color: rgba(127, 255, 122, 0.1);
    align-items: center;
    justify-content: center;
    font-size: 16px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    position: absolute;
    left: 50%;
    top: 50%;
    margin-left: -16px;
    margin-top: -16px;
    box-shadow: 0 0 20px rgba(127, 255, 122, 0.9);
}

.segmented-bar {
    width: 80px;
    height: 20px;
    flex-direction: row;
    align-items: stretch;
    padding: 0;
    margin-top: 0;
}

.bar-segment {
    flex-grow: 1;
    height: 100%;
    min-width: 12px;
    background-color: rgb(30, 40, 42);
    border-width: 1px;
    border-color: rgba(230, 201, 111, 0.6);
    margin-right: 4px;
}

.bar-segment.filled {
    background-color: rgb(230, 201, 111);
    border-color: rgb(230, 201, 111);
    box-shadow: 0 0 16px rgb(230, 201, 111);
}

.mutation-orbit {
    width: 64px;
    height: 64px;
    min-width: 64px;
    min-height: 64px;
    position: relative;
    align-items: center;
    justify-content: center;
}

.orbit-dot {
    width: 8px;
    height: 8px;
    min-width: 8px;
    min-height: 8px;
    background-color: rgb(127, 255, 122);
    border-radius: 50%;
    position: absolute;
    box-shadow: 0 0 12px rgb(127, 255, 122);
}

.ph-slider {
    width: 200px;
    height: 12px;
    position: relative;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    overflow: visible;
    margin-top: 4px;
    margin-bottom: 4px;
}

.ph-gradient {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background-color: rgb(255, 42, 42);
}

.ph-neutral-zone {
    position: absolute;
    width: 40%;
    height: 100%;
    left: 30%;
    top: 0;
    background-color: rgba(216, 255, 229, 0.35);
    border-radius: 0;
}

.ph-marker {
    width: 14px;
    height: 14px;
    min-width: 14px;
    min-height: 14px;
    position: absolute;
    top: 50%;
    margin-top: -7px;
    background-color: rgb(255, 255, 255);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.8);
    border-radius: 50%;
}

.ph-band {
    font-size: 12px;
    color: rgba(83, 144, 255, 0.85);
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    margin-top: 0;
    margin-bottom: 0;
    font-weight: normal;
    white-space: nowrap;
}

.ph-tooltip-ph-gradient {
    min-height: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    background-color: rgb(80, 80, 80);
}

.ph-tooltip-modifier-icon {
    width: 20px;
    height: 20px;
    min-width: 20px;
    min-height: 20px;
    margin-right: 8px;
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.5);
    background-color: rgba(127, 255, 122, 0.08);
    align-items: center;
    justify-content: center;
}

.pixel-corner {
    width: 3px;
    height: 3px;
    position: absolute;
    background-color: rgb(127, 255, 122);
    box-shadow: 0 0 12px rgb(127, 255, 122);
}

.corner-top-left {
    top: 0;
    left: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 2px;
    border-top-width: 2px;
    border-top-color: rgb(127, 255, 122);
    border-left-color: rgb(127, 255, 122);
}

.corner-top-right {
    top: 0;
    right: 0;
    border-left-width: 0;
    border-bottom-width: 0;
    border-right-width: 2px;
    border-top-width: 2px;
    border-top-color: rgb(127, 255, 122);
    border-right-color: rgb(127, 255, 122);
}

.corner-bottom-left {
    bottom: 0;
    left: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-left-width: 2px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(127, 255, 122);
    border-left-color: rgb(127, 255, 122);
}

.corner-bottom-right {
    bottom: 0;
    right: 0;
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(127, 255, 122);
    border-right-color: rgb(127, 255, 122);
}
