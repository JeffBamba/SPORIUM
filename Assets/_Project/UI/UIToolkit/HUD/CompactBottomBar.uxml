<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/UIToolkit/HUD/CompactBottomBar.uss?fileID=7433441132597879392&amp;guid=4f57f6b671be9f641957f9831cc16f35&amp;type=3#CompactBottomBar" />
    <ui:VisualElement name="cbb-hud-root" picking-mode="Ignore" class="cbb-hud-root" style="flex-direction: column-reverse;">
        <ui:VisualElement name="compact-bottom-bar" class="compact-bottom-bar" style="border-top-color: rgba(93, 182, 227, 0.7);">
            <ui:VisualElement name="corner-top-left" picking-mode="Ignore" class="pixel-corner corner-top-left" style="background-color: rgb(82, 159, 198);" />
            <ui:VisualElement name="corner-top-right" picking-mode="Ignore" class="pixel-corner corner-top-right" style="background-color: rgb(82, 159, 198);" />
            <ui:VisualElement name="corner-bottom-left" picking-mode="Ignore" class="pixel-corner corner-bottom-left" style="background-color: rgb(82, 159, 198);" />
            <ui:VisualElement name="corner-bottom-right" picking-mode="Ignore" class="pixel-corner corner-bottom-right" style="background-color: rgb(82, 159, 198);" />
            <ui:VisualElement name="scan-line" picking-mode="Ignore" class="cbb-scan-line" />
            <ui:VisualElement name="zone-left" class="cbb-zone cbb-zone-left" style="left: 24px;">
                <ui:VisualElement name="day-badge" class="cbb-badge cbb-day-badge" style="border-left-color: rgba(93, 182, 227, 0.55); border-right-color: rgba(93, 182, 227, 0.55); border-top-color: rgba(93, 182, 227, 0.55); border-bottom-color: rgba(93, 182, 227, 0.55);">
                    <ui:VisualElement name="day-icon" picking-mode="Ignore" class="cbb-day-icon" style="background-color: rgba(93, 182, 227, 0.12); border-left-color: rgba(93, 182, 227, 0.65); border-right-color: rgba(93, 182, 227, 0.65); border-top-color: rgba(93, 182, 227, 0.65); border-bottom-color: rgba(93, 182, 227, 0.65); background-image: url(&quot;project://database/Assets/_Project/Art/UI/Icone%20ITEMS%20&amp;%20Actions/Icona_calendar.png?fileID=2800000&amp;guid=1829a3f6478310c42a8c2920be966d73&amp;type=3#Icona_calendar&quot;);" />
                    <ui:Label name="day-label" text="DAY - 1" class="cbb-day-label" style="color: rgb(93, 182, 227); font-size: 12px;" />
                </ui:VisualElement>
                <ui:VisualElement name="cry-badge" class="cbb-badge cbb-cry-badge" style="left: 12px;">
                    <ui:VisualElement name="cry-icon" picking-mode="Ignore" class="cbb-cry-icon" style="background-image: url(&quot;project://database/Assets/_Project/Art/UI/Icone%20ITEMS%20&amp;%20Actions/Icona_Cry.png?fileID=21300000&amp;guid=23e3fafbaad31674c881fafffbd6637e&amp;type=3#Icona_Cry&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(93, 182, 227, 0);" />
                    <ui:Label name="cry-label" text="0 CRY" class="cbb-cry-label" style="font-size: 12px; color: rgb(93, 182, 227);" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="zone-center" class="cbb-zone cbb-zone-center">
                <ui:VisualElement name="room-btn-dome" class="cbb-room-btn room-available">
                    <ui:VisualElement name="room-icon-dome" picking-mode="Ignore" class="cbb-room-icon" />
                </ui:VisualElement>
                <ui:VisualElement name="room-btn-lab" class="cbb-room-btn room-available">
                    <ui:VisualElement name="room-icon-lab" picking-mode="Ignore" class="cbb-room-icon" />
                </ui:VisualElement>
                <ui:VisualElement name="room-btn-kitchen" class="cbb-room-btn room-available">
                    <ui:VisualElement name="room-icon-kitchen" picking-mode="Ignore" class="cbb-room-icon" />
                </ui:VisualElement>
                <ui:VisualElement name="room-btn-dormitory" class="cbb-room-btn room-available">
                    <ui:VisualElement name="room-icon-dormitory" picking-mode="Ignore" class="cbb-room-icon" />
                </ui:VisualElement>
                <ui:VisualElement name="room-btn-visitor" class="cbb-room-btn room-available">
                    <ui:VisualElement name="room-icon-visitor" picking-mode="Ignore" class="cbb-room-icon" />
                </ui:VisualElement>
                <ui:VisualElement name="room-btn-storage" class="cbb-room-btn room-available">
                    <ui:VisualElement name="room-icon-storage" picking-mode="Ignore" class="cbb-room-icon" />
                </ui:VisualElement>
                <ui:VisualElement name="room-btn-restricted1" class="cbb-room-btn room-locked">
                    <ui:VisualElement name="room-icon-restricted1" picking-mode="Ignore" class="cbb-room-icon" />
                </ui:VisualElement>
                <ui:VisualElement name="room-btn-restricted2" class="cbb-room-btn room-locked">
                    <ui:VisualElement name="room-icon-restricted2" picking-mode="Ignore" class="cbb-room-icon" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="zone-collectors" class="cbb-zone cbb-zone-collectors" style="border-right-width: 2px; border-left-width: 2px; border-right-color: rgb(56, 76, 82); border-left-color: rgb(56, 76, 82); border-top-color: rgb(56, 76, 82); border-bottom-color: rgb(56, 76, 82);">
                <ui:VisualElement name="collection-box-stack" class="cbb-collection-stack" />
            </ui:VisualElement>
            <ui:VisualElement name="zone-right" class="cbb-zone cbb-zone-right">
                <ui:Button name="btn-options" tooltip="Opzioni" class="cbb-sys-btn cbb-sys-btn-options" style="border-left-color: rgba(41, 74, 86, 0.35); border-right-color: rgba(41, 74, 86, 0.35); border-top-color: rgba(41, 74, 86, 0.35); border-bottom-color: rgba(41, 74, 86, 0.35); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;">
                    <ui:VisualElement name="sys-icon-options" picking-mode="Ignore" class="cbb-sys-icon" style="background-color: rgba(93, 182, 227, 0); background-image: url(&quot;project://database/Assets/_Project/Art/UI/Icone%20ITEMS%20&amp;%20Actions/Icon_settings.png?fileID=2800000&amp;guid=b4571e5175138734c8b9e901a1dee9de&amp;type=3#Icon_settings&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-background-image-tint-color: rgb(255, 255, 255);" />
                </ui:Button>
                <ui:Button name="btn-save" tooltip="Salva partita" class="cbb-sys-btn cbb-sys-btn-save" style="border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgba(105, 93, 52, 0.4); border-right-color: rgba(105, 93, 52, 0.4); border-top-color: rgba(105, 93, 52, 0.4); border-bottom-color: rgba(105, 93, 52, 0.4);">
                    <ui:VisualElement name="sys-icon-save" picking-mode="Ignore" class="cbb-sys-icon" style="background-image: url(&quot;project://database/Assets/_Project/Art/UI/Icone%20ITEMS%20&amp;%20Actions/save.png?fileID=2800000&amp;guid=9c0a7494e3d69e54abce8ebda13bfb70&amp;type=3#save&quot;); background-color: rgba(127, 255, 122, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                </ui:Button>
                <ui:Button name="btn-exit" tooltip="Esci" class="cbb-sys-btn cbb-sys-btn-exit" style="border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgba(119, 56, 55, 0.4); border-right-color: rgba(119, 56, 55, 0.4); border-top-color: rgba(119, 56, 55, 0.4); border-bottom-color: rgba(119, 56, 55, 0.4);">
                    <ui:VisualElement name="sys-icon-exit" picking-mode="Ignore" class="cbb-sys-icon" style="background-image: url(&quot;project://database/Assets/_Project/Art/UI/Icone%20ITEMS%20&amp;%20Actions/off.png?fileID=2800000&amp;guid=2f9a974c8988f1d4d9142fe659b8c6f4&amp;type=3#off&quot;); background-color: rgba(211, 95, 95, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="glow-frame-top" picking-mode="Ignore" class="cbb-glow-top" style="background-color: rgba(93, 182, 227, 0.5);" />
        </ui:VisualElement>
        <ui:VisualElement name="cry-tooltip" picking-mode="Ignore" class="cbb-tooltip cbb-cry-tooltip" style="display: flex; border-left-color: rgb(91, 176, 217); border-right-color: rgb(91, 176, 217); border-top-color: rgb(91, 176, 217); border-bottom-color: rgb(91, 176, 217); background-image: url(&quot;project://database/Assets/_Project/Art/Crt_background_tooltip_blue.png?fileID=2800000&amp;guid=5f043c9698e91da4680916e1badfc0ac&amp;type=3#Crt_background_tooltip_blue&quot;);">
            <ui:VisualElement class="cbb-cry-title-row">
                <ui:VisualElement picking-mode="Ignore" class="cbb-cry-title-icon" style="background-image: url(&quot;project://database/Assets/_Project/Art/UI/Icone%20ITEMS%20&amp;%20Actions/Icona_Cry.png?fileID=21300000&amp;guid=23e3fafbaad31674c881fafffbd6637e&amp;type=3#Icona_Cry&quot;); height: 16px; width: 17px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgba(93, 182, 227, 0);" />
                <ui:Label name="cry-tooltip-title" text="CRY - VAULT CURRENCY" class="cbb-cry-title" style="font-size: 13px;" />
            </ui:VisualElement>
            <ui:VisualElement name="cry-tooltip-sep" class="cbb-cry-sep" />
            <ui:VisualElement name="cry-tooltip-section-stack" class="cbb-cry-section-stack">
                <ui:VisualElement name="cry-tooltip-row-balance" class="cbb-cry-row cbb-cry-outline-balance">
                    <ui:Label text="SALDO ATTUALE" class="cbb-cry-key" style="color: rgb(91, 176, 217); font-size: 12px;" />
                    <ui:Label name="cry-balance-value" text="2 350 CRY" class="cbb-cry-value cbb-cry-balance-num" style="color: rgb(91, 176, 217);" />
                </ui:VisualElement>
                <ui:VisualElement class="cbb-cry-outline-cycle" style="background-color: rgb(26, 26, 37);">
                    <ui:Label text="RIEPILOGO CICLO" class="cbb-cry-label" style="color: rgb(91, 176, 217); font-size: 12px;" />
                    <ui:VisualElement name="cry-tooltip-row-earned" class="cbb-cry-row">
                        <ui:Label text="Guadagnato oggi" class="cbb-cry-key" style="font-size: 11px;" />
                        <ui:Label name="cry-earned-today" text="+240 CRY" class="cbb-cry-value cbb-cry-green" />
                    </ui:VisualElement>
                    <ui:VisualElement name="cry-tooltip-row-spent" class="cbb-cry-row">
                        <ui:Label text="Speso oggi" class="cbb-cry-key" style="font-size: 11px;" />
                        <ui:Label name="cry-spent-today" text="-80 CRY" class="cbb-cry-value cbb-cry-red" />
                    </ui:VisualElement>
                    <ui:VisualElement name="cry-tooltip-row-net" class="cbb-cry-row">
                        <ui:Label text="Netto oggi" class="cbb-cry-key" style="font-size: 11px;" />
                        <ui:Label name="cry-net-today" text="+160 CRY" class="cbb-cry-value cbb-cry-green" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="cbb-cry-ph-section" style="border-left-color: rgba(80, 200, 220, 0.45); border-right-color: rgba(80, 200, 220, 0.45); border-top-color: rgba(80, 200, 220, 0.45); border-bottom-color: rgba(80, 200, 220, 0.45);">
                <ui:Label text="DETTAGLIO PLH" class="cbb-cry-section-header" style="color: rgb(91, 176, 217); font-size: 12px;" />
                <ui:VisualElement name="cry-tooltip-row-maint" class="cbb-cry-row">
                    <ui:Label text="Manutenzione Dome — PLH" class="cbb-cry-key" style="font-size: 11px;" />
                    <ui:Label text="-120 CRY" class="cbb-cry-value cbb-cry-plh" style="font-size: 12px;" />
                </ui:VisualElement>
                <ui:VisualElement name="cry-tooltip-row-sales" class="cbb-cry-row">
                    <ui:Label text="Vendite piante — PLH" class="cbb-cry-key" style="font-size: 11px;" />
                    <ui:Label text="+200 CRY" class="cbb-cry-value cbb-cry-plh" style="font-size: 12px;" />
                </ui:VisualElement>
                <ui:VisualElement name="cry-tooltip-row-reagents" class="cbb-cry-row">
                    <ui:Label text="Acquisti reagenti — PLH" class="cbb-cry-key" style="font-size: 11px;" />
                    <ui:Label text="-50 CRY" class="cbb-cry-value cbb-cry-plh" style="font-size: 12px;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="cbb-cry-ph-section cbb-cry-ph-section-accent">
                <ui:Label text="PREVISIONE DOMANI" class="cbb-cry-section-header-accent" style="font-size: 12px;" />
                <ui:VisualElement name="cry-tooltip-row-forecast" class="cbb-cry-row">
                    <ui:Label text="Entrate stimate — PLH" class="cbb-cry-key" style="font-size: 11px;" />
                    <ui:Label text="+100 CRY" class="cbb-cry-value cbb-cry-plh" style="font-size: 12px;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="cbb-cry-ph-section-tip" style="border-left-color: rgb(224, 174, 102); border-right-color: rgb(224, 174, 102); border-top-color: rgb(224, 174, 102); border-bottom-color: rgb(224, 174, 102);">
                <ui:Label text="SUGGERIMENTO" class="cbb-cry-tip-header" style="font-size: 12px;" />
                <ui:Label name="cry-tooltip-tip" text="Monitora il netto giornaliero per bilanciare costi e ricavi CRY." class="cbb-cry-tip-value" style="color: rgb(202, 157, 95); font-size: 11px;" />
            </ui:VisualElement>
            <ui:VisualElement name="cry-tooltip-crt-refresh" picking-mode="Ignore" class="cbb-cry-crt-refresh" style="height: 6px;" />
            <ui:VisualElement name="cry-tooltip-crt-refresh-2" picking-mode="Ignore" class="cbb-cry-crt-refresh cbb-cry-crt-refresh-2" />
            <ui:VisualElement name="cry-tooltip-crt-refresh-3" picking-mode="Ignore" class="cbb-cry-crt-refresh cbb-cry-crt-refresh-3" style="height: 22px;" />
        </ui:VisualElement>
        <ui:VisualElement name="room-tooltip" class="cbb-tooltip cbb-room-tooltip" style="display: flex;">
            <ui:Label name="room-tooltip-name" text="DOME — Serra principale" class="cbb-tooltip-title" />
            <ui:Label name="room-tooltip-floor" text="Piano interrato · Settore A" class="cbb-tooltip-floor" />
            <ui:VisualElement name="room-tooltip-sep" class="cbb-tooltip-sep" />
            <ui:Label name="room-tooltip-desc" text="Esempio: area coltivazione e monitoraggio pH." class="cbb-tooltip-desc" />
        </ui:VisualElement>
        <ui:VisualElement name="collection-detail-overlay" class="cbb-collection-detail-overlay" style="display: none;" />
    </ui:VisualElement>
</ui:UXML>
