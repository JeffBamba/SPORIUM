                <ui:Label name="mutation-tooltip-increases" enable-rich-text="true" text="▲ Aumenta con: stress ambientale, muffa, esperimenti genetici, specie Evil attive (es. Glasscap in vaso)." class="ph-tooltip-value" style="white-space: normal; font-size: 10px; color: rgb(199, 202, 199); margin-left: 15px;" />
            </ui:VisualElement>
