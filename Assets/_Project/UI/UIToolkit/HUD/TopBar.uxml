            </ui:VisualElement>
            <ui:VisualElement name="mutation-tooltip-section-tier" class="ph-tooltip-section" style="flex-direction: column; margin-bottom: 4px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgba(217, 70, 239, 0.4); border-right-color: rgba(217, 70, 239, 0.4); border-bottom-color: rgba(217, 70, 239, 0.4); border-left-color: rgba(217, 70, 239, 0.4); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; padding: 4px; background-color: rgb(18, 10, 22);">
                <ui:Label name="mutation-tooltip-para-stable" class="mutation-tooltip-paragraph mutation-tooltip-copy-stable" text="IM basso: predomina la stabilità e le linee Pure restano più prevedibili. Meno mutazioni spontanee." style="white-space: normal; font-size: 11px; margin-bottom: 4px;" />
                <ui:Label name="mutation-tooltip-para-balanced" class="mutation-tooltip-paragraph mutation-tooltip-copy-warn" text="IM medio: equilibrio biologico tra ordine e variabilità. Possibili cambiamenti graduali." style="white-space: normal; font-size: 11px; margin-bottom: 4px;" />
                <ui:Label name="mutation-tooltip-para-high" class="mutation-tooltip-paragraph mutation-tooltip-copy-high" text="IM alto: cresce la probabilità di mutazioni spontanee e tratti inediti. Maggiore imprevedibilità — e opportunità." style="white-space: normal; font-size: 11px;" />
            </ui:VisualElement>
