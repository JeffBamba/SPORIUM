        <ui:VisualElement name="mutation-tooltip" picking-mode="Ignore" class="sp-tooltip mutation-tooltip-root ph-tooltip-crt hud-tooltip-host" style="position: absolute; display: none; background-color: rgba(0, 0, 0, 0.9); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-color: rgb(217, 70, 239); border-right-color: rgb(217, 70, 239); border-bottom-color: rgb(217, 70, 239); border-left-color: rgb(217, 70, 239); padding: 8px; width: 480px; max-width: 480px; min-height: 100px; flex-direction: column; top: 144px; left: 896px; background-image: url(&quot;project://database/Assets/_Project/Art/Crt_background_tooltip.png?fileID=2800000&amp;guid=b58ac99e855e3734b9992a506121e302&amp;type=3#Crt_background_tooltip&quot;); overflow: hidden;">
