/* BottomNavigation - Main Container */
.bottom-nav {
    width: 100%;
    height: 132px;
    min-height: 132px;
    max-height: 132px;
    /* E: deve matchare la TopBar */
    background-color: rgba(30, 40, 42, 0.9);
    border-top-width: 4px;
    border-top-color: rgba(127, 255, 122, 0.6);
    padding-left: 32px;
    padding-right: 32px;
    /* Più spazio utile interno per evitare taglio testi nei bottoni */
    padding-top: 14px;
    padding-bottom: 14px;
    position: absolute;
    bottom: 0px;
    left: 0px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: visible;
    box-shadow: 0 0 24px rgba(127, 255, 122, 0.84);
}

/* TODO: Glow effects (box-shadow triple-layer) - implementazione futura via Outline component o shader */

.glow-frame {
    position: absolute;
    left: 0px;
    right: 0px;
    top: 0px;
    bottom: 0px;
    background-color: rgba(0, 0, 0, 0);
    picking-mode: ignore;
}

.glow-frame-top {
    bottom: auto;
    height: 24px;
    top: -12px;
}

/* Scanline Overlay */
.scan-line-top {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0px;
    left: 0px;
    /* Match TopBar look: overlay scuro (la TopBar lo forza via UXML) */
    background-color: rgba(30, 40, 42, 0.1);
    /* Match TopBar */
    opacity: 0.1;
    /* Note: repeating-linear-gradient not fully supported, using background-color as fallback */
}

/* Navigation Content */
.bottom-nav-content {
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* Room Button Base */
.room-button {
    width: 176px;
    /* Più spazio per label + floor senza clipping */
    height: 100px;
    min-width: 176px;
    min-height: 100px;
    /* A: border più spesso come la ref */
    border-width: 3px;
    /* Glow (simulato) - di default off */
    outline-width: 0px;
    outline-offset: 0px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 10px;
    flex-direction: column;
    align-items: center;
    /* D: layout come ref (stack dall'alto, non centrato) */
    justify-content: flex-start;
    margin-right: 12px; /* Spacing tra bottoni (sostituisce gap) */
    /* Transition handled via C# for scale animation */
}

/* Note: :last-child pseudo-class not supported in UI Toolkit USS - margin-right extra on last button is acceptable */

/* Room Button States */
.room-active {
    border-color: rgb(127, 255, 122);
    /* B: bordo "più spesso" senza rubare spazio al contenuto: usa outline */
    outline-width: 3px;
    outline-color: rgba(127, 255, 122, 0.35);
    outline-offset: 2px;
    /* C: non "fill totale" verde: scuro con tinta verde tipo glow */
    background-color: rgba(17, 34, 26, 0.92);
    box-shadow: 0 0 20px rgba(127, 255, 122, 0.70);
}

.room-available {
    border-color: rgba(127, 255, 122, 0.4);
    background-color: rgba(0, 0, 0, 0.45);
}

.room-locked {
    border-color: rgba(211, 95, 95, 0.4);
    background-color: rgba(0, 0, 0, 0.45);
    opacity: 0.6;
}

/* Room Label */
.room-label {
    font-size: 14px;
    color: rgb(192, 200, 197);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    /* D: spacing più simile alla ref, senza tagliare il floor */
    margin-bottom: 2px; /* Spacing (sostituisce gap) */
    /* Note: text-transform and font-family not supported in USS */
}

.room-active .room-label {
    color: rgb(127, 255, 122);
    text-shadow: 0 0 14px rgba(127, 255, 122, 1.0);
    -unity-text-outline-width: 1.2px;
    -unity-text-outline-color: rgba(127, 255, 122, 1.0);
}

.room-locked .room-label {
    color: rgb(211, 95, 95);
}

/* Room Floor Subtext */
.room-floor {
    font-size: 11px;
    color: rgba(127, 255, 122, 0.6);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin-top: 0px;
    margin-bottom: 0px;
    /* Note: text-transform and font-family not supported in USS */
}

.room-active .room-floor {
    color: rgba(127, 255, 122, 0.8);
    text-shadow: 0 0 14px rgba(127, 255, 122, 1.0);
    -unity-text-outline-width: 1.2px;
    -unity-text-outline-color: rgba(127, 255, 122, 1.0);
}

.room-locked .room-floor {
    color: rgba(211, 95, 95, 0.6);
}

/* Icon Placeholders in Room Buttons */
.room-button .icon-placeholder {
    width: 28px;
    height: 28px;
    min-width: 28px;
    min-height: 28px;
    /* A: border icona più spesso come la ref */
    border-width: 3px;
    border-color: rgb(192, 200, 197);
    background-color: rgba(192, 200, 197, 0.1);
    align-items: center;
    justify-content: center;
    font-size: 14px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    /* D: distanza icona -> testo (ref) */
    margin-bottom: 6px;
}

.room-active .icon-placeholder {
    border-color: rgb(127, 255, 122);
    background-color: rgba(127, 255, 122, 0.1);
    box-shadow: 0 0 16px rgba(127, 255, 122, 1.0);
}

.room-locked .icon-placeholder {
    border-color: rgb(211, 95, 95);
    background-color: rgba(211, 95, 95, 0.1);
    /* TODO: Add glow effect drop-shadow(0 0 4px #D35F5F) */
}

/* Pixel Corners */
.pixel-corner {
    width: 3px;
    height: 3px;
    position: absolute;
    background-color: rgb(127, 255, 122);
    box-shadow: 0 0 12px rgba(127, 255, 122, 1.0);
}

.corner-top-left {
    top: 0px;
    left: 0px;
    border-right-width: 0px;
    border-bottom-width: 0px;
    border-left-width: 2px;
    border-top-width: 2px;
    border-top-color: rgb(127, 255, 122);
    border-left-color: rgb(127, 255, 122);
}

.corner-top-right {
    top: 0px;
    right: 0px;
    border-left-width: 0px;
    border-bottom-width: 0px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-top-color: rgb(127, 255, 122);
    border-right-color: rgb(127, 255, 122);
}

.corner-bottom-left {
    bottom: 0px;
    left: 0px;
    border-right-width: 0px;
    border-top-width: 0px;
    border-left-width: 2px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(127, 255, 122);
    border-left-color: rgb(127, 255, 122);
}

.corner-bottom-right {
    bottom: 0px;
    right: 0px;
    border-left-width: 0px;
    border-top-width: 0px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(127, 255, 122);
    border-right-color: rgb(127, 255, 122);
}

/* Hover Effects (handled via C# for scale animation) */
/* .room-available:hover - border → #7FFF7A 70%, background → #7FFF7A 10%, scale 1.05 */

