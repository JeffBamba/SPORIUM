/* Lab Catalizzatore Panel — Foundation-style (UIToolkit) */

.lab-cat-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.lab-cat-panel {
    width: 420px;
    background-color: rgba(10, 18, 22, 0.96);
    border-width: 2px;
    border-color: rgb(93, 182, 227);
    padding: 18px;
    flex-direction: column;
    position: relative;
}

.lab-cat-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.lab-cat-title {
    font-size: 14px;
    letter-spacing: 2px;
    color: rgb(93, 182, 227);
    text-shadow: 0 0 8px rgb(93, 182, 227);
    -unity-font-style: bold;
}

.lab-cat-close {
    width: 28px;
    height: 24px;
    border-width: 1px;
    border-color: rgba(93, 182, 227, 0.5);
    background-color: rgba(0, 0, 0, 0.2);
}

.lab-cat-close:hover {
    background-color: rgba(93, 182, 227, 0.15);
}

.lab-cat-close-x {
    -unity-text-align: middle-center;
    font-size: 16px;
    color: rgba(231, 244, 255, 0.9);
}

.lab-cat-body {
    flex-direction: column;
    gap: 14px;
}

.lab-cat-status {
    font-size: 12px;
    letter-spacing: 1px;
    color: rgba(192, 200, 197, 0.9);
}

.lab-cat-operation-label {
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(230, 201, 111);
    -unity-font-style: bold;
}

.lab-cat-row {
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

.lab-cat-label {
    width: 140px;
    font-size: 11px;
    letter-spacing: 1px;
    color: rgba(192, 200, 197, 0.8);
}

.lab-cat-slot {
    flex-grow: 1;
    height: 36px;
    padding: 6px 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    background-color: rgb(18, 28, 33);
    align-items: center;
}

.lab-cat-slot-text {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.9);
}

.lab-cat-btn {
    min-width: 70px;
    height: 32px;
    font-size: 11px;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: rgba(93, 182, 227, 0.6);
    background-color: rgba(93, 182, 227, 0.15);
    color: rgb(93, 182, 227);
}

.lab-cat-btn:hover {
    background-color: rgba(93, 182, 227, 0.25);
}

.lab-cat-btn-avvia {
    height: 44px;
    font-size: 13px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
    border-width: 2px;
    border-color: rgb(93, 182, 227);
    background-color: rgba(93, 182, 227, 0.12);
    color: rgb(93, 182, 227);
}

.lab-cat-btn-avvia:hover {
    background-color: rgba(93, 182, 227, 0.22);
}

.lab-cat-btn-avvia:disabled {
    opacity: 0.4;
}
