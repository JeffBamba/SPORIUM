/* Lab Incubator Panel — Foundation-style (UIToolkit) */

.lab-inc-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.lab-inc-panel {
    width: 420px;
    background-color: rgba(10, 18, 22, 0.96);
    border-width: 2px;
    border-color: rgb(230, 201, 111);
    padding: 18px;
    flex-direction: column;
    position: relative;
}

.lab-inc-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.lab-inc-title {
    font-size: 14px;
    letter-spacing: 2px;
    color: rgb(230, 201, 111);
    text-shadow: 0 0 8px rgb(230, 201, 111);
    -unity-font-style: bold;
}

.lab-inc-close {
    width: 28px;
    height: 24px;
    border-width: 1px;
    border-color: rgba(230, 201, 111, 0.5);
    background-color: rgba(0, 0, 0, 0.2);
}

.lab-inc-close:hover {
    background-color: rgba(230, 201, 111, 0.15);
}

.lab-inc-close-x {
    -unity-text-align: middle-center;
    font-size: 16px;
    color: rgba(231, 244, 255, 0.9);
}

.lab-inc-desc {
    font-size: 11px;
    color: rgba(192, 200, 197, 0.85);
    margin-bottom: 12px;
    white-space: normal;
    max-width: 100%;
}

.lab-inc-reagent-desc {
    font-size: 10px;
    color: rgba(192, 200, 197, 0.7);
    margin-top: 4px;
    white-space: normal;
}

.lab-inc-reagent-row {
    flex-direction: column;
}

.lab-inc-reagent-row > * {
    margin-bottom: 2px;
}

.lab-inc-reagent-row > *:last-child {
    margin-bottom: 0;
}

.lab-inc-x-config-row {
    flex-direction: column;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(230, 201, 111, 0.22);
}

.lab-inc-x-config-row > * {
    margin-bottom: 3px;
}

.lab-inc-x-config-row > *:last-child {
    margin-bottom: 0;
}

.lab-inc-x-title {
    width: auto;
    color: rgba(230, 201, 111, 0.92);
}

.lab-inc-x-grid {
    flex-direction: column;
}

.lab-inc-x-grid > * {
    margin-bottom: 2px;
}

.lab-inc-x-grid > *:last-child {
    margin-bottom: 0;
}

.lab-inc-x-label {
    font-size: 10px;
    color: rgba(192, 200, 197, 0.82);
}

.lab-inc-x-dropdown {
    height: 30px;
    border-width: 1px;
    border-color: rgba(230, 201, 111, 0.5);
    background-color: rgba(16, 24, 29, 0.95);
    color: rgba(255, 255, 255, 0.92);
}

.lab-inc-reagent-slot-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.lab-inc-reagent-slot-row > * {
    margin-right: 5px;
}

.lab-inc-reagent-slot-row > *:last-child {
    margin-right: 0;
}

.lab-inc-body {
    flex-direction: column;
}

.lab-inc-body > * {
    margin-bottom: 7px;
}

.lab-inc-body > *:last-child {
    margin-bottom: 0;
}

.lab-inc-row {
    flex-direction: row;
    align-items: center;
}

.lab-inc-row > * {
    margin-right: 5px;
}

.lab-inc-row > *:last-child {
    margin-right: 0;
}

.lab-inc-label {
    width: 100px;
    font-size: 11px;
    letter-spacing: 1px;
    color: rgba(192, 200, 197, 0.8);
}

.lab-inc-slot {
    flex-grow: 1;
    height: 36px;
    padding: 6px 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    background-color: rgb(18, 28, 33);
    align-items: center;
}

.lab-inc-slot-text {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.9);
}

.lab-inc-reagent-buttons {
    flex-direction: row;
}

.lab-inc-reagent-buttons > * {
    margin-right: 4px;
}

.lab-inc-reagent-buttons > *:last-child {
    margin-right: 0;
}

.lab-inc-reagent-btn {
    min-width: 60px;
    height: 32px;
    font-size: 11px;
    border-width: 1px;
    border-color: rgba(230, 201, 111, 0.5);
    background-color: rgba(230, 201, 111, 0.1);
    color: rgb(230, 201, 111);
}

.lab-inc-reagent-btn:hover {
    background-color: rgba(230, 201, 111, 0.2);
}

.lab-inc-reagent-btn:active {
    background-color: rgba(230, 201, 111, 0.3);
}

.lab-inc-reagent-btn.lab-inc-reagent-selected {
    border-width: 2px;
    border-color: rgb(230, 201, 111);
    background-color: rgba(230, 201, 111, 0.25);
}

.lab-inc-btn {
    min-width: 70px;
    height: 32px;
    font-size: 11px;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: rgba(230, 201, 111, 0.6);
    background-color: rgba(230, 201, 111, 0.15);
    color: rgb(230, 201, 111);
}

.lab-inc-btn:hover {
    background-color: rgba(230, 201, 111, 0.25);
}

.lab-inc-btn-avvia {
    height: 44px;
    font-size: 13px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
    border-width: 2px;
    border-color: rgb(230, 201, 111);
    background-color: rgba(230, 201, 111, 0.12);
    color: rgb(230, 201, 111);
}

.lab-inc-btn-avvia:hover {
    background-color: rgba(230, 201, 111, 0.22);
}

.lab-inc-btn-avvia:disabled {
    opacity: 0.4;
}
