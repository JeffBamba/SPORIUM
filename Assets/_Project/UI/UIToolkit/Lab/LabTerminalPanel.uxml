<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/UIToolkit/Lab/LabTerminalPanel.uss?fileID=7433441132597879392&amp;guid=9ec05017512b7f44d8a24d5481f451f8&amp;type=3#LabTerminalPanel" />
    <ui:VisualElement name="lab-terminal-overlay" class="lab-terminal-overlay">
        <ui:VisualElement name="lab40-screen1" class="lab40-s1-panel">
        <ui:VisualElement class="lab40-s1-header-bar">
            <ui:VisualElement class="lab40-s1-header-icon-box">
                <ui:Label text="✦" class="lab40-s1-header-icon" />
            </ui:VisualElement>
            <ui:VisualElement class="lab40-s1-header-text-col">
                <ui:Label text="PROTOCOLLO LAB — GENOSCRITTORE" class="lab40-s1-header-title" />
                <ui:Label text="Orientamento biologico preliminare" class="lab40-s1-header-sub" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="lab40-s1-body">
            <ui:VisualElement class="lab40-s1-left">
                <ui:Label text="MODULO" class="lab40-s1-module-tag" />
                <ui:Label text="GENOSCRITTORE" class="lab40-s1-module-title" />
                <ui:VisualElement class="lab40-s1-seed-icon-box">
                    <ui:Label text="⬡" class="lab40-s1-seed-icon-placeholder" />
                </ui:VisualElement>
                <ui:Label name="lab40-s1-seed-label" text="VAULT-SEED 7A" class="lab40-s1-seed-label" />
                <ui:VisualElement class="lab40-s1-knowledge-block">
                    <ui:Label text="CONOSCENZA" class="lab40-s1-know-caption" />
                    <ui:Label text="LIVELLO" class="lab40-s1-know-caption" />
                    <ui:VisualElement class="lab40-s1-know-bar-track">
                        <ui:VisualElement name="lab40-s1-know-bar-fill" class="lab40-s1-know-bar-fill" />
                    </ui:VisualElement>
                    <ui:Label name="lab40-s1-know-score" text="7 / 10" class="lab40-s1-know-score" />
                </ui:VisualElement>
                <ui:Label text="⬡" class="lab40-s1-dna-placeholder" />
                <ui:VisualElement class="lab40-s1-registry-block">
                    <ui:Label text="REGISTRO PROTOCOLLI" class="lab40-s1-registry-label" />
                    <ui:Label name="lab40-s1-registry-status" text="ATTIVO ●" class="lab40-s1-registry-status" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="lab40-s1-center">
                <ui:VisualElement class="lab40-s1-concept-row">
                    <ui:VisualElement class="lab40-s1-concept-icon-box">
                        <ui:Label text="⊕" class="lab40-s1-concept-icon" />
                    </ui:VisualElement>
                    <ui:VisualElement class="lab40-s1-concept-body">
                        <ui:Label text="1. INTENZIONE" class="lab40-s1-concept-title" />
                        <ui:Label text="Ogni progetto seme nasce da una linea biologica, una famiglia, una mutazione genetica, un profilo pH e due poteri. Il protocollo non garantisce il risultato: lo orienta." class="lab40-s1-concept-desc" />
                    </ui:VisualElement>
                    <ui:VisualElement class="lab40-s1-concept-quote-box">
                        <ui:Label text="&quot;Un seme non esegue ordini. Risponde a pressioni.&quot;" class="lab40-s1-concept-quote" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="lab40-s1-concept-row">
                    <ui:VisualElement class="lab40-s1-concept-icon-box">
                        <ui:Label text="⬡⬡" class="lab40-s1-concept-icon" />
                    </ui:VisualElement>
                    <ui:VisualElement class="lab40-s1-concept-body">
                        <ui:Label text="2. PUNTI" class="lab40-s1-concept-title" />
                        <ui:Label text="I punti rappresentano focus di laboratorio. Più punti assegni a una voce, più il sistema tenterà di rispettarla. Zero punti significa variabilità intenzionale, non errore." class="lab40-s1-concept-desc" />
                    </ui:VisualElement>
                    <ui:VisualElement class="lab40-s1-concept-quote-box">
                        <ui:Label text="&quot;Ogni punto inserito aumenta la forza del vincolo.&quot;" class="lab40-s1-concept-quote" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="lab40-s1-concept-row">
                    <ui:VisualElement class="lab40-s1-concept-icon-box">
                        <ui:Label text="✦" class="lab40-s1-concept-icon" />
                    </ui:VisualElement>
                    <ui:VisualElement class="lab40-s1-concept-body">
                        <ui:Label text="3. POTERI" class="lab40-s1-concept-title" />
                        <ui:Label text="Il potere attivo e il potere passivo sono scelte separate. Entrambi influenzano il comportamento futuro della pianta nel Dome. Guidarli costa punti." class="lab40-s1-concept-desc" />
                    </ui:VisualElement>
                    <ui:VisualElement class="lab40-s1-concept-quote-box">
                        <ui:Label text="&quot;Le voci non marcate restano aperte alla deriva biologica.&quot;" class="lab40-s1-concept-quote" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="lab40-s1-concept-row">
                    <ui:VisualElement class="lab40-s1-concept-icon-box">
                        <ui:Label text="∿" class="lab40-s1-concept-icon" />
                    </ui:VisualElement>
                    <ui:VisualElement class="lab40-s1-concept-body">
                        <ui:Label text="4. FORECAST" class="lab40-s1-concept-title" />
                        <ui:Label text="Il forecast è una previsione del mix. Non è una promessa. Conoscenza, reagente e distribuzione punti migliorano la lettura del progetto." class="lab40-s1-concept-desc" />
                    </ui:VisualElement>
                    <ui:VisualElement class="lab40-s1-concept-quote-box">
                        <ui:Label text="&quot;Il forecast indica una lettura, non un contratto.&quot;" class="lab40-s1-concept-quote" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="lab40-s1-bottom-row">
                    <ui:VisualElement class="lab40-s1-legend-row">
                        <ui:Label text="⬡ punti = vincolo" class="lab40-s1-legend-item" />
                        <ui:Label text="○ zero punti = deriva" class="lab40-s1-legend-item" />
                        <ui:Label text="∿ forecast = lettura" class="lab40-s1-legend-item" />
                    </ui:VisualElement>
                    <ui:VisualElement class="lab40-s1-stamp-box">
                        <ui:Label text="PROTOCOLLO NON DETERMINISTICO" class="lab40-s1-stamp-label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="lab40-s1-right">
                <ui:Label text="SEQUENZA OPERATIVA" class="lab40-s1-seq-title" />
                <ui:VisualElement class="lab40-s1-seq-step lab40-s1-seq-step-active">
                    <ui:VisualElement class="lab40-s1-seq-icon-box">
                        <ui:Label text="▣" class="lab40-s1-seq-icon" />
                    </ui:VisualElement>
                    <ui:Label text="1. PROTOCOLLO" class="lab40-s1-seq-label lab40-s1-seq-label-active" />
                </ui:VisualElement>
                <ui:Label text="↓" class="lab40-s1-seq-arrow" />
                <ui:VisualElement class="lab40-s1-seq-step">
                    <ui:VisualElement class="lab40-s1-seq-icon-box lab40-s1-seq-icon-box-dim">
                        <ui:Label text="⬡" class="lab40-s1-seq-icon lab40-s1-seq-icon-dim" />
                    </ui:VisualElement>
                    <ui:Label text="2. PROGETTAZIONE SEME" class="lab40-s1-seq-label" />
                </ui:VisualElement>
                <ui:Label text="↓" class="lab40-s1-seq-arrow" />
                <ui:VisualElement class="lab40-s1-seq-step">
                    <ui:VisualElement class="lab40-s1-seq-icon-box lab40-s1-seq-icon-box-dim">
                        <ui:Label text="⊛" class="lab40-s1-seq-icon lab40-s1-seq-icon-dim" />
                    </ui:VisualElement>
                    <ui:Label text="3. SIGILLA PROTOCOLLO" class="lab40-s1-seq-label" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="lab40-s1-footer">
            <ui:VisualElement class="lab40-s1-vo-block">
                <ui:VisualElement class="lab40-s1-vo-avatar-box">
                    <ui:Label text="▶" class="lab40-s1-vo-avatar-icon" />
                </ui:VisualElement>
                <ui:VisualElement class="lab40-s1-vo-text-block">
                    <ui:Label text="VO" class="lab40-s1-vo-tag" />
                    <ui:Label name="lab40-s1-vo-text" text="Il protocollo definisce pressioni. Il seme tenterà di seguirle." class="lab40-s1-vo-text" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="lab40-s1-footer-actions">
                <ui:Button name="btn-lab40-screen1-back" text="← INDIETRO" class="lab-terminal-secondary-btn lab40-s1-btn-back" />
                <ui:Button name="btn-lab40-cta-genoscrittore" text="APRI GENOSCRITTORE" class="lab40-s1-btn-cta" />
            </ui:VisualElement>
        </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
