<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/UIToolkit/Lab/LabFusionPanel.uss?fileID=7433441132597879392&amp;guid=9f61a3fb36e44dc4aa526e3da044b0b2&amp;type=3#LabFusionPanel" />
    <ui:VisualElement name="lab-fus-overlay" class="lab-fus-overlay">
        <ui:VisualElement name="lab-fus-panel" class="lab-fus-panel">
            <ui:VisualElement name="lab-fus-header" class="lab-fus-header">
                <ui:Label name="lab-fus-title" text="FUSIONE" class="lab-fus-title" />
                <ui:Button name="btn-close" class="lab-fus-close">
                    <ui:Label text="×" class="lab-fus-close-x" style="margin-top: -4px; right: 2px;" />
                </ui:Button>
            </ui:VisualElement>
            <ui:Label name="lab-fus-desc" text="Banco di lavoro che combina 2 spore maturate in un pre-seme opaco, determinando in modo prevedibile il rischio mutazionale (FIXED/STABLE/UNSTABLE) della linea genetica." class="lab-fus-desc" />
            <ui:VisualElement name="lab-fus-body" class="lab-fus-body">
                <ui:Label text="Inserisci 2 spore mature (obbligatorie)" class="lab-fus-hint" />
                <ui:VisualElement name="lab-fus-slot1-row" class="lab-fus-row">
                    <ui:Label text="Slot 1 — Spora Maturata" class="lab-fus-label" />
                    <ui:VisualElement name="lab-fus-slot1" class="lab-fus-slot">
                        <ui:Label name="lab-fus-slot1-text" text="—" class="lab-fus-slot-text" />
                    </ui:VisualElement>
                    <ui:Button name="btn-select-slot1" text="Seleziona" class="lab-fus-btn" />
                </ui:VisualElement>
                <ui:VisualElement name="lab-fus-slot2-row" class="lab-fus-row">
                    <ui:Label text="Slot 2 — Spora Maturata" class="lab-fus-label" />
                    <ui:VisualElement name="lab-fus-slot2" class="lab-fus-slot">
                        <ui:Label name="lab-fus-slot2-text" text="—" class="lab-fus-slot-text" />
                    </ui:VisualElement>
                    <ui:Button name="btn-select-slot2" text="Seleziona" class="lab-fus-btn" />
                </ui:VisualElement>
                <ui:Label name="lab-fus-progress-text" class="lab-fus-slot-text" style="-unity-text-align: middle-center;" />
                <ui:Button name="btn-fusion" text="AVVIA FUSIONE" class="lab-fus-btn-fusion" />
                <ui:VisualElement name="lab-fus-output-row" class="lab-fus-row">
                    <ui:Label text="Output (Pre-Seed)" class="lab-fus-label" />
                    <ui:VisualElement name="lab-fus-output-slot" class="lab-fus-slot">
                        <ui:Label name="lab-fus-output-text" text="—" class="lab-fus-slot-text" />
                    </ui:VisualElement>
                    <ui:Button name="btn-ritira" text="Ritira" class="lab-fus-btn" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="lab-fus-output-tooltip" class="sp-tooltip" style="position: absolute; display: none; background-color: rgba(13, 18, 23, 0.96); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-color: rgba(127, 204, 127, 0.9); border-right-color: rgba(127, 204, 127, 0.9); border-bottom-color: rgba(127, 204, 127, 0.9); border-left-color: rgba(127, 204, 127, 0.9); padding: 10px; min-width: 260px; max-width: 340px; flex-direction: column;">
            <ui:Label name="lab-fus-output-tooltip-text" enable-rich-text="true" class="sp-tooltip-text" style="white-space: normal; color: rgb(242, 245, 250); font-size: 13px; -unity-text-align: upper-left;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
