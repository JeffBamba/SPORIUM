<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/UIToolkit/Lab/LabCatalizzatorePanel.uss?fileID=7433441132597879392&amp;guid=f0a4cf6f45e77c442b95dca5e164eb78&amp;type=3#LabCatalizzatorePanel" />
    <ui:VisualElement name="lab-cat-overlay" class="lab-cat-overlay">
        <ui:VisualElement name="lab-cat-panel" class="lab-cat-panel">
            <ui:VisualElement name="lab-cat-header" class="lab-cat-header">
                <ui:Label name="lab-cat-title" text="CATALIZZATORE" class="lab-cat-title" />
                <ui:Button name="btn-close" class="lab-cat-close">
                    <ui:Label text="×" class="lab-cat-close-x" style="margin-top: -4px; right: 1px;" />
                </ui:Button>
            </ui:VisualElement>
            <ui:Label name="lab-cat-desc" text="Macchinario di maturazione temporale che processa spore grezze in 2 giorni per renderle combinabili nella fusione genetica." class="lab-cat-desc" />
            <ui:VisualElement name="lab-cat-body" class="lab-cat-body">
                <ui:Label name="lab-cat-status" text="—" class="lab-cat-status" />
                <ui:Label name="lab-cat-operation-label" text="Operazione in corso" class="lab-cat-operation-label" />
                <ui:VisualElement name="lab-cat-input-row" class="lab-cat-row">
                    <ui:Label text="Input (spora Raw)" class="lab-cat-label" />
                    <ui:VisualElement name="lab-cat-input-slot" class="lab-cat-slot">
                        <ui:Label name="lab-cat-input-text" text="—" class="lab-cat-slot-text" />
                    </ui:VisualElement>
                    <ui:Button name="btn-select-input" text="Seleziona" class="lab-cat-btn" />
                </ui:VisualElement>
                <ui:Button name="btn-avvia" text="AVVIA MATURAZIONE" class="lab-cat-btn-avvia" />
                <ui:VisualElement name="lab-cat-output-row" class="lab-cat-row">
                    <ui:Label text="Output (spora maturata)" class="lab-cat-label" />
                    <ui:VisualElement name="lab-cat-output-slot" class="lab-cat-slot">
                        <ui:Label name="lab-cat-output-text" text="—" class="lab-cat-slot-text" />
                    </ui:VisualElement>
                    <ui:Button name="btn-ritira" text="Ritira" class="lab-cat-btn" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="lab-cat-output-tooltip" class="sp-tooltip" style="position: absolute; display: none; background-color: rgba(13, 18, 23, 0.96); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-color: rgba(127, 204, 127, 0.9); border-right-color: rgba(127, 204, 127, 0.9); border-bottom-color: rgba(127, 204, 127, 0.9); border-left-color: rgba(127, 204, 127, 0.9); padding: 10px; min-width: 260px; max-width: 320px; flex-direction: column;">
            <ui:Label name="lab-cat-output-tooltip-text" enable-rich-text="true" class="sp-tooltip-text" style="white-space: normal; color: rgb(242, 245, 250); font-size: 12px; -unity-text-align: upper-left;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
