    background-color: rgba(127, 255, 122, 0.18);
    color: rgb(127, 255, 122);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* ================================================================
   LAB 4.0 — RUNTIME PANEL 1480x900
   ================================================================ */

.lab-terminal-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.16);
}

.lab40-s1-panel {
    width: 1480px;
    height: 900px;
    flex-direction: column;
    background-color: rgba(2, 15, 8, 0.97);
    border-width: 3px;
    border-color: rgba(93, 220, 91, 0.82);
    padding: 28px 36px 24px 36px;
    display: flex;
}

.lab40-s1-header-bar {
    flex-direction: row;
    align-items: flex-start;
    min-height: 74px;
    padding: 0;
    margin-bottom: 10px;
