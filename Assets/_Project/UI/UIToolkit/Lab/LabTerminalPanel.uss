.lab-terminal-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.65);
}

.lab-terminal-panel {
    width: 760px;
    background-color: rgba(8, 15, 19, 0.96);
    border-width: 2px;
    border-color: rgba(127, 255, 122, 0.92);
    padding: 18px;
    flex-direction: column;
}

.lab-terminal-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.lab-terminal-title {
    font-size: 16px;
    letter-spacing: 2px;
    color: rgb(127, 255, 122);
    -unity-font-style: bold;
}

.lab-terminal-close {
    width: 28px;
    height: 24px;
    border-width: 1px;
    border-color: rgba(93, 182, 227, 0.7);
    background-color: rgba(0, 0, 0, 0.2);
}

.lab-terminal-close-x {
    -unity-text-align: middle-center;
    color: rgba(231, 244, 255, 0.95);
    font-size: 16px;
    margin-top: -3px;
}

.lab-terminal-subtitle {
    font-size: 13px;
    color: rgba(190, 205, 197, 0.86);
    white-space: normal;
    margin-bottom: 10px;
}

.lab-terminal-section {
    flex-direction: column;
    margin-top: 10px;
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.25);
    padding: 10px;
}

.lab-terminal-section-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.lab-terminal-section-standalone {
    border-color: rgba(93, 182, 227, 0.55);
    background-color: rgba(9, 16, 23, 0.68);
}

.lab-terminal-section-project {
    border-color: rgba(127, 255, 122, 0.4);
    background-color: rgba(11, 18, 12, 0.56);
}

.lab-terminal-section-title {
    color: rgb(127, 255, 122);
    -unity-font-style: bold;
    font-size: 13px;
    margin-bottom: 8px;
    letter-spacing: 1px;
}

.lab-terminal-section-toggle {
    width: 28px;
    height: 22px;
    margin-bottom: 8px;
    border-width: 1px;
    border-color: rgba(93, 182, 227, 0.65);
    background-color: rgba(93, 182, 227, 0.14);
    color: rgba(194, 233, 255, 1);
    -unity-font-style: bold;
}

.lab-terminal-machines-content {
    flex-direction: column;
}

.lab-terminal-machines-content-collapsed {
    display: none;
}

.lab-terminal-section-hint {
    color: rgba(182, 209, 232, 0.9);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 8px;
}

.lab-terminal-machine-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.lab-terminal-machine-name {
    width: 190px;
    color: rgba(215, 224, 228, 0.95);
    font-size: 13px;
}

.lab-terminal-machine-status {
    flex-grow: 1;
    color: rgba(168, 217, 255, 0.95);
    font-size: 13px;
    -unity-font-style: bold;
}

.lab-terminal-open-btn {
    min-width: 76px;
    height: 30px;
    border-width: 1px;
    border-color: rgba(93, 182, 227, 0.7);
    background-color: rgba(93, 182, 227, 0.14);
    color: rgb(93, 182, 227);
    font-size: 13px;
    -unity-font-style: bold;
}

.lab-terminal-machine-collect-pulse {
    border-color: rgba(201, 140, 255, 1);
}

.lab-terminal-project-status {
    color: rgba(223, 229, 232, 0.95);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 6px;
}

.lab-terminal-analysis-block {
    flex-direction: column;
    border-width: 1px;
    border-color: rgba(125, 168, 196, 0.35);
    background-color: rgba(9, 15, 20, 0.75);
    padding: 8px;
    margin-bottom: 8px;
}

.lab-terminal-analysis-title {
    color: rgba(190, 222, 255, 0.95);
    font-size: 13px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.lab-terminal-analysis-status {
    color: rgba(180, 197, 208, 0.96);
    font-size: 13px;
    white-space: normal;
    margin-top: 2px;
    margin-bottom: 4px;
}

.lab-terminal-analysis-progress-track {
    height: 8px;
    border-width: 1px;
    border-color: rgba(104, 132, 152, 0.8);
    background-color: rgba(20, 28, 34, 0.8);
    margin-bottom: 6px;
}

.lab-terminal-analysis-progress-fill {
    height: 100%;
    width: 0%;
    background-color: rgba(201, 140, 255, 0.95);
}

.lab-terminal-analysis-subtitle {
    color: rgba(171, 198, 218, 0.95);
    font-size: 13px;
    margin-bottom: 4px;
}

.lab-terminal-analysis-options {
    flex-direction: row;
    margin-bottom: 4px;
}

.lab-terminal-project-type-btn {
    min-width: 120px;
    height: 26px;
    margin-right: 4px;
    border-width: 1px;
    border-color: rgba(182, 122, 255, 0.92);
    background-color: rgba(72, 38, 105, 0.92);
    color: rgba(236, 218, 255, 0.98);
    font-size: 13px;
    -unity-font-style: bold;
}

.lab-terminal-project-type-btn-selected {
    border-color: rgba(214, 166, 255, 1);
    background-color: rgba(126, 72, 183, 0.98);
    color: rgba(252, 244, 255, 1);
}

.lab-terminal-project-type-btn-disabled {
    border-color: rgba(102, 113, 124, 0.7);
    background-color: rgba(33, 40, 46, 0.9);
    color: rgba(124, 136, 146, 0.95);
}

.lab-terminal-analysis-option-line {
    color: rgba(166, 183, 195, 0.95);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 2px;
}

.lab-terminal-analysis-selected-title {
    color: rgba(186, 212, 230, 0.95);
    font-size: 13px;
    margin-top: 2px;
    margin-bottom: 2px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.lab-terminal-analysis-schema-line {
    color: rgba(177, 197, 213, 0.96);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 2px;
}

.lab-terminal-analysis-change-warning {
    color: rgba(186, 205, 219, 0.96);
    font-size: 13px;
    white-space: normal;
    margin-top: 2px;
}

.lab-terminal-analysis-fullscreen {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(2, 7, 10, 0.92);
    display: none;
}

.lab-terminal-analysis-fullscreen-card {
    width: 720px;
    max-width: 92%;
    border-width: 2px;
    border-color: rgba(125, 168, 196, 0.62);
    background-color: rgba(8, 15, 20, 0.97);
    padding: 14px;
    flex-direction: column;
}

.lab-terminal-analysis-actions {
    flex-direction: row;
    margin-top: 8px;
}

.lab-terminal-analysis-cancel-btn {
    margin-left: 6px;
    min-width: 140px;
}

.lab-terminal-project-top-row {
    flex-direction: row;
    align-items: flex-start;
}

.lab-terminal-project-main-col {
    flex-grow: 1;
}

.lab-terminal-project-image-placeholder {
    width: 210px;
    min-width: 210px;
    margin-top: 6px;
    margin-left: 8px;
    margin-bottom: 8px;
    border-width: 1px;
    border-color: rgba(125, 168, 196, 0.55);
    background-color: rgba(10, 16, 22, 0.7);
    justify-content: center;
    align-items: center;
    min-height: 170px;
}

.lab-terminal-project-image-placeholder-label {
    font-size: 13px;
    letter-spacing: 1px;
    color: rgba(138, 156, 171, 0.9);
    -unity-font-style: bold;
}

.lab-terminal-project-status-active {
    color: rgba(190, 222, 255, 0.98);
}

.lab-terminal-project-status-complete {
    color: rgba(127, 255, 122, 0.98);
}

.lab-terminal-quick-panel {
    flex-direction: column;
    margin-top: 6px;
    margin-bottom: 8px;
    border-width: 1px;
    border-color: rgba(168, 217, 255, 0.25);
    background-color: rgba(8, 14, 18, 0.7);
    padding: 8px;
}

.lab-terminal-quick-line {
    font-size: 13px;
    color: rgba(214, 224, 232, 0.95);
    white-space: normal;
    margin-bottom: 4px;
}

.lab-terminal-quick-title-static {
    color: rgba(164, 184, 198, 0.92);
    font-size: 13px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.lab-terminal-quick-title-dynamic {
    color: rgba(196, 231, 255, 0.95);
    font-size: 13px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    margin-top: 4px;
    margin-bottom: 2px;
}

.lab-terminal-quick-static {
    color: rgba(156, 168, 178, 0.94);
}

.lab-terminal-quick-dynamic {
    color: rgba(170, 184, 196, 0.96);
}

.lab-terminal-quick-outcome {
    color: rgba(216, 232, 243, 0.98);
    background-color: rgba(20, 34, 45, 0.85);
    border-width: 1px;
    border-color: rgba(146, 205, 244, 0.62);
    padding: 6px;
    margin-top: 4px;
    margin-bottom: 0;
    -unity-font-style: bold;
}

.lab-terminal-actions-row {
    flex-direction: row;
    margin-top: 8px;
    margin-bottom: 8px;
}

.lab-terminal-action-btn {
    margin-right: 6px;
}

.lab-terminal-primary-btn {
    min-width: 180px;
    height: 34px;
    border-width: 2px;
    border-color: rgba(127, 255, 122, 0.95);
    background-color: rgba(127, 255, 122, 0.16);
    color: rgb(127, 255, 122);
    -unity-font-style: bold;
    font-size: 13px;
}

.lab-terminal-secondary-btn {
    min-width: 160px;
    height: 34px;
    border-width: 1px;
    border-color: rgba(93, 182, 227, 0.7);
    background-color: rgba(93, 182, 227, 0.16);
    color: rgba(173, 216, 248, 1);
    font-size: 13px;
}

.lab-terminal-danger-btn {
    border-color: rgba(178, 74, 74, 0.88);
    background-color: rgba(86, 26, 26, 0.78);
    color: rgba(255, 205, 205, 0.95);
}

.lab-terminal-guidance-pulse {
    border-color: rgba(201, 140, 255, 1);
}

.lab-terminal-project-board {
    flex-direction: column;
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.35);
    background-color: rgba(4, 10, 12, 0.7);
    padding: 8px;
}

.lab-terminal-board-title {
    color: rgb(127, 255, 122);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.lab-terminal-board-legend {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.lab-terminal-legend-title {
    font-size: 13px;
    color: rgba(177, 192, 203, 0.95);
    -unity-font-style: bold;
    margin-right: 8px;
}

.lab-terminal-legend-item {
    font-size: 13px;
    -unity-font-style: bold;
    margin-right: 8px;
}

.lab-terminal-legend-inprogress {
    color: rgba(201, 140, 255, 1);
}

.lab-terminal-legend-completed {
    color: rgba(127, 255, 122, 1);
}

.lab-terminal-legend-todo {
    color: rgba(160, 230, 255, 1);
}

.lab-terminal-legend-blocked {
    color: rgba(114, 126, 138, 0.96);
}

.lab-terminal-step-label {
    font-size: 13px;
    color: rgba(226, 233, 238, 0.95);
    margin-bottom: 2px;
    -unity-font-style: bold;
}

/* ================================================================
   LAB 4.0 — SCHERMATA 1: PROTOCOLLO / GENOSCRITTORE
   ================================================================ */

.lab40-s1-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: rgba(4, 10, 12, 0.97);
    border-width: 2px;
    border-color: rgba(127, 255, 122, 0.82);
    /* Visibile in UI Builder; il controller lo nasconde all'avvio */
    display: flex;
}

/* === HEADER BAR === */
.lab40-s1-header-bar {
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(127, 255, 122, 0.35);
    background-color: rgba(6, 16, 8, 0.85);
    padding: 8px 16px;
    min-height: 46px;
}

.lab40-s1-header-icon-box {
    width: 28px;
    height: 28px;
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.6);
    justify-content: center;
    align-items: center;
    margin-right: 12px;
    background-color: rgba(12, 28, 14, 0.8);
}

.lab40-s1-header-icon {
    font-size: 14px;
    color: rgba(127, 255, 122, 0.9);
}

.lab40-s1-header-text-col {
    flex-direction: column;
}

.lab40-s1-header-title {
    font-size: 15px;
    letter-spacing: 2px;
    color: rgb(127, 255, 122);
    -unity-font-style: bold;
    margin-bottom: 1px;
}

.lab40-s1-header-sub {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgba(168, 200, 172, 0.65);
}

/* BODY: left | center | right */
.lab40-s1-body {
    flex-direction: row;
    flex-grow: 1;
    overflow: hidden;
}

/* === LEFT SIDEBAR === */
.lab40-s1-left {
    width: 192px;
    min-width: 192px;
    flex-direction: column;
    padding: 14px 12px;
    border-right-width: 1px;
    border-right-color: rgba(127, 255, 122, 0.22);
    background-color: rgba(6, 13, 8, 0.6);
}

.lab40-s1-module-tag {
    font-size: 10px;
    letter-spacing: 2px;
    color: rgba(127, 255, 122, 0.7);
    margin-bottom: 2px;
}

.lab40-s1-module-title {
    font-size: 15px;
    letter-spacing: 1px;
    color: rgb(127, 255, 122);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.lab40-s1-seed-icon-box {
    width: 80px;
    height: 80px;
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.45);
    justify-content: center;
    align-items: center;
    margin-bottom: 6px;
    background-color: rgba(10, 20, 12, 0.7);
}

.lab40-s1-seed-icon-placeholder {
    font-size: 36px;
    color: rgba(127, 255, 122, 0.7);
}

.lab40-s1-seed-label {
    font-size: 11px;
    letter-spacing: 1px;
    color: rgba(168, 217, 160, 0.9);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.lab40-s1-knowledge-block {
    flex-direction: column;
    margin-bottom: 12px;
}

.lab40-s1-know-caption {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgba(168, 200, 172, 0.75);
    margin-bottom: 2px;
}

.lab40-s1-know-bar-track {
    height: 8px;
    border-width: 1px;
    border-color: rgba(104, 148, 108, 0.7);
    background-color: rgba(15, 28, 16, 0.8);
    margin-bottom: 3px;
}

.lab40-s1-know-bar-fill {
    height: 100%;
    width: 70%;
    background-color: rgba(127, 255, 122, 0.9);
}

.lab40-s1-know-score {
    font-size: 13px;
    color: rgba(127, 255, 122, 0.95);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.lab40-s1-dna-placeholder {
    font-size: 30px;
    color: rgba(127, 255, 122, 0.5);
    margin-top: 8px;
    margin-bottom: 8px;
    -unity-text-align: middle-left;
}

.lab40-s1-registry-block {
    flex-direction: column;
    margin-top: auto;
    border-top-width: 1px;
    border-top-color: rgba(127, 255, 122, 0.18);
    padding-top: 8px;
}

.lab40-s1-registry-label {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgba(168, 195, 172, 0.7);
}

.lab40-s1-registry-status {
    font-size: 11px;
    color: rgba(127, 255, 122, 0.95);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* === CENTER === */
.lab40-s1-center {
    flex-grow: 1;
    flex-direction: column;
    padding: 12px 14px;
    border-right-width: 1px;
    border-right-color: rgba(127, 255, 122, 0.18);
    background-color: rgba(7, 16, 9, 0.35);
}

.lab40-s1-concept-row {
    flex-direction: row;
    margin-bottom: 8px;
    border-width: 1px;
    border-color: rgba(100, 140, 104, 0.28);
    background-color: rgba(10, 22, 12, 0.55);
    padding: 8px;
    align-items: flex-start;
}

.lab40-s1-concept-icon-box {
    width: 40px;
    min-width: 40px;
    height: 40px;
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.4);
    justify-content: center;
    align-items: center;
    margin-right: 10px;
    background-color: rgba(8, 18, 10, 0.7);
}

.lab40-s1-concept-icon {
    font-size: 18px;
    color: rgba(127, 255, 122, 0.85);
}

.lab40-s1-concept-body {
    flex-grow: 1;
    flex-direction: column;
    margin-right: 8px;
}

.lab40-s1-concept-title {
    font-size: 12px;
    letter-spacing: 1px;
    color: rgba(180, 225, 175, 0.98);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.lab40-s1-concept-desc {
    font-size: 11px;
    color: rgba(190, 210, 192, 0.88);
    white-space: normal;
    -unity-font-style: normal;
}

.lab40-s1-concept-quote-box {
    width: 140px;
    min-width: 140px;
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.3);
    background-color: rgba(12, 25, 14, 0.8);
    padding: 6px;
    justify-content: center;
}

.lab40-s1-concept-quote {
    font-size: 10px;
    color: rgba(168, 210, 164, 0.85);
    white-space: normal;
    -unity-font-style: italic;
}

.lab40-s1-bottom-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.lab40-s1-legend-row {
    flex-direction: row;
    flex-grow: 1;
    flex-wrap: wrap;
    border-width: 1px;
    border-color: rgba(100, 140, 104, 0.28);
    background-color: rgba(8, 18, 10, 0.5);
    padding: 6px 8px;
}

.lab40-s1-legend-item {
    font-size: 10px;
    color: rgba(148, 186, 152, 0.9);
    margin-right: 12px;
}

.lab40-s1-stamp-box {
    min-width: 130px;
    border-width: 2px;
    border-color: rgba(127, 255, 122, 0.55);
    padding: 6px 8px;
    background-color: rgba(8, 18, 10, 0.6);
    justify-content: center;
    align-items: center;
    margin-left: 8px;
    rotate: -4deg;
}

.lab40-s1-stamp-label {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgba(127, 255, 122, 0.8);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* === RIGHT SIDEBAR === */
.lab40-s1-right {
    width: 180px;
    min-width: 180px;
    flex-direction: column;
    padding: 14px 12px;
    background-color: rgba(6, 13, 8, 0.55);
}

.lab40-s1-seq-title {
    font-size: 10px;
    letter-spacing: 2px;
    color: rgba(127, 255, 122, 0.7);
    -unity-font-style: bold;
    margin-bottom: 14px;
}

.lab40-s1-seq-step {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.lab40-s1-seq-step-active {
    background-color: rgba(20, 40, 22, 0.6);
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.45);
    padding: 4px 6px;
}

.lab40-s1-seq-icon-box {
    width: 32px;
    height: 32px;
    border-width: 1px;
    border-color: rgba(127, 255, 122, 0.55);
    justify-content: center;
    align-items: center;
    margin-right: 8px;
    background-color: rgba(8, 20, 10, 0.8);
}

.lab40-s1-seq-icon-box-dim {
    border-color: rgba(100, 130, 104, 0.35);
    background-color: rgba(8, 15, 9, 0.5);
}

.lab40-s1-seq-icon {
    font-size: 16px;
    color: rgba(127, 255, 122, 0.9);
}

.lab40-s1-seq-icon-dim {
    color: rgba(100, 130, 104, 0.6);
}

.lab40-s1-seq-label {
    font-size: 11px;
    color: rgba(168, 200, 172, 0.75);
    white-space: normal;
    flex-grow: 1;
}

.lab40-s1-seq-label-active {
    color: rgba(127, 255, 122, 0.98);
    -unity-font-style: bold;
}

.lab40-s1-seq-arrow {
    font-size: 14px;
    color: rgba(127, 255, 122, 0.45);
    margin-left: 14px;
    margin-top: 2px;
    margin-bottom: 2px;
}

/* === FOOTER === */
.lab40-s1-footer {
    flex-direction: row;
    align-items: center;
    border-top-width: 2px;
    border-top-color: rgba(127, 255, 122, 0.5);
    background-color: rgba(4, 12, 6, 0.9);
    padding: 10px 14px;
    min-height: 60px;
}

.lab40-s1-vo-block {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.lab40-s1-vo-avatar-box {
    width: 40px;
    height: 40px;
    border-width: 1px;
    border-color: rgba(93, 182, 227, 0.6);
    justify-content: center;
    align-items: center;
    margin-right: 10px;
    background-color: rgba(8, 16, 22, 0.8);
}

.lab40-s1-vo-avatar-icon {
    font-size: 18px;
    color: rgba(93, 182, 227, 0.8);
}

.lab40-s1-vo-text-block {
    flex-direction: column;
    flex-grow: 1;
}

.lab40-s1-vo-tag {
    font-size: 10px;
    letter-spacing: 2px;
