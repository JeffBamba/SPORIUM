.nf-row.nf-row--item-layout {
    height: 72px;
    min-height: 72px;
}

.nf-row-item-layout {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-start;
    min-width: 0;
}

.nf-row-item-icon-box {
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    margin-right: 10px;
    align-self: flex-start;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--sp-color-green-led);
    border-right-color: var(--sp-color-green-led);
    border-top-color: var(--sp-color-green-led);
    border-bottom-color: var(--sp-color-green-led);
    background-color: rgba(18, 40, 28, 0.6);
}

.nf-row-item-icon {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.nf-row-item-body {
    flex-grow: 1;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    min-width: 0;
    overflow: hidden;
}

.nf-row-item-title {
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--sp-color-green-led);
    unity-font-style: bold;
    margin-bottom: 1px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.nf-row-qty-name-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 1px;
    min-width: 0;
    overflow: hidden;
}

.nf-row-qty {
    font-size: 13px;
    color: var(--sp-color-text-muted);
    -unity-text-transform: uppercase;
    margin-right: 4px;
    flex-shrink: 0;
}

.nf-row-item-name {
    font-size: 13px;
    color: var(--sp-color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.nf-row-room-row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    overflow: hidden;
}

.nf-row-room-icon {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    min-width: 14px;
    min-height: 14px;
    margin-right: 6px;
    background-color: rgba(93, 182, 227, 0.25);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sp-color-green-led);
    border-right-color: var(--sp-color-green-led);
    border-top-color: var(--sp-color-green-led);
    border-bottom-color: var(--sp-color-green-led);
}

.nf-row-room {
    font-size: 11px;
    color: var(--sp-color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Mini-tooltip al passaggio del mouse sulla toast (stile Foundation) */
.nf-toast-tooltip {
    position: absolute;
    display: none;
    min-width: 180px;
    max-width: 260px;
    padding: var(--sp-space-sm);
    background-color: var(--sp-bg-panel);
    border-left-width: var(--sp-border-2);
    border-right-width: var(--sp-border-2);
    border-top-width: var(--sp-border-2);
    border-bottom-width: var(--sp-border-2);
    border-left-color: var(--sp-color-blue-info);
    border-right-color: var(--sp-color-blue-info);
    border-top-color: var(--sp-color-blue-info);
    border-bottom-color: var(--sp-color-blue-info);
    border-top-left-radius: var(--sp-radius-sm);
    border-top-right-radius: var(--sp-radius-sm);
    border-bottom-left-radius: var(--sp-radius-sm);
    border-bottom-right-radius: var(--sp-radius-sm);
    z-index: 100;
}

.nf-toast-tooltip__text {
    font-size: var(--sp-font-size-10);
    color: var(--sp-color-text-muted);
    white-space: normal;
    -unity-font-style: normal;
}

/* Mission (codici MIS-*) — cyan #00FFC6 come Active Missions / toast ShowMission */
.nf-sev-mission {
    --nf-color: rgb(0, 255, 198);
    --nf-bg: rgba(6, 28, 32, 0.94);
}

.nf-header.nf-sev-mission {
    border-left-color: var(--nf-color);
    border-right-color: var(--nf-color);
    border-top-color: var(--nf-color);
    border-bottom-color: var(--nf-color);
}

.nf-row.nf-sev-mission {
    border-left-color: var(--nf-color);
    border-right-color: var(--nf-color);
    border-top-color: var(--nf-color);
    border-bottom-color: var(--nf-color);
    background-color: var(--nf-bg);
}

.nf-row.nf-sev-mission .nf-iconbox {
    border-left-color: var(--nf-color);
    border-right-color: var(--nf-color);
    border-top-color: var(--nf-color);
    border-bottom-color: var(--nf-color);
}

.nf-row.nf-sev-mission .nf-row-icon {
    color: var(--nf-color);
}

.nf-row.nf-sev-mission .nf-row-code {
    color: var(--nf-color);
}

.nf-header.nf-sev-mission .nf-header-icon,
.nf-header.nf-sev-mission .nf-header-title,
.nf-header.nf-sev-mission .nf-chevron,
.nf-header.nf-sev-mission .nf-badge-text,
.nf-header.nf-sev-mission .nf-badge,
.nf-header.nf-sev-mission .nf-iconbox {
    color: var(--nf-color);
    border-left-color: var(--nf-color);
    border-right-color: var(--nf-color);
    border-top-color: var(--nf-color);
    border-bottom-color: var(--nf-color);
}
