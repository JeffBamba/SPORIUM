.nf-root {
    position: absolute;
    right: 24px;
    top: 136px;
    width: 400px;
    flex-direction: column;
    align-items: stretch;
}

.nf-header {
    width: 100%;
    align-self: stretch;
}

.nf-row {
    width: 100%;
    align-self: stretch;
}

.nf-header {
    height: 40px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(30, 40, 42, 0.9);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--sp-color-blue-info);
    border-right-color: var(--sp-color-blue-info);
    border-top-color: var(--sp-color-blue-info);
    border-bottom-color: var(--sp-color-blue-info);
}

.nf-header-left {
    flex-direction: row;
    align-items: center;
}

.nf-iconbox {
    width: 22px;
    height: 22px;
    margin-right: 8px;
    justify-content: center;
    align-items: center;
    background-color: rgba(10, 18, 22, 0.8);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sp-color-blue-info);
    border-right-color: var(--sp-color-blue-info);
    border-top-color: var(--sp-color-blue-info);
    border-bottom-color: var(--sp-color-blue-info);
}

.nf-header-icon {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    -unity-text-align: middle-center;
    color: var(--sp-color-blue-info);
}

.nf-header-title {
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--sp-color-blue-info);
    unity-font-style: bold;
}

.nf-header-right {
    flex-direction: row;
    align-items: center;
}

.nf-badge {
    min-width: 20px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-right: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sp-color-blue-info);
    border-right-color: var(--sp-color-blue-info);
    border-top-color: var(--sp-color-blue-info);
    border-bottom-color: var(--sp-color-blue-info);
    background-color: rgba(93, 182, 227, 0.15);
    justify-content: center;
    align-items: center;
}

.nf-badge-text {
    font-size: 12px;
    color: var(--sp-color-blue-info);
}

.nf-chevron {
    width: 16px;
    height: 16px;
    unity-text-align: middle-center;
    color: var(--sp-color-blue-info);
}

.nf-list {
    margin-top: 10px;
    flex-direction: column;
    width: 100%;
}

.nf-row {
    height: 55px;
    min-height: 55px;
    margin-bottom: 10px;
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
    transition-property: opacity, translate, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    flex-direction: row;
    align-items: flex-start;
    background-color: rgba(10, 18, 22, 0.92);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--sp-color-blue-info);
    border-right-color: var(--sp-color-blue-info);
    border-top-color: var(--sp-color-blue-info);
    border-bottom-color: var(--sp-color-blue-info);
}

.nf-row.nf-anim-enter {
    opacity: 0;
    translate: 100px 0;
    scale: 0.8 0.8;
}

.nf-row.nf-anim-exit {
    opacity: 0;
    translate: 100px 0;
    scale: 0.8 0.8;
}

.nf-row-icon {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    -unity-text-align: middle-center;
    white-space: nowrap;
    color: var(--sp-color-blue-info);
}

.nf-row-text {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
}

.nf-row-code {
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--sp-color-blue-info);
}

.nf-row-msg {
    font-size: 13px;
    color: var(--sp-color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.nf-collapsed .nf-list {
    display: none;
}

.nf-sev-info {
    --nf-color: var(--sp-color-green-led);
    --nf-bg: rgba(18, 40, 28, 0.94);
}

.nf-sev-success {
    --nf-color: var(--sp-color-green-led);
    --nf-bg: rgba(18, 40, 28, 0.94);
}

.nf-sev-warning {
    --nf-color: var(--sp-color-yellow-standard);
    --nf-bg: rgba(44, 38, 18, 0.94);
}

.nf-sev-danger {
    --nf-color: var(--sp-color-red-warning);
    --nf-bg: rgba(46, 22, 22, 0.94);
}

.nf-row.nf-code-vis {
    --nf-color: rgb(181, 128, 209);
    --nf-bg: rgba(44, 18, 46, 0.94);
}

.nf-header.nf-code-vis {
    --nf-color: rgb(181, 128, 209);
    --nf-bg: rgba(44, 18, 46, 0.94);
}

.nf-header.nf-sev-info {
    border-left-color: var(--nf-color);
    border-right-color: var(--nf-color);
    border-top-color: var(--nf-color);
    border-bottom-color: var(--nf-color);
}

