/*
SPORIUM UI FOUNDATION — StatBar
Supporta: continua (fill) e segmentata (segment children)
*/

.sp-stat-bar {
  height: 10px;
  min-height: 10px;
  background-color: rgba(0, 0, 0, 0.25);
  border-left-width: var(--sp-border-1);
  border-right-width: var(--sp-border-1);
  border-top-width: var(--sp-border-1);
  border-bottom-width: var(--sp-border-1);
  border-left-color: var(--sp-line);
  border-right-color: var(--sp-line);
  border-top-color: var(--sp-line);
  border-bottom-color: var(--sp-line);
  padding-left: 2px;
  padding-right: 2px;
  padding-top: 2px;
  padding-bottom: 2px;
}

/* Continuous fill element (child) */
.sp-stat-bar__fill {
  height: 100%;
  background-color: var(--sp-color-green-led);
}

.sp-stat-bar--blue .sp-stat-bar__fill   { background-color: var(--sp-color-blue-info); }
.sp-stat-bar--violet .sp-stat-bar__fill { background-color: var(--sp-color-violet-growth); }
.sp-stat-bar--yellow .sp-stat-bar__fill { background-color: var(--sp-color-yellow-standard); }
.sp-stat-bar--red .sp-stat-bar__fill    { background-color: var(--sp-color-red-warning); }

/* Segmented bars: use children with this class */
.sp-stat-bar__segment {
  flex-grow: 1;
  height: 100%;
  margin-right: 2px;
  background-color: rgba(255, 255, 255, 0.08);
}

.sp-stat-bar__segment--on { background-color: var(--sp-color-green-led); }
.sp-stat-bar--blue .sp-stat-bar__segment--on   { background-color: var(--sp-color-blue-info); }
.sp-stat-bar--violet .sp-stat-bar__segment--on { background-color: var(--sp-color-violet-growth); }
.sp-stat-bar--yellow .sp-stat-bar__segment--on { background-color: var(--sp-color-yellow-standard); }
.sp-stat-bar--red .sp-stat-bar__segment--on    { background-color: var(--sp-color-red-warning); }

.sp-stat-bar__segment--last { margin-right: 0px; }

/* Vertical variant (for PlantCard-like layouts) */
.sp-stat-bar--vertical {
  width: 10px;
  height: 120px;
  flex-direction: column;
}

.sp-stat-bar--vertical .sp-stat-bar__segment {
  width: 100%;
  height: auto;
  margin-right: 0px;
  margin-bottom: 2px;
}

.sp-stat-bar--vertical .sp-stat-bar__segment--last {
  margin-bottom: 0px;
}


