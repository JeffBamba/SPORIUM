:root {
    --sp-color-green-led: rgb(127, 255, 122);
    --sp-color-blue-info: rgb(93, 182, 227);
    --sp-color-red-warning: rgb(211, 95, 95);
    --sp-color-yellow-standard: rgb(230, 201, 111);
    --sp-color-violet-growth: rgb(181, 128, 209);
    --sp-color-text-muted: rgb(192, 200, 197);
    --sp-color-text: rgb(231, 244, 255);
    --sp-color-text-dim: rgba(231, 244, 255, 0.75);
    --sp-bg-panel: rgba(30, 40, 42, 0.9);
    --sp-bg-panel-dark: rgb(10, 18, 22);
    --sp-bg-panel-darker: rgb(15, 20, 22);
    --sp-bg-metal-light: rgba(255, 255, 255, 0.06);
    --sp-bg-metal-dark: rgba(0, 0, 0, 0.22);
    --sp-line-weak: rgba(231, 244, 255, 0.12);
    --sp-line: rgba(231, 244, 255, 0.2);
    --sp-line-strong: rgba(231, 244, 255, 0.35);
    --sp-border-1: 1px;
    --sp-border-2: 2px;
    --sp-border-4: 4px;
    --sp-space-xs: 4px;
    --sp-space-sm: 8px;
    --sp-space-md: 12px;
    --sp-space-lg: 16px;
    --sp-space-xl: 24px;
    --sp-space-xxl: 32px;
    --sp-radius-xs: 2px;
    --sp-radius-sm: 6px;
    --sp-radius-md: 10px;
    --sp-radius-lg: 14px;
    --sp-font-size-8: 8px;
    --sp-font-size-9: 12px;
    --sp-font-size-10: 13px;
    --sp-font-size-11: 13px;
    --sp-font-size-12: 13px;
    --sp-font-size-14: 14px;
    --sp-font-size-16: 16px;
    --sp-font-size-20: 20px;
    --sp-font-size-24: 24px;
    --sp-letter-tight: -0.5px;
    --sp-letter-normal: 0;
    --sp-letter-wide: 0.8px;
    --sp-focus: rgba(93, 182, 227, 0.55);
    --sp-focus-strong: rgba(93, 182, 227, 0.85);
}

.sp-text {
    color: var(--sp-color-text);
}

.sp-text--muted {
    color: var(--sp-color-text-muted);
}

.sp-text--dim {
    color: var(--sp-color-text-dim);
}

.sp-label {
    font-size: var(--sp-font-size-10);
    letter-spacing: var(--sp-letter-wide);
    color: var(--sp-color-text-dim);
    -unity-font-style: bold;
}

.sp-title {
    font-size: var(--sp-font-size-12);
    letter-spacing: var(--sp-letter-wide);
    color: var(--sp-color-text);
    -unity-font-style: bold;
}

.sp-divider {
    height: 1px;
    background-color: var(--sp-line);
}

.pcv3-hud-pot-slot-label {
}
