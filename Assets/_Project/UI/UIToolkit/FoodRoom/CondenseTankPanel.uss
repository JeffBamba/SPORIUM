.condense-tank-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.65);
}

.condense-tank-overlay {
    flex-grow: 1;
    align-self: stretch;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
}

.condense-tank-panel {
    width: 900px;
    min-width: 760px;
    min-height: 690px;
    max-height: 92%;
    flex-direction: column;
    border-width: 2px;
    border-color: rgba(93, 182, 227, 0.7);
    border-radius: var(--sp-radius-md);
    background-color: rgba(8, 17, 22, 0.97);
}

.condense-header {
    flex-direction: column;
    align-items: stretch;
    padding-bottom: var(--sp-space-md);
}

.condense-status-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--sp-space-sm);
}

.condense-status {
    flex-grow: 1;
    font-size: var(--sp-font-size-14);
    -unity-font-style: bold;
    color: var(--sp-color-blue-info);
    white-space: normal;
}

.condense-hero-card {
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: rgba(93, 182, 227, 0.55);
    border-radius: var(--sp-radius-sm);
    padding-top: var(--sp-space-md);
    padding-right: var(--sp-space-md);
    padding-bottom: var(--sp-space-md);
    padding-left: var(--sp-space-md);
    background-color: rgba(4, 14, 20, 0.88);
}

.condense-hero-copy {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
}

.condense-title-icon {
    width: 70px;
    height: 70px;
    margin-right: var(--sp-space-md);
    border-width: 1px;
    border-color: rgba(93, 182, 227, 0.78);
    border-radius: var(--sp-radius-sm);
    background-color: rgba(8, 34, 48, 0.72);
    font-size: var(--sp-font-size-12);
    color: var(--sp-color-blue-info);
    -unity-text-align: middle-center;
}

.condense-title {
    font-size: var(--sp-font-size-18);
    color: var(--sp-color-blue-info);
}

.condense-subtitle {
    margin-top: var(--sp-space-xs);
    color: var(--sp-color-text-dim);
    font-size: var(--sp-font-size-10);
    white-space: normal;
}

.condense-close {
    min-width: 52px;
    width: 52px;
    height: 52px;
    padding: 0;
    font-size: var(--sp-font-size-18);
    -unity-font-style: bold;
    border-color: rgb(138, 74, 74);
    background-color: rgba(138, 74, 74, 0.1);
}

.condense-content {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
    overflow-y: auto;
    padding-top: var(--sp-space-md);
    padding-right: var(--sp-space-lg);
    padding-bottom: var(--sp-space-md);
    padding-left: var(--sp-space-lg);
}

.section-title-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--sp-space-md);
    padding-left: var(--sp-space-md);
}

.section-title-row .section-icon {
    margin-right: var(--sp-space-sm);
    font-size: var(--sp-font-size-14);
}

.section-title-row.teal .section-icon,
.section-title-row.teal .section-title {
    color: var(--sp-color-blue-info);
}

.section-title-row.condensation .section-icon,
.section-title-row.condensation .section-title {
    color: var(--sp-color-green-led);
}

.section-hydration {
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgba(93, 182, 227, 0.42);
    border-radius: var(--sp-radius-sm);
    padding-top: var(--sp-space-md);
    padding-right: var(--sp-space-sm);
    padding-bottom: var(--sp-space-sm);
    padding-left: var(--sp-space-sm);
    background-color: rgba(2, 10, 15, 0.62);
}

.hydration-line-box {
    flex-direction: column;
    border-width: var(--sp-border-1);
    border-color: var(--sp-color-blue-info);
    border-radius: var(--sp-radius-sm);
    padding: var(--sp-space-md);
    background-color: var(--sp-bg-panel-dark);
}

.hydration-main-row {
    flex-direction: row;
    align-items: center;
    min-height: 180px;
}

.hydration-flow-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
    min-height: 170px;
}

.hydration-stage {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.hydration-stage--raw,
.hydration-stage--filter,
.hydration-stage--potable {
    width: 142px;
}

.hydration-text-block {
    flex-direction: column;
}

.hydration-stage-title,
.hydration-label {
    font-size: var(--sp-font-size-12);
    -unity-font-style: bold;
    color: var(--sp-color-blue-info);
    -unity-text-align: middle-center;
}

.hydration-stage-title--bottom {
    margin-top: var(--sp-space-xs);
}

.hydration-stage-caption,
.hydration-flavor {
    margin-top: var(--sp-space-xs);
    font-size: var(--sp-font-size-10);
    color: var(--sp-color-text-dim);
    white-space: normal;
    -unity-text-align: middle-center;
}

.hydration-drop-icon {
    width: 28px;
    margin-right: var(--sp-space-xs);
    font-size: var(--sp-font-size-10);
    color: var(--sp-color-blue-info);
    -unity-text-align: middle-center;
}

.hydration-flow-arrow {
    width: 42px;
    font-size: var(--sp-font-size-14);
    -unity-font-style: bold;
    color: rgba(93, 182, 227, 0.78);
    -unity-text-align: middle-center;
}

.hydration-controls-divider {
    width: 1px;
    height: 136px;
    margin-left: var(--sp-space-sm);
    margin-right: var(--sp-space-sm);
    background-color: rgba(93, 182, 227, 0.28);
}

.hydration-units-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    width: 166px;
    justify-content: flex-end;
}

.hydration-units-label {
    margin-right: var(--sp-space-xs);
    font-size: var(--sp-font-size-10);
    color: var(--sp-color-text-dim);
}

.hydration-units-value {
    min-width: 28px;
    font-size: var(--sp-font-size-12);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--sp-color-blue-info);
}

.hydration-units-btn {
    min-width: 38px;
    width: 38px;
    height: 38px;
    padding: 0;
    margin-left: 2px;
    margin-right: 2px;
    font-size: var(--sp-font-size-14);
}

.hydration-status-row {
    width: 100%;
    margin-top: var(--sp-space-md);
    padding-top: var(--sp-space-md);
    border-top-width: 1px;
    border-top-color: rgba(93, 182, 227, 0.35);
    flex-direction: row;
    align-items: center;
}

.hydration-status-text {
    font-size: var(--sp-font-size-11);
    color: var(--sp-color-text-dim);
}

.condense-image-placeholder {
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-radius: var(--sp-radius-sm);
    background-color: rgba(4, 18, 24, 0.74);
}

.condense-image-placeholder__text {
    font-size: var(--sp-font-size-10);
    -unity-font-style: bold;
    color: rgba(206, 236, 244, 0.76);
    -unity-text-align: middle-center;
}

.condense-image-placeholder--drop {
    width: 94px;
    height: 112px;
    margin-top: var(--sp-space-sm);
    border-color: rgba(93, 182, 227, 0.62);
}

.condense-image-placeholder--filter {
    width: 120px;
    height: 108px;
    border-color: rgba(93, 182, 227, 0.52);
}

.condense-image-placeholder--potable {
    border-color: rgba(93, 182, 227, 0.82);
}

.condense-image-placeholder--tank {
    width: 132px;
    height: 150px;
    border-color: rgba(61, 168, 130, 0.72);
    background-color: rgba(7, 28, 18, 0.74);
}

.water-progress-block {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    margin-top: var(--sp-space-md);
    padding-right: var(--sp-space-sm);
    padding-left: var(--sp-space-sm);
}

.water-progress-label {
    margin-bottom: var(--sp-space-xs);
    font-size: var(--sp-font-size-10);
    -unity-font-style: bold;
    color: var(--sp-color-blue-info);
}

.water-progress-track {
    position: relative;
    height: 10px;
    min-height: 10px;
    border-width: 1px;
    border-color: rgba(93, 182, 227, 0.5);
    border-radius: 5px;
    background-color: var(--sp-bg-panel-darker);
    overflow: hidden;
}

.water-progress-fill {
    height: 100%;
    width: 0%;
    border-radius: 5px;
    background-color: var(--sp-color-blue-info);
}

.water-progress-shine {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 30%;
    min-width: 24px;
    border-radius: 5px;
    background-color: rgba(135, 206, 235, 0.85);
    pointer-events: none;
}

.condensation-collect-section {
    flex-shrink: 0;
    margin-top: var(--sp-space-md);
    border-width: 1px;
    border-color: rgba(61, 168, 130, 0.62);
    border-radius: var(--sp-radius-sm);
    padding-top: var(--sp-space-sm);
    padding-right: var(--sp-space-sm);
    padding-bottom: var(--sp-space-sm);
    padding-left: var(--sp-space-sm);
    background-color: rgba(5, 18, 12, 0.68);
}

.condensation-collect-box {
    flex-direction: row;
    align-items: stretch;
    border-width: var(--sp-border-1);
    border-color: rgba(61, 168, 130, 0.75);
    border-radius: var(--sp-radius-sm);
    padding: var(--sp-space-sm);
    background-color: rgba(13, 28, 23, 0.88);
}

.condensation-visual-column {
    width: 150px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.condensation-divider {
    width: 1px;
    margin-left: var(--sp-space-md);
    margin-right: var(--sp-space-md);
    background-color: rgba(61, 168, 130, 0.45);
}

.condensation-data-column {
    flex-grow: 1;
    min-width: 0;
    flex-direction: column;
}

.condensation-info-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--sp-space-sm);
}

.condensation-text-block {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
}

.condensation-label {
    font-size: var(--sp-font-size-13);
    -unity-font-style: bold;
    color: var(--sp-color-green-led);
}

.condensation-flavor {
    margin-top: var(--sp-space-xs);
    font-size: var(--sp-font-size-10);
    color: var(--sp-color-text-dim);
    white-space: normal;
}

.condensation-value {
    min-width: 56px;
    font-size: var(--sp-font-size-16);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: var(--sp-color-green-led);
}

.condensation-progress-track {
    height: 16px;
    min-height: 16px;
    border-width: 1px;
    border-color: rgba(61, 168, 130, 0.55);
    border-radius: 4px;
    background-color: var(--sp-bg-panel-darker);
    overflow: hidden;
}

.condensation-progress-fill {
    height: 100%;
    width: 0%;
    border-radius: 4px;
    background-color: var(--sp-color-green-led);
}

.condensation-progress-markers {
    flex-direction: row;
    align-items: center;
    margin-top: var(--sp-space-xs);
}

.condensation-progress-marker {
    flex-grow: 1;
    font-size: var(--sp-font-size-9);
    color: rgba(128, 220, 98, 0.84);
}

.condensation-progress-marker--center {
    -unity-text-align: middle-center;
}

.condensation-progress-marker--right {
    -unity-text-align: middle-right;
}

.condensation-status-row {
    flex-direction: row;
    align-items: center;
    margin-top: var(--sp-space-md);
}

.condensation-status-text {
    flex-grow: 1;
    margin-right: var(--sp-space-md);
    font-size: var(--sp-font-size-10);
    color: var(--sp-color-text-dim);
}

.condensation-status-text-col {
    flex-grow: 1;
    flex-direction: column;
    margin-right: var(--sp-space-md);
    min-width: 0;
}

.condensation-forecast {
    margin-top: var(--sp-space-xs);
    font-size: var(--sp-font-size-9);
    color: rgba(93, 182, 227, 0.92);
    white-space: normal;
}

.condensation-collect-button {
    min-width: 190px;
    height: 46px;
    color: var(--sp-color-green-led);
    border-left-color: rgba(61, 168, 130, 0.75);
    border-right-color: rgba(61, 168, 130, 0.75);
    border-top-color: rgba(61, 168, 130, 0.75);
    border-bottom-color: rgba(61, 168, 130, 0.75);
    background-color: rgba(61, 168, 130, 0.08);
}

.condense-bottom-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    border-top-width: 2px;
    border-top-color: rgba(93, 182, 227, 0.35);
    background-color: rgba(9, 22, 26, 0.8);
}

.condense-bottom-hint-wrap {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    flex-grow: 1;
}

.condense-bottom-hint {
    margin-right: var(--sp-space-md);
    color: var(--sp-color-text-dim);
    white-space: normal;
}

.condense-action-button {
    min-width: 260px;
    height: 46px;
}

.status-line-icon {
    width: 28px;
    height: 28px;
    margin-right: var(--sp-space-sm);
    border-width: 1px;
    border-radius: 14px;
    font-size: var(--sp-font-size-12);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.status-line-icon--blue {
    color: var(--sp-color-blue-info);
    border-color: rgba(93, 182, 227, 0.72);
    background-color: rgba(93, 182, 227, 0.08);
}

.status-line-icon--green {
    color: var(--sp-color-green-led);
    border-color: rgba(61, 168, 130, 0.72);
    background-color: rgba(61, 168, 130, 0.08);
}

.condense-bottom-bar .btn-purify.btn-purify--enabled {
    border-left-color: var(--sp-color-blue-info);
    border-right-color: var(--sp-color-blue-info);
    border-top-color: var(--sp-color-blue-info);
    border-bottom-color: var(--sp-color-blue-info);
    color: var(--sp-color-blue-info);
    background-color: rgba(93, 182, 227, 0.08);
}
