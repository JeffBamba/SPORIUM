.seedinv-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.seedinv-panel {
    --seedinv-yellow: rgb(230, 201, 111);
    --seedinv-green: rgb(127, 255, 122);
    --seedinv-red: rgb(211, 95, 95);
    --seedinv-muted: rgba(192, 200, 197, 0.65);

    width: 560px;
    background-color: rgb(10, 18, 22);
    border-width: 2px;
    border-color: var(--seedinv-yellow);
    padding: 18px;
    flex-direction: column;
    position: relative;
    max-height: 520px;
}

.seedinv-grid {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.10;
    background-color: rgba(255, 255, 255, 0.0);
    pointer-events: none;
}

.seedinv-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.seedinv-header-left {
    flex-direction: row;
    align-items: center;
}

.seedinv-header-left > * {
    margin-right: 5px;
}

.seedinv-header-left > *:last-child {
    margin-right: 0;
}

.seedinv-iconbox {
    width: 18px;
    height: 18px;
    border-width: 1px;
    border-color: rgba(230, 201, 111, 0.75);
    background-color: rgb(12, 18, 22);
}

.seedinv-title {
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--seedinv-yellow);
    text-shadow: 0 0 8px rgba(230, 201, 111, 0.6);
    -unity-font-style: bold;
}

.seedinv-subtitle {
    font-size: 10px;
    color: var(--seedinv-muted);
    margin-top: 4px;
}

.seedinv-close-button {
    width: 28px;
    height: 28px;
    border-width: 1px;
    border-color: rgba(230, 201, 111, 0.55);
    background-color: rgba(230, 201, 111, 0.05);
}

.seedinv-close-button:hover {
    background-color: rgba(230, 201, 111, 0.10);
}

.seedinv-close-x {
    -unity-text-align: middle-center;
    font-size: 16px;
    color: rgba(230, 201, 111, 0.85);
}

.seedinv-list {
    flex-grow: 0;
    flex-direction: column;
    overflow-y: auto;
    margin-bottom: 14px;
    max-height: 300px;
}

.seedinv-list > * {
    margin-bottom: 5px;
}

.seedinv-list > *:last-child {
    margin-bottom: 0;
}

.seedinv-row {
    height: 78px;
    padding: 12px;
    border-width: 1px;
    border-color: rgba(230, 201, 111, 0.35);
    background-color: rgb(26, 26, 22);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.seedinv-row:hover {
    background-color: rgb(32, 32, 26);
}

.seedinv-row-iconbox {
    width: 40px;
    height: 40px;
    border-width: 1px;
    border-color: rgba(230, 201, 111, 0.35);
    background-color: rgb(12, 18, 22);
    align-items: center;
    justify-content: center;
}

.seedinv-row-iconglyph {
    width: 18px;
    height: 18px;
    border-width: 1px;
    border-color: rgba(230, 201, 111, 0.65);
    background-color: rgb(10, 18, 22);
}

.seedinv-row-main {
    flex-direction: column;
    flex-grow: 1;
    margin-left: 12px;
}

.seedinv-seedname {
    font-size: 14px;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.92);
    -unity-font-style: bold;
}

.seedinv-name-pure {
    color: rgb(127, 255, 122);
    text-shadow: 0 0 6px rgba(127, 255, 122, 0.55);
}

.seedinv-name-standard {
    color: rgb(230, 201, 111);
    text-shadow: 0 0 6px rgba(230, 201, 111, 0.55);
}

.seedinv-name-evil {
    color: rgb(211, 95, 95);
    text-shadow: 0 0 6px rgba(211, 95, 95, 0.55);
}

.seedinv-badges {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.seedinv-badges > * {
    margin-right: 4px;
}

.seedinv-badges > *:last-child {
    margin-right: 0;
}

.seedinv-badge {
    padding: 2px 8px;
    border-width: 1px;
    background-color: rgb(12, 18, 22);
}

.seedinv-badge-text {
    font-size: 10px;
    letter-spacing: 1px;
}

.seedinv-badge-pure {
    border-color: rgba(127, 255, 122, 0.55);
}

.seedinv-badge-pure .seedinv-badge-text {
    color: var(--seedinv-green);
}

.seedinv-badge-standard {
    border-color: rgba(230, 201, 111, 0.55);
}

.seedinv-badge-standard .seedinv-badge-text {
    color: rgba(230, 201, 111, 0.95);
}

.seedinv-badge-evil {
    border-color: rgba(211, 95, 95, 0.55);
}

.seedinv-badge-evil .seedinv-badge-text {
    color: rgba(211, 95, 95, 0.95);
}

.seedinv-qty {
    font-size: 11px;
    color: var(--seedinv-muted);
}

.seedinv-right {
    flex-direction: row;
    align-items: center;
}

.seedinv-right > * {
    margin-right: 5px;
}

.seedinv-right > *:last-child {
    margin-right: 0;
}

.seedinv-select {
    padding: 10px 12px;
    border-width: 1px;
    border-color: rgba(230, 201, 111, 0.65);
    background-color: rgb(48, 44, 24);
}

.seedinv-select:hover {
    background-color: rgb(56, 52, 28);
}

.seedinv-select-text {
    font-size: 11px;
    letter-spacing: 1px;
    color: rgba(230, 201, 111, 0.95);
}

.seedinv-cancel {
    height: 54px;
    border-width: 1px;
    border-color: rgba(211, 95, 95, 0.45);
    background-color: rgb(36, 16, 16);
    justify-content: center;
    align-items: center;
}

.seedinv-cancel:hover {
    background-color: rgb(44, 20, 20);
}

.seedinv-cancel-text {
    font-size: 12px;
    letter-spacing: 2px;
    color: rgba(211, 95, 95, 0.85);
}


