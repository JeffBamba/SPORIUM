.seedinv-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.0);
}

.seedinv-panel {
    --seedinv-yellow: rgb(230, 201, 111);
    --seedinv-green: rgb(127, 255, 122);
    --seedinv-red: rgb(211, 95, 95);
    --seedinv-muted: rgba(192, 200, 197, 0.65);

    width: 720px;
    min-height: 560px;
    background-color: rgba(10, 18, 22, 0.96);
    border-width: 2px;
    border-color: var(--seedinv-yellow);
    padding: 18px;
    flex-direction: column;
    position: relative;
}

.seedinv-grid {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.12;
    background-color: rgba(255, 255, 255, 0.0);
    pointer-events: none;
}

.seedinv-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.seedinv-header-left {
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

.seedinv-header-icon {
    font-size: 18px;
    color: var(--seedinv-yellow);
}

.seedinv-title {
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--seedinv-yellow);
    text-shadow: 0 0 8px rgba(230, 201, 111, 0.6);
    -unity-font-style: bold;
}

.seedinv-subtitle {
    font-size: 10px;
    color: var(--seedinv-muted);
    margin-top: 4px;
}

.seedinv-close-button {
    width: 28px;
    height: 28px;
    border-width: 1px;
    border-color: rgba(230, 201, 111, 0.55);
    background-color: rgba(230, 201, 111, 0.05);
}

.seedinv-close-button:hover {
    background-color: rgba(230, 201, 111, 0.10);
}

.seedinv-close-x {
    -unity-text-align: middle-center;
    font-size: 16px;
    color: rgba(230, 201, 111, 0.85);
}

.seedinv-list {
    flex: 1;
    flex-direction: column;
    gap: 10px;
    overflow-y: auto;
    margin-bottom: 14px;
}

.seedinv-row {
    height: 78px;
    padding: 12px;
    border-width: 1px;
    border-color: rgba(230, 201, 111, 0.35);
    background-color: rgba(230, 201, 111, 0.04);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.seedinv-row:hover {
    background-color: rgba(230, 201, 111, 0.06);
}

.seedinv-iconbox {
    width: 40px;
    height: 40px;
    border-width: 1px;
    border-color: rgba(230, 201, 111, 0.25);
    background-color: rgba(0, 0, 0, 0.15);
    align-items: center;
    justify-content: center;
}

.seedinv-iconbox-text {
    font-size: 16px;
    color: rgba(230, 201, 111, 0.9);
}

.seedinv-row-main {
    flex-direction: column;
    flex-grow: 1;
    margin-left: 12px;
}

.seedinv-seedname {
    font-size: 14px;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.92);
    -unity-font-style: bold;
}

.seedinv-badges {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
}

.seedinv-badge {
    padding: 2px 8px;
    border-width: 1px;
    background-color: rgba(255, 255, 255, 0.03);
}

.seedinv-badge-text {
    font-size: 10px;
    letter-spacing: 1px;
}

.seedinv-badge-pure {
    border-color: rgba(127, 255, 122, 0.55);
}

.seedinv-badge-pure .seedinv-badge-text {
    color: var(--seedinv-green);
}

.seedinv-badge-standard {
    border-color: rgba(230, 201, 111, 0.55);
}

.seedinv-badge-standard .seedinv-badge-text {
    color: rgba(230, 201, 111, 0.95);
}

.seedinv-badge-evil {
    border-color: rgba(211, 95, 95, 0.55);
}

.seedinv-badge-evil .seedinv-badge-text {
    color: rgba(211, 95, 95, 0.95);
}

.seedinv-qty {
    font-size: 11px;
    color: var(--seedinv-muted);
}

.seedinv-select {
    padding: 8px 12px;
    border-width: 1px;
    border-color: rgba(230, 201, 111, 0.35);
    background-color: rgba(0, 0, 0, 0.08);
}

.seedinv-select:hover {
    background-color: rgba(230, 201, 111, 0.06);
}

.seedinv-select-text {
    font-size: 11px;
    letter-spacing: 1px;
    color: rgba(230, 201, 111, 0.95);
}

.seedinv-cancel {
    height: 54px;
    border-width: 1px;
    border-color: rgba(211, 95, 95, 0.45);
    background-color: rgba(211, 95, 95, 0.05);
    justify-content: center;
    align-items: center;
}

.seedinv-cancel:hover {
    background-color: rgba(211, 95, 95, 0.08);
}

.seedinv-cancel-text {
    font-size: 12px;
    letter-spacing: 2px;
    color: rgba(211, 95, 95, 0.85);
}


