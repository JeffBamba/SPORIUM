/*
End of Day Sequence — Stile terminale / holografico
Dipendenze: SP-Foundation.uss, SP-Panel-Base.uss
*/

.eod-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  flex-grow: 1;
}

.eod-overlay {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.75);
  align-items: center;
  justify-content: center;
}

/* Step 1: Conferma modale */
.eod-modal {
  min-width: 360px;
  max-width: 420px;
  background-color: var(--sp-bg-panel-dark);
  border-width: 2px;
  border-color: var(--sp-color-blue-info);
  border-radius: var(--sp-radius-md);
  padding: var(--sp-space-xl);
  flex-direction: column;
  align-items: center;
}

.eod-step1 {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.eod-step2, .eod-step3, .eod-step4, .eod-step5, .eod-step6 {
  display: none;
  flex-direction: column;
  align-items: stretch;
}

/* Pannelli scrollabili (Step 2, 3, 5, 6) */
.eod-panel {
  min-width: 420px;
  max-width: 560px;
  max-height: 85%;
  background-color: var(--sp-bg-panel-dark);
  border-width: 2px;
  border-radius: var(--sp-radius-md);
  padding: var(--sp-space-lg);
}

.eod-panel--green {
  border-color: var(--sp-color-green-led);
}

.eod-panel--cyan {
  border-color: var(--sp-color-blue-info);
}

.eod-scroll {
  flex-grow: 1;
  max-height: 400px;
  margin-bottom: var(--sp-space-md);
  -unity-text-align: upper-left;
}

.eod-panel-title {
  font-size: var(--sp-font-size-20);
  color: var(--sp-color-green-led);
  -unity-font-style: bold;
  letter-spacing: var(--sp-letter-wide);
  margin-bottom: var(--sp-space-md);
}

.eod-step5 .eod-panel-title,
.eod-step6 .eod-panel-title {
  color: var(--sp-color-blue-info);
}

.eod-line {
  font-size: var(--sp-font-size-12);
  color: var(--sp-color-text-muted);
  margin-bottom: var(--sp-space-xs);
  white-space: normal;
}

.eod-block {
  font-size: var(--sp-font-size-12);
  color: var(--sp-color-text);
  margin-top: var(--sp-space-sm);
  margin-bottom: var(--sp-space-sm);
  white-space: normal;
}

.eod-footer {
  font-size: var(--sp-font-size-10);
  color: var(--sp-color-text-muted);
  margin-top: var(--sp-space-lg);
}

.eod-title {
  font-size: var(--sp-font-size-24);
  color: var(--sp-color-blue-info);
  -unity-font-style: bold;
  letter-spacing: var(--sp-letter-wide);
  margin-bottom: var(--sp-space-lg);
}

.eod-desc {
  font-size: var(--sp-font-size-14);
  color: var(--sp-color-text-muted);
  margin-bottom: var(--sp-space-sm);
  white-space: normal;
}

.eod-buttons {
  flex-direction: row;
  margin-top: var(--sp-space-xl);
  align-items: center;
  justify-content: center;
}

.eod-btn {
  min-width: 100px;
  margin-left: var(--sp-space-md);
  margin-right: var(--sp-space-md);
  padding: var(--sp-space-sm) var(--sp-space-lg);
  font-size: var(--sp-font-size-14);
  -unity-font-style: bold;
}

.eod-cta {
  margin-top: var(--sp-space-md);
  margin-left: 0;
  margin-right: 0;
}

.eod-btn--yes {
  background-color: transparent;
  border-width: 2px;
  border-color: var(--sp-color-green-led);
  color: var(--sp-color-green-led);
}

.eod-btn--no {
  background-color: transparent;
  border-width: 2px;
  border-color: var(--sp-line-strong);
  color: var(--sp-color-text-muted);
}

.eod-btn--research {
  background-color: transparent;
  border-width: 2px;
  border-color: var(--sp-color-yellow-standard);
  color: var(--sp-color-yellow-standard);
  margin-bottom: var(--sp-space-sm);
  min-width: 280px;
}

.eod-dawn-events {
  min-height: 120px;
}
