<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="../Foundation/SP-Foundation.uss" />
    <Style src="../Foundation/SP-Panel-Base.uss" />
    <Style src="EndOfDaySequence.uss" />
    <ui:VisualElement name="eod-root" class="eod-root">
        <ui:VisualElement name="eod-overlay" class="eod-overlay">
            <!-- Step 1: Conferma -->
            <ui:VisualElement name="eod-step1" class="eod-modal eod-step1">
                <ui:Label name="eod-title" text="END DAY?" class="eod-title" />
                <ui:Label name="eod-desc1" text="Close systems and enter hibernation mode." class="eod-desc" />
                <ui:Label name="eod-desc2" text="The Vault rests, but life keeps breathing underground." class="eod-desc" />
                <ui:VisualElement name="eod-buttons" class="eod-buttons">
                    <ui:Button name="btn-eod-yes" text="YES" class="eod-btn eod-btn--yes" />
                    <ui:Button name="btn-eod-no" text="NO" class="eod-btn eod-btn--no" />
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- Step 2: Snapshot -->
            <ui:VisualElement name="eod-step2" class="eod-panel eod-step2 eod-panel--green" style="display: none;">
                <ui:ScrollView name="eod-snapshot-scroll" class="eod-scroll">
                    <ui:Label name="eod-snapshot-title" text="SPORAE — Day N" class="eod-panel-title" />
                    <ui:Label name="eod-snapshot-date" text="System Date: —" class="eod-line" />
                    <ui:Label name="eod-snapshot-vault" text="Vault Status: Operational" class="eod-line" />
                    <ui:Label name="eod-snapshot-ph" text="Dome pH: —" class="eod-line" />
                    <ui:Label name="eod-activity-summary" text="Activity Summary: …" class="eod-block" />
                    <ui:Label name="eod-drift" text="Drift &amp; Consequences: —" class="eod-block" />
                    <ui:Label name="eod-notes" text="[NOTES &amp; TAGS] —" class="eod-block" />
                    <ui:Label name="eod-snapshot-footer" text="■ S.P.O.R.A.E FRAGMENT" class="eod-footer" />
                </ui:ScrollView>
                <ui:Button name="btn-eod-snapshot-confirm" text="Confirm → Diario" class="eod-btn eod-btn--yes eod-cta" />
            </ui:VisualElement>
            <!-- Step 3: Diario -->
            <ui:VisualElement name="eod-step3" class="eod-panel eod-step3 eod-panel--green" style="display: none;">
                <ui:ScrollView name="eod-diario-scroll" class="eod-scroll">
                    <ui:Label name="eod-diario-title" text="S.P.O.R.A.E FRAGMENT" class="eod-panel-title" />
                    <ui:Label name="eod-diario-text" text="Recording completed. Memory integrity: 100%." class="eod-block" />
                    <ui:Label name="eod-diario-close" text="Good night, Biologist." class="eod-footer" />
                </ui:ScrollView>
                <ui:Button name="btn-eod-diario-continue" text="Continue → Night Research / Forecast" class="eod-btn eod-btn--yes eod-cta" />
            </ui:VisualElement>
            <!-- Step 4: Night Research -->
            <ui:VisualElement name="eod-step4" class="eod-panel eod-step4" style="display: none;">
                <ui:Label name="eod-research-title" text="NIGHT RESEARCH SELECTION" class="eod-panel-title" />
                <ui:Label name="eod-research-subtitle" text="Select one research branch to investigate overnight." class="eod-desc" />
                <ui:Button name="btn-eod-research-historical" text="Historical Archive — Unlocks lore entries" class="eod-btn eod-btn--research" />
                <ui:Button name="btn-eod-research-botanical" text="Botanical Database — Unlocks plant info" class="eod-btn eod-btn--research" />
                <ui:Button name="btn-eod-research-vault" text="Vault Protocols — Unlocks secret logs" class="eod-btn eod-btn--research" />
                <ui:Button name="btn-eod-research-skip" text="Skip Research" class="eod-btn eod-btn--no" />
            </ui:VisualElement>
            <!-- Step 5: Forecast -->
            <ui:VisualElement name="eod-step5" class="eod-panel eod-step5 eod-panel--cyan" style="display: none;">
                <ui:ScrollView name="eod-forecast-scroll" class="eod-scroll">
                    <ui:Label name="eod-forecast-title" text="NIGHT SUMMARY - FORECAST SYSTEM" class="eod-panel-title" />
                    <ui:Label name="eod-forecast-today" text="[TODAY] …" class="eod-block" />
                    <ui:Label name="eod-forecast-tomorrow" text="[TOMORROW FORECAST] …" class="eod-block" />
                    <ui:Label name="eod-forecast-research" text="" class="eod-block" />
                    <ui:Label name="eod-forecast-footer" text="Close the day and let the Vault dream." class="eod-footer" />
                </ui:ScrollView>
                <ui:Button name="btn-eod-sleep" text="Sleep → Next Day" class="eod-btn eod-btn--yes eod-cta" />
            </ui:VisualElement>
            <!-- Step 6: Hibernation (full screen) -->
            <ui:VisualElement name="eod-step6" class="eod-fullscreen eod-step6" style="display: none;">
                <ui:Label name="eod-hibernation-line1" text="SYSTEMS IN HIBERNATION MODE..." class="eod-hibernation-main" />
                <ui:Label name="eod-hibernation-line2" text="darkness feeds" class="eod-hibernation-sub" />
            </ui:VisualElement>
            <!-- Step 7: Day transition (full screen) -->
            <ui:VisualElement name="eod-step7" class="eod-fullscreen eod-step7" style="display: none;">
                <ui:Label name="eod-day-from" text="DAY 01" class="eod-day-from" />
                <ui:Label name="eod-day-to" text="→ DAY 02" class="eod-day-to" />
            </ui:VisualElement>
            <!-- Step 8: Dawn Summary -->
            <ui:VisualElement name="eod-step8" class="eod-panel eod-step8 eod-panel--cyan" style="display: none;">
                <ui:Label name="eod-dawn-title" text="DAWN SUMMARY" class="eod-panel-title" />
                <ui:Label name="eod-dawn-subtitle" text="DAY N – OVERNIGHT CHANGES" class="eod-desc" />
                <ui:Label name="eod-dawn-intro1" text="The Vault awakens from standby mode. Environmental sensors report overnight variations." class="eod-line" />
                <ui:Label name="eod-dawn-intro2" text="Life has shifted in the darkness. Systems recalibrate." class="eod-line" />
                <ui:VisualElement name="eod-dawn-params-list" class="eod-dawn-params-list">
                    <ui:VisualElement name="eod-dawn-row-mutation" class="eod-dawn-row" data-param="mutation">
                        <ui:Label name="eod-dawn-icon-mutation" text="◊" class="eod-dawn-icon" />
                        <ui:Label name="eod-dawn-text-mutation" text="Indice di Mutazione: —" class="eod-dawn-param-text" />
                        <ui:Label name="eod-dawn-qmark-mutation" text="?" class="eod-dawn-qmark" />
                    </ui:VisualElement>
                    <ui:VisualElement name="eod-dawn-row-ph" class="eod-dawn-row" data-param="ph">
                        <ui:Label name="eod-dawn-icon-ph" text="◊" class="eod-dawn-icon" />
                        <ui:Label name="eod-dawn-text-ph" text="pH Drift: —" class="eod-dawn-param-text" />
                        <ui:Label name="eod-dawn-qmark-ph" text="?" class="eod-dawn-qmark" />
                    </ui:VisualElement>
                    <ui:VisualElement name="eod-dawn-row-condensation" class="eod-dawn-row" data-param="condensation">
                        <ui:Label name="eod-dawn-icon-condensation" text="≈" class="eod-dawn-icon" />
                        <ui:Label name="eod-dawn-text-condensation" text="Condensation: —" class="eod-dawn-param-text" />
                        <ui:Label name="eod-dawn-qmark-condensation" text="?" class="eod-dawn-qmark" />
                    </ui:VisualElement>
                    <ui:VisualElement name="eod-dawn-row-grate" class="eod-dawn-row" data-param="grate">
                        <ui:Label name="eod-dawn-icon-grate" text="❖" class="eod-dawn-icon" />
                        <ui:Label name="eod-dawn-text-grate" text="G-rate: —" class="eod-dawn-param-text" />
                        <ui:Label name="eod-dawn-qmark-grate" text="?" class="eod-dawn-qmark" />
                    </ui:VisualElement>
                    <ui:VisualElement name="eod-dawn-row-cry" class="eod-dawn-row" data-param="cry">
                        <ui:Label name="eod-dawn-icon-cry" text="●" class="eod-dawn-icon" />
                        <ui:Label name="eod-dawn-text-cry" text="CRY Balance (forecast fine giorno): —" class="eod-dawn-param-text" />
                        <ui:Label name="eod-dawn-qmark-cry" text="?" class="eod-dawn-qmark" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="eod-dawn-tooltip" class="eod-dawn-tooltip" style="display: none;">
                    <ui:Label name="eod-dawn-tooltip-title" text="[TITLE]" class="eod-dawn-tooltip-title" />
                    <ui:Label name="eod-dawn-tooltip-desc" text="Description..." class="eod-dawn-tooltip-desc" />
                    <ui:Label name="eod-dawn-tooltip-tip" text="TIP: ..." class="eod-dawn-tooltip-tip" />
                </ui:VisualElement>
                <ui:Label name="eod-dawn-press-key" text="Press any key to continue" class="eod-dawn-press-key" />
                <ui:Button name="btn-eod-dawn-continue" text="Continue" class="eod-btn eod-btn--yes eod-cta" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
