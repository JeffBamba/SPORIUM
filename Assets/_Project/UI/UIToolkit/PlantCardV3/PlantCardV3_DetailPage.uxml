<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/UIToolkit/PlantCardV3/PlantCardV3_Terminal.uss?fileID=7433441132597879392&amp;guid=b37f4bda32a0604459559f294aa66d24&amp;type=3#PlantCardV3_Terminal" />
    <ui:ScrollView name="pcv3-detail-page" class="pcv3d-page">
        <!-- SUMMARY CARD (DOS / 420x280) -->
        <ui:VisualElement name="pcv3d-card" class="pcv3d-card">
            <ui:VisualElement name="pcv3d-header" class="pcv3d-header">
                <ui:VisualElement name="pcv3d-header-left" class="pcv3d-header-left">
                    <ui:Label name="pcv3d-led" text="●" class="pcv3d-led" />
                    <ui:Label name="pcv3d-specimen" text="CAMPIONE ID: POT-001" class="pcv3d-specimen" />
                </ui:VisualElement>
                <ui:Label name="pcv3d-family" text="[PURE-001]" class="pcv3d-family" />
            </ui:VisualElement>

            <ui:VisualElement name="pcv3d-sep-1" class="pcv3d-sep" />

            <ui:VisualElement name="pcv3d-name" class="pcv3d-name">
                <ui:Label name="pcv3d-plant-name" text="ARCTIC MASK" class="pcv3d-plant-name" />
                <ui:Label name="pcv3d-species-level" text="[PURE-001] LEVEL 3" class="pcv3d-species-level" />
                <ui:Label name="pcv3d-one-liner" text="Pianta pure che eleva il pH del ambiente..." class="pcv3d-one-liner" />
            </ui:VisualElement>

            <ui:VisualElement name="pcv3d-sep-2" class="pcv3d-sep" />

            <ui:VisualElement name="pcv3d-status" class="pcv3d-status">
                <ui:VisualElement name="pcv3d-status-row-1" class="pcv3d-status-row">
                    <ui:Label name="pcv3d-condition-line" text="CONDIZIONE.......: SANA" class="pcv3d-line pcv3d-line-left" />
                    <ui:Label name="pcv3d-stage-line" text="STADIO...........: PRONTO RACCOLTO" class="pcv3d-line pcv3d-line-right" />
                </ui:VisualElement>
                <ui:VisualElement name="pcv3d-status-row-2" class="pcv3d-status-row">
                    <ui:Label name="pcv3d-phdrift-line" text="pH DRIFT.........: +2/day" class="pcv3d-line pcv3d-line-left" />
                    <ui:Label name="pcv3d-growth-line" text="CRESCITA.........: +23/giorno" class="pcv3d-line pcv3d-line-right" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="pcv3d-sep-3" class="pcv3d-sep" />

            <ui:VisualElement name="pcv3d-vitals" class="pcv3d-vitals">
                <!-- HYDRATION -->
                <ui:VisualElement name="pcv3d-hydration" class="pcv3d-vital-row">
                    <ui:Label name="pcv3d-hydration-label" text="IDRATAZIONE......:" class="pcv3d-vital-label" />
                    <ui:VisualElement name="pcv3d-hydration-bar" class="pcv3d-bar">
                        <ui:Label name="pcv3d-hydration-bracket-l" text="[" class="pcv3d-bar-bracket" />
                        <ui:Label name="pcv3d-hydration-filled" text="████████████" class="pcv3d-bar-filled pcv3d-bar-filled-blue" />
                        <ui:Label name="pcv3d-hydration-empty" text="░░░░░░░░" class="pcv3d-bar-empty" />
                        <ui:Label name="pcv3d-hydration-bracket-r" text="]" class="pcv3d-bar-bracket" />
                    </ui:VisualElement>
                    <ui:Label name="pcv3d-hydration-value" text="60%" class="pcv3d-vital-value pcv3d-value-blue" />
                </ui:VisualElement>

                <!-- LIGHT STRESS -->
                <ui:VisualElement name="pcv3d-lightstress" class="pcv3d-vital-row">
                    <ui:Label name="pcv3d-lightstress-label" text="STRESS LUMINOSO..:" class="pcv3d-vital-label" />
                    <ui:VisualElement name="pcv3d-lightstress-bar" class="pcv3d-bar">
                        <ui:Label name="pcv3d-lightstress-bracket-l" text="[" class="pcv3d-bar-bracket" />
                        <ui:Label name="pcv3d-lightstress-filled" text="████" class="pcv3d-bar-filled pcv3d-bar-filled-green" />
                        <ui:Label name="pcv3d-lightstress-empty" text="░░░░░░░░░░░░░░░░" class="pcv3d-bar-empty" />
                        <ui:Label name="pcv3d-lightstress-bracket-r" text="]" class="pcv3d-bar-bracket" />
                    </ui:VisualElement>
                    <ui:Label name="pcv3d-lightstress-value" text="20%" class="pcv3d-vital-value pcv3d-value-green" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="pcv3d-sep-4" class="pcv3d-sep" />

            <ui:Button name="pcv3d-close" text="&gt; CHIUDI" class="pcv3d-btn" />
        </ui:VisualElement>

        <!-- RESEARCH NOTES (DOS block) -->
        <ui:VisualElement name="pcv3d-research" class="pcv3d-block pcv3d-block-blue">
            <ui:Label name="pcv3d-research-title" text="== NOTE RICERCA" class="pcv3d-block-title" />
            <ui:ScrollView name="pcv3d-research-scroll" class="pcv3d-block-scroll">
                <ui:Label name="pcv3d-research-text" text="" class="pcv3d-block-text" />
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- POT DIARY (DOS block) -->
        <ui:VisualElement name="pcv3d-diary" class="pcv3d-block pcv3d-block-purple">
            <ui:Label name="pcv3d-diary-title" text="== DIARIO VASO" class="pcv3d-block-title" />
            <ui:VisualElement name="pcv3d-diary-compose" class="pcv3d-diary-compose">
                <ui:TextField name="pcv3d-diary-input" class="pcv3d-diary-input" value="" />
                <ui:Button name="pcv3d-diary-log" text="LOG" class="pcv3d-diary-log" />
            </ui:VisualElement>
            <ui:ScrollView name="pcv3d-diary-scroll" class="pcv3d-block-scroll">
                <ui:VisualElement name="pcv3d-diary-list" class="pcv3d-diary-list" />
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
