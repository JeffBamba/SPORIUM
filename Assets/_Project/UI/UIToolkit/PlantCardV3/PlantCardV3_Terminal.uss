}

.pcv3d-diary-compose {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.pcv3d-diary-input {
    flex-grow: 1;
    min-width: 0;
    height: 28px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(181, 128, 209);
    border-right-color: rgb(181, 128, 209);
    border-top-color: rgb(181, 128, 209);
    border-bottom-color: rgb(181, 128, 209);
    color: rgb(200, 222, 208);
    padding-left: 10px;
    padding-right: 10px;
    font-size: 11px;
}

.pcv3d-diary-log {
    width: 60px;
    height: 28px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(181, 128, 209);
    border-right-color: rgb(181, 128, 209);
    border-top-color: rgb(181, 128, 209);
    border-bottom-color: rgb(181, 128, 209);
    color: rgb(181, 128, 209);
    letter-spacing: 0.9px;
}

.pcv3d-diary-log:hover {
    opacity: 0.85;
}

.pcv3d-diary-list {
    flex-direction: column;
}

.pcv3d-diary-row {
    flex-direction: row;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 1px;
    border-left-color: rgba(181, 128, 209, 0.6);
}

.pcv3d-diary-prefix {
    width: 16px;
    color: rgb(181, 128, 209);
    font-size: 12px;
}

.pcv3d-diary-text {
    flex-grow: 1;
    color: rgb(200, 222, 208);
    font-size: 11px;
    white-space: normal;
    line-height: 1.4;
}

.pcv3-prompt {
    height: 44px;
    min-height: 44px;
    max-height: 44px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(127, 255, 122, 0.5);
    border-right-color: rgba(127, 255, 122, 0.5);
    border-top-color: rgba(127, 255, 122, 0.5);
    border-bottom-color: rgba(127, 255, 122, 0.5);
    background-color: rgba(0, 0, 0, 0.55);
    box-shadow: 0 0 10px rgba(127, 255, 122, 0.3);
}

.pcv3-prompt-prefix {
    width: 16px;
    color: rgb(85, 217, 255);
    font-size: 12px;
    -unity-text-align: middle-left;
}

.pcv3-input {
    flex-grow: 1;
    flex-shrink: 0;
    height: 44px;
    min-height: 44px;
    max-height: 44px;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: rgb(127, 255, 122);
    font-size: 12px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-shadow: 0 0 7px rgba(127, 255, 122, 0.9);
    -unity-text-outline-width: 0.6px;
    -unity-text-outline-color: rgba(127, 255, 122, 0.54);
}

.pcv3-input .unity-text-input {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(127, 255, 122);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 0;
    padding-right: 0;
    white-space: nowrap;
    overflow: hidden;
    -unity-text-align: middle-left;
}

.pcv3-input .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(127, 255, 122);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 0;
    padding-right: 0;
    white-space: nowrap;
    overflow: hidden;
    -unity-text-align: middle-left;
}

.pcv3-input:focus {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

/* Loading indicator (spinner) next to prompt — CRT/Sporium style */
.pcv3-loading-indicator {
    width: 20px;
    height: 44px;
    margin-left: 6px;
    align-items: center;
    justify-content: center;
    display: none;
}

.pcv3-loading-indicator.pcv3-loading-visible {
    display: flex;
}

.pcv3-loading-spinner {
    font-size: 14px;
    color: rgb(127, 255, 122);
    text-shadow: 0 0 6px rgba(127, 255, 122, 0.9);
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgba(127, 255, 122, 0.6);
}
