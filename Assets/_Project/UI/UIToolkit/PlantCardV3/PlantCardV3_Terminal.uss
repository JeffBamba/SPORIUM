.pcv3-root {
    width: 1920px;
    height: 1080px;
    flex-grow: 1;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
}

.pcv3-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-and-crop;
    picking-mode: ignore;
}

.pcv3-dim {
    position: absolute;
    /* Lascia Top Bar (80px) e Bottom Bar (132px) scoperti così restano visibili dietro al terminale */
    left: 0;
    right: 0;
    top: 80px;
    bottom: 132px;
    /* Opacità ridotta così la gameview in mezzo resta visibile */
    background-color: rgba(0, 0, 0, 0.55);
    picking-mode: ignore;
}

.pcv3-window {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    width: 1600px;
    height: 790px;
    min-width: 1600px;
    min-height: 790px;
    background-color: rgba(0, 0, 0, 0);
    overflow: visible;
}

.pcv3-frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 1600px;
    height: 790px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    picking-mode: ignore;
}

.pcv3-inner {
    position: absolute;
    left: 70px;
    right: 70px;
    top: 60px;
    bottom: 60px;
    flex-direction: column;
    flex-grow: 0;
    overflow: visible;
}

.pcv3-outer-glow {
    position: absolute;
    left: -16px;
    right: -16px;
    top: -16px;
    bottom: -16px;
    picking-mode: ignore;
}

.pcv3-header {
    height: 56px;
    min-height: 56px;
    max-height: 56px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-left: 18px;
    padding-right: 18px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(127, 255, 122, 0.6);
    background-color: rgba(0, 0, 0, 0.6);
}

.pcv3-title {
    font-size: 12px;
    -unity-font-style: normal;
    color: rgb(127, 255, 122);
    text-shadow: 0 0 7px rgba(127, 255, 122, 0.9);
    -unity-text-outline-width: 0.6px;
    -unity-text-outline-color: rgba(127, 255, 122, 0.54);
}

.pcv3-header-right {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.pcv3-pill {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(127, 255, 122, 0.7);
    border-right-color: rgba(127, 255, 122, 0.7);
    border-top-color: rgba(127, 255, 122, 0.7);
    border-bottom-color: rgba(127, 255, 122, 0.7);
    background-color: rgba(0, 0, 0, 0.35);
}

.pcv3-pill-text {
    font-size: 12px;
    color: rgb(127, 255, 122);
    text-shadow: 0 0 7px rgba(127, 255, 122, 0.9);
    -unity-text-outline-width: 0.6px;
    -unity-text-outline-color: rgba(127, 255, 122, 0.54);
}

.pcv3-close {
    font-size: 12px;
    color: rgb(127, 255, 122);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: auto;
    text-shadow: 0 0 7px rgba(127, 255, 122, 0.9);
    -unity-text-outline-width: 0.6px;
    -unity-text-outline-color: rgba(127, 255, 122, 0.54);
}

.pcv3-body {
    flex-grow: 1;
    flex-direction: row;
}

.pcv3-left {
    width: 455px;
    min-width: 455px;
    border-right-width: 2px;
    border-right-color: rgba(127, 255, 122, 0.5);
    background-color: rgba(0, 0, 0, 0.45);
    padding: 12px;
    overflow: hidden;
}

.pcv3-potlist {
    flex-grow: 1;
    overflow-x: hidden;
    overflow-y: auto;
    min-width: 0;
    position: relative;
}

.pcv3-potlist .unity-scroll-view__vertical-scroller {
    display: none;
}

.pcv3-potcard {
    width: 100%;
    max-width: 420px;
    height: 290px;
    margin-bottom: 10px;
    background-color: rgb(13, 18, 20);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(127, 255, 122);
    border-right-color: rgb(127, 255, 122);
    border-top-color: rgb(127, 255, 122);
    border-bottom-color: rgb(127, 255, 122);
    box-shadow: 0 0 12px rgba(127, 255, 122, 0.4);
    position: relative;
}

.pcv3-potcard-empty {
    border-left-color: rgba(180, 180, 180, 0.65);
    border-right-color: rgba(180, 180, 180, 0.65);
    border-top-color: rgba(180, 180, 180, 0.65);
    border-bottom-color: rgba(180, 180, 180, 0.65);
}

.pcv3-potcard-headerbar {
    height: 22px;
    background-color: rgba(180, 180, 180, 0.35);
    border-bottom-width: 2px;
    border-bottom-color: rgba(180, 180, 180, 0.55);
    padding-left: 10px;
    padding-right: 10px;
    justify-content: center;
}

.pcv3-potcard-headertext {
    font-size: 11px;
    color: rgb(20, 20, 20);
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.pcv3-potcard-body {
    flex-direction: row;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.pcv3-potcard-topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 24px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: rgb(26, 38, 40);
    border-bottom-width: 2px;
    border-bottom-color: rgb(127, 255, 122);
}

.pcv3-potcard-title {
    font-size: 11px;
    color: rgb(127, 255, 122);
    letter-spacing: 0.9px;
    text-shadow: 0 0 4px rgba(127, 255, 122, 0.6);
}

.pcv3-potcard-badge {
    font-size: 11px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    color: rgb(127, 255, 122);
    letter-spacing: 0.9px;
    text-shadow: 0 0 4px rgba(127, 255, 122, 0.6);
}

.pcv3-potcard-live-dot {
    width: 8px;
    height: 8px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: rgb(127, 255, 122);
    box-shadow: 0 0 8px rgb(127, 255, 122), 0 0 12px rgb(127, 255, 122);
    position: absolute;
    left: 8px;
    top: 8px;
}

.pcv3-potcard-content {
    flex-direction: row;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.pcv3-potcard-plantbox {
    width: 130px;
    height: 200px;
    background-color: rgb(0, 0, 0);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.8);
    position: relative;
}

.pcv3-potcard-plant-image {
    width: 110px;
    height: 180px;
    align-self: center;
    margin-top: 10px;
    margin-left: auto;
    margin-right: auto;
}

.pcv3-potcard-lens {
    width: 26px;
    height: 26px;
    margin-top: 74px;
    margin-left: auto;
    margin-right: auto;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(180, 180, 180, 0.35);
    border-right-color: rgba(180, 180, 180, 0.35);
    border-top-color: rgba(180, 180, 180, 0.35);
    border-bottom-color: rgba(180, 180, 180, 0.35);
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
    border-bottom-left-radius: 13px;
    border-bottom-right-radius: 13px;
    opacity: 0.6;
}

.pcv3-potcard-preview {
    width: 130px;
    height: 200px;
    background-color: rgb(0, 0, 0);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(180, 180, 180, 0.55);
    border-right-color: rgba(180, 180, 180, 0.55);
    border-top-color: rgba(180, 180, 180, 0.55);
    border-bottom-color: rgba(180, 180, 180, 0.55);
}

.pcv3-potcard-info {
    width: 242px;
    flex-direction: column;
}

.pcv3-potcard-desc {
    font-size: 10px;
    color: rgb(168, 213, 176);
    -unity-font-style: italic;
    letter-spacing: 0.5px;
    line-height: 1.4;
    white-space: normal;
    margin-bottom: 8px;
}

.pcv3-potcard-stats {
}

.pcv3-potcard-stat-row {
    flex-direction: row;
    margin-top: 6px;
}

.pcv3-potcard-stat-row-first {
    margin-top: 0;
}

.pcv3-potcard-stat-label {
    font-size: 10px;
    color: rgb(192, 200, 197);
    letter-spacing: 0.5px;
    width: 100px;
}

.pcv3-potcard-stat-value {
    font-size: 10px;
    letter-spacing: 0.5px;
    color: rgb(127, 255, 122);
}

.pcv3-potcard-separator {
    height: 1px;
    background-color: rgb(127, 255, 122);
    opacity: 0.3;
    margin-top: 8px;
    margin-bottom: 8px;
}

.pcv3-potcard-standby {
    font-size: 11px;
    color: rgba(180, 180, 180, 0.7);
}

.pcv3-potcard-subtext {
    margin-top: 4px;
    font-size: 10px;
    color: rgba(180, 180, 180, 0.45);
}

.pcv3-potcard-footer {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 242px;
}

.pcv3-potcard-open {
    width: 100%;
    height: 28px;
    background-color: rgba(127, 255, 122, 0.05);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(127, 255, 122);
    border-right-color: rgb(127, 255, 122);
    border-top-color: rgb(127, 255, 122);
    border-bottom-color: rgb(127, 255, 122);
    font-size: 11px;
    color: rgb(127, 255, 122);
    letter-spacing: 1.1px;
    text-shadow: 0 0 4px rgba(127, 255, 122, 0.5);
}

.pcv3-potcard-open:hover {
    background-color: rgba(127, 255, 122, 0.15);
    box-shadow: 0 0 15px rgba(127, 255, 122, 0.5);
}

.pcv3-value-green {
    color: rgb(127, 255, 122);
    text-shadow: 0 0 4px rgba(127, 255, 122, 0.5);
}

.pcv3-value-blue {
    color: rgb(93, 182, 227);
}

.pcv3-value-yellow {
    color: rgb(230, 201, 111);
}

.pcv3-value-red {
    color: rgb(211, 95, 95);
}

.pcv3-right {
    flex-grow: 1;
    padding: 14px;
    height: 740px;
    min-height: 740px;
    max-height: 740px;
    overflow: visible;
}

.pcv3-console-view {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 4px;
    border-bottom-width: 2px;
    border-left-color: rgba(127, 255, 122, 0.5);
    border-right-color: rgba(127, 255, 122, 0.5);
    border-top-color: rgba(127, 255, 122, 0.9);
    border-bottom-color: rgba(127, 255, 122, 0.5);
    background-color: rgba(0, 0, 0, 0.55);
    padding-left: 10px;
    padding-right: 10px;
    box-shadow: 0 0 10px rgba(127, 255, 122, 0.3);
}

.pcv3-protocol-view {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    height: 668px;
    min-height: 668px;
    max-height: 668px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(127, 255, 122, 0.5);
    border-right-color: rgba(127, 255, 122, 0.5);
    border-top-color: rgba(127, 255, 122, 0.5);
    border-bottom-color: rgba(127, 255, 122, 0.5);
    background-color: rgba(0, 0, 0, 0.55);
    padding-left: 10px;
    padding-right: 10px;
    box-shadow: 0 0 10px rgba(127, 255, 122, 0.3);
}

.pcv3-detail-view {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    height: 668px;
    min-height: 668px;
    max-height: 668px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(127, 255, 122, 0.5);
    border-right-color: rgba(127, 255, 122, 0.5);
    border-top-color: rgba(127, 255, 122, 0.5);
    border-bottom-color: rgba(127, 255, 122, 0.5);
    background-color: rgba(0, 0, 0, 0.55);
    padding-left: 10px;
    padding-right: 10px;
    box-shadow: 0 0 10px rgba(127, 255, 122, 0.3);
}

.pcv3-protocol-view {
    display: none;
}

.pcv3-detail-view {
    display: none;
}

.pcv3-console-scroll {
    flex-grow: 1;
    padding: 14px;
    padding-bottom: 26px;
}

.pcv3-protocol-scroll {
    flex-grow: 1;
    padding: 14px;
    padding-bottom: 26px;
}

.pcv3-console-scroll .unity-scroll-view__vertical-scroller {
    width: 8px !important;
    background-color: rgb(26, 35, 37);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(42, 52, 54);
    border-right-color: rgb(42, 52, 54);
    border-top-color: rgb(42, 52, 54);
    border-bottom-color: rgb(42, 52, 54);
    border-top-left-radius: 8px !important;
    border-top-right-radius: 8px !important;
    border-bottom-left-radius: 8px !important;
    border-bottom-right-radius: 8px !important;
}

/* Rimuove la linea gialla: track nascosto (è la barra verticale al centro), slider/drag-container trasparenti */
.pcv3-console-scroll .unity-scroll-view__vertical-scroller .unity-base-slider__track {
    display: none !important;
}
.pcv3-console-scroll .unity-scroll-view__vertical-scroller .unity-scroller__slider,
.pcv3-console-scroll .unity-scroll-view__vertical-scroller .unity-base-slider__drag-container {
    background-color: rgba(0, 0, 0, 0) !important;
    border-width: 0 !important;
}

/* Frecce su/giù: solo freccia verde (tint), NESSUN background; NON toccare background-image altrimenti la freccia scompare */
.pcv3-console-scroll .unity-scroll-view__vertical-scroller .unity-scroller__high-button,
.pcv3-console-scroll .unity-scroll-view__vertical-scroller .unity-scroller__low-button {
    background-color: rgba(0, 0, 0, 0) !important;
    border-width: 0 !important;
    border-radius: 4px;
    -unity-background-image-tint-color: rgb(127, 255, 122);
}

.pcv3-protocol-scroll .unity-scroll-view__vertical-scroller {
    width: 12px;
    background-color: rgb(26, 35, 37);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(42, 52, 54);
    border-right-color: rgb(42, 52, 54);
    border-top-color: rgb(42, 52, 54);
    border-bottom-color: rgb(42, 52, 54);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.pcv3-potlist .unity-scroll-view__vertical-scroller {
    width: 12px;
    background-color: rgb(26, 35, 37);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(42, 52, 54);
    border-right-color: rgb(42, 52, 54);
    border-top-color: rgb(42, 52, 54);
    border-bottom-color: rgb(42, 52, 54);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

/* Scrollbar console (Terminal Pot): verde lime, angoli stondati, nessuna linea interna.
   Usare !important per sovrascrivere il tema predefinito Unity. */
.pcv3-console-scroll .unity-scroll-view__vertical-scroller .unity-scroller__thumb {
    background-color: rgb(127, 255, 122) !important;
    background-image: none !important;
    border-width: 0 !important;
    border-top-left-radius: 8px !important;
    border-top-right-radius: 8px !important;
    border-bottom-left-radius: 8px !important;
    border-bottom-right-radius: 8px !important;
}

/* Alternativa: thumb come dragger */
.pcv3-console-scroll .unity-scroll-view__vertical-scroller .unity-base-slider__dragger {
    background-color: rgb(127, 255, 122) !important;
    background-image: none !important;
    border-width: 0 !important;
    border-top-left-radius: 8px !important;
    border-top-right-radius: 8px !important;
    border-bottom-left-radius: 8px !important;
    border-bottom-right-radius: 8px !important;
}

.pcv3-protocol-scroll .unity-scroll-view__vertical-scroller .unity-scroller__thumb {
    background-color: rgb(127, 255, 122);
    background-image: repeating-linear-gradient(180deg, rgb(127, 255, 122) 0px, rgb(127, 255, 122) 2px, rgb(95, 182, 90) 2px, rgb(95, 182, 90) 4px);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(70, 120, 75);
    border-right-color: rgb(70, 120, 75);
    border-top-color: rgb(70, 120, 75);
    border-bottom-color: rgb(70, 120, 75);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.pcv3-potlist .unity-scroll-view__vertical-scroller .unity-scroller__thumb {
    background-color: rgb(127, 255, 122);
    background-image: repeating-linear-gradient(180deg, rgb(127, 255, 122) 0px, rgb(127, 255, 122) 2px, rgb(95, 182, 90) 2px, rgb(95, 182, 90) 4px);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(70, 120, 75);
    border-right-color: rgb(70, 120, 75);
    border-top-color: rgb(70, 120, 75);
    border-bottom-color: rgb(70, 120, 75);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.pcv3-console-scroll .unity-scroll-view__vertical-scroller .unity-scroller__thumb:hover {
    background-color: rgb(136, 255, 136);
    background-image: repeating-linear-gradient(180deg, rgb(136, 255, 136) 0px, rgb(136, 255, 136) 2px, rgb(111, 198, 106) 2px, rgb(111, 198, 106) 4px);
}

.pcv3-protocol-scroll .unity-scroll-view__vertical-scroller .unity-scroller__thumb:hover {
    background-color: rgb(136, 255, 136);
    background-image: repeating-linear-gradient(180deg, rgb(136, 255, 136) 0px, rgb(136, 255, 136) 2px, rgb(111, 198, 106) 2px, rgb(111, 198, 106) 4px);
}

.pcv3-potlist .unity-scroll-view__vertical-scroller .unity-scroller__thumb:hover {
    background-color: rgb(136, 255, 136);
    background-image: repeating-linear-gradient(180deg, rgb(136, 255, 136) 0px, rgb(136, 255, 136) 2px, rgb(111, 198, 106) 2px, rgb(111, 198, 106) 4px);
}

.pcv3-custom-scrollbar {
    width: 12px;
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 2px;
    z-index: 10;
    pointer-events: auto;
}

.pcv3-custom-scrollbar-track {
    width: 100%;
    flex-grow: 1;
    background-color: rgb(26, 35, 37);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(42, 52, 54);
    border-right-color: rgb(42, 52, 54);
    border-top-color: rgb(42, 52, 54);
    border-bottom-color: rgb(42, 52, 54);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    position: relative;
}

.pcv3-custom-scrollbar-thumb {
    width: 100%;
    min-height: 20px;
    background-image: linear-gradient(rgb(127, 255, 122), rgb(95, 182, 90));
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(26, 35, 37);
    border-right-color: rgb(26, 35, 37);
    border-top-color: rgb(26, 35, 37);
    border-bottom-color: rgb(26, 35, 37);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    box-shadow: 0 0 8px rgba(127, 255, 122, 0.6);
    position: absolute;
    top: 0;
}

